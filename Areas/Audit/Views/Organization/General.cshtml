@model AegisCore.Models.OrganizationViewModel
@{
    ViewData["Title"] = "Общие сведения";
}

<div class="section-header">
    <h2 class="section-title">
        <i class="fas fa-info-circle"></i> Общие сведения об организации
    </h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-info" style="background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; margin-bottom: 20px;">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-error" style="margin-bottom: 20px;">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<form class="org-form" method="post" action="/audit/organization/save-general">
    <!-- Тип организации -->
    <div class="form-row">
        <div class="form-group full-width">
            <label for="orgType">Тип организации <span class="required">*</span></label>
            <select id="orgType" name="orgType" class="form-control" required>
                <option value="">Выберите тип...</option>
                <option value="commercial">Коммерческая организация</option>
                <option value="state">Государственный орган</option>
                <option value="municipal">Муниципальный орган</option>
                <option value="noncommercial">Некоммерческая организация</option>
                <option value="individual">Индивидуальный предприниматель</option>
            </select>
        </div>
    </div>

    <!-- Наименования -->
    <div class="form-row">
        <div class="form-group full-width">
            <label for="fullName">Полное наименование <span class="required">*</span></label>
            <input type="text" id="fullName" name="fullName" class="form-control" placeholder='ООО "Пример"' required>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="shortName">Краткое наименование <span class="required">*</span></label>
            <input type="text" id="shortName" name="shortName" class="form-control" placeholder="Пример" required>
        </div>
    </div>

    <!-- ИНН/КПП/ОГРН -->
    <div class="form-row">
        <div class="form-group">
            <label for="inn">ИНН <span class="required">*</span></label>
            <input type="text" id="inn" name="inn" class="form-control" placeholder="0000000000" maxlength="12" required>
        </div>
        <div class="form-group">
            <label for="kpp">КПП</label>
            <input type="text" id="kpp" name="kpp" class="form-control" placeholder="000000000" maxlength="9">
        </div>
        <div class="form-group">
            <label for="ogrn">ОГРН <span class="required">*</span></label>
            <input type="text" id="ogrn" name="ogrn" class="form-control" placeholder="0000000000000" maxlength="15" required>
        </div>
    </div>

    <!-- Адреса -->
    <div class="form-row">
        <div class="form-group full-width">
            <label for="address">Юридический адрес <span class="required">*</span></label>
            <input type="text" id="address" name="address" class="form-control" placeholder="г. Москва, ул. Примерная, д. 1" required>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="addressIndex">Индекс (юридический)</label>
            <input type="text" id="addressIndex" name="addressIndex" class="form-control" placeholder="000000" maxlength="6">
        </div>
        <div class="form-group full-width">
            <label for="postalAddress">Почтовый адрес <span class="required">*</span></label>
            <input type="text" id="postalAddress" name="postalAddress" class="form-control" placeholder="г. Москва, а/я 123" required>
        </div>
        <div class="form-group">
            <label for="postalIndex">Индекс (почтовый)</label>
            <input type="text" id="postalIndex" name="postalIndex" class="form-control" placeholder="000000" maxlength="6">
        </div>
    </div>

    <!-- Контакты -->
    <div class="form-row">
        <div class="form-group">
            <label for="phone">Телефон <span class="required">*</span></label>
            <input type="tel" id="phone" name="phone" class="form-control" placeholder="+7 (___) ___-__-__" required>
        </div>
        <div class="form-group">
            <label for="email">Email <span class="required">*</span></label>
            <input type="email" id="email" name="email" class="form-control" placeholder="info@example.ru" required>
        </div>
    </div>

    <!-- Руководитель -->
    <div class="form-row">
        <div class="form-group full-width">
            <label for="director">Руководитель организации</label>
            <input type="text" id="director" name="director" class="form-control" placeholder="Иванов Иван Иванович">
        </div>
    </div>

    <!-- Чекбокс СКЗИ -->
    <div class="form-row">
        <div class="form-group checkbox-group">
            <label class="checkbox-label">
                <input type="checkbox" name="isCrypto" value="true">
                <span>Организация имеет лицензии на работу с СКЗИ</span>
            </label>
        </div>
    </div>

    <!-- Кнопки -->
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Сохранить
        </button>
    </div>

    <div class="form-hint">
        <span class="required">*</span> — поля, обязательные для заполнения
    </div>
</form>