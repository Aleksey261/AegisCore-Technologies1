@model AegisCore.Models.OrganizationViewModel
@{
    ViewData["Title"] = "Филиалы";
}

<div class="section-header">
    <h2 class="section-title">
        <i class="fas fa-code-branch"></i> Филиалы
    </h2>
</div>

<div class="toolbar">
    <div class="toolbar-left">
        <button class="btn btn-primary" onclick="openBranchModal()">
            <i class="fas fa-plus"></i> Добавить филиал
        </button>
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="branchSearch" placeholder="Поиск по филиалам..." value="@Model.Search" oninput="filterBranches()" />
        </div>
    </div>
</div>

<div class="table-container">
    <table class="data-table" id="branchesTable">
        <thead>
            <tr>
                <th class="th-sortable">
                    <div class="th-header"><span>Наименование</span><i class="fas fa-sort sortable-icon"></i></div>
                    <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('branchesTable', 0, this.value)" /></div>
                </th>
                <th class="th-sortable">
                    <div class="th-header"><span>Адрес</span><i class="fas fa-sort sortable-icon"></i></div>
                    <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('branchesTable', 1, this.value)" /></div>
                </th>
                <th style="width: 100px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Branches != null && Model.Branches.Any())
            {
                @foreach (var item in Model.Branches)
                {
                    <tr data-id="@item.Id">
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Address</td>
                        <td class="actions">
                            <button class="btn-icon edit" onclick="editBranch('@item.Id')"><i class="fas fa-edit"></i></button>
                            <button class="btn-icon delete" onclick="deleteBranch('@item.Id')"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" style="text-align: center; padding: 40px; color: #94a3b8;">
                        <i class="fas fa-code-branch" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>
                        Филиалы не добавлены
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        <div class="pagination-page-size">
            <label>Показывать по:</label>
            <select onchange="changePageSize(this.value)"><option value="10" selected>10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
        </div>
        <div class="pagination-info">Страница @Model.CurrentPage из @Model.TotalPages (Всего элементов: @Model.TotalItems)</div>
        <div class="pagination-buttons">
            @if (Model.CurrentPage > 1) { <a href="/audit/organization?section=branches&page=@(Model.CurrentPage - 1)" class="btn-pagination">‹</a> }
            @for (int i = 1; i <= Model.TotalPages; i++) { <a href="/audit/organization?section=branches&page=@i" class="btn-pagination @(i == Model.CurrentPage ? "active" : "")">@i</a> }
            @if (Model.CurrentPage < Model.TotalPages) { <a href="/audit/organization?section=branches&page=@(Model.CurrentPage + 1)" class="btn-pagination">›</a> }
        </div>
    </div>
}

<!-- Модалка -->
<div class="modal" id="branchModal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h3 id="branchModalTitle">Добавление филиала</h3>
            <button class="modal-close" onclick="closeBranchModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="branchForm" onsubmit="saveBranch(event)">
                <input type="hidden" id="branchId" name="id" />
                <div class="form-group">
                    <label>Наименование <span class="required">*</span></label>
                    <input type="text" name="name" id="branchName" class="form-control" required placeholder="Введите наименование филиала" />
                </div>
                <div class="form-group">
                    <label>Адрес <span class="required">*</span></label>
                    <input type="text" name="address" id="branchAddress" class="form-control" required placeholder="Введите адрес филиала" />
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeBranchModal()">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const branchesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Branches ?? new List<AegisCore.Models.Branch>()));
    function openBranchModal() { document.getElementById('branchForm').reset(); document.getElementById('branchId').value = ''; document.getElementById('branchModalTitle').textContent = 'Добавление филиала'; document.getElementById('branchModal').classList.add('show'); }
    function closeBranchModal() { document.getElementById('branchModal').classList.remove('show'); }
    function editBranch(id) { const item = branchesData.find(b => b.id === id); if (!item) return; document.getElementById('branchId').value = item.id; document.getElementById('branchName').value = item.name || ''; document.getElementById('branchAddress').value = item.address || ''; document.getElementById('branchModalTitle').textContent = 'Редактирование филиала'; document.getElementById('branchModal').classList.add('show'); }
    function deleteBranch(id) { if (!confirm('Удалить филиал?')) return; fetch('/api/audit/organization/branches/delete/' + id, { method: 'DELETE' }).then(r => r.json()).then(data => { if (data.success) location.reload(); else alert(data.error || 'Ошибка'); }); }
    function saveBranch(e) { e.preventDefault(); const form = e.target; const data = { id: form.id.value || null, name: form.name.value, address: form.address.value }; fetch('/api/audit/organization/branches/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }).then(r => r.json()).then(result => { if (result.success) location.reload(); else alert(result.error || 'Ошибка'); }); }
    function filterBranches() { const search = document.getElementById('branchSearch').value.toLowerCase(); document.querySelectorAll('#branchesTable tbody tr').forEach(row => { row.style.display = row.textContent.toLowerCase().includes(search) ? '' : 'none'; }); }
    function filterTable(tableId, colIndex, value) { const table = document.getElementById(tableId); const rows = table.querySelectorAll('tbody tr'); rows.forEach(row => { const cell = row.cells[colIndex]; if (cell) { row.style.display = cell.textContent.toLowerCase().includes(value.toLowerCase()) ? '' : 'none'; } }); }
    function changePageSize(size) { const url = new URL(window.location); url.searchParams.set('pageSize', size); window.location.href = url.toString(); }
</script>