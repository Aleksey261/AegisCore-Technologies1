@{
    ViewData["Title"] = "ML-анализ соответствия требованиям ИБ";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <h2 class="mb-4">
        <i class="bi bi-cpu text-primary"></i> 
        Автоматизированная оценка защищённости (ML)
    </h2>
    
    <!-- Панель управления мониторингом -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-bold">
            <i class="bi bi-activity text-primary"></i> Непрерывный мониторинг системы
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label fw-bold small">Интервал авто-сканирования:</label>
                    <select id="intervalSelect" class="form-select">
                        <option value="1">Каждую минуту</option>
                        <option value="5">Каждые 5 минут</option>
                        <option value="15">Каждые 15 минут</option>
                        <option value="30">Каждые 30 минут</option>
                        <option value="60" selected>Каждый час</option>
                        <option value="360">Каждые 6 часов</option>
                        <option value="1440">Каждые сутки</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label fw-bold small">&nbsp;</label>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="autoToggle">
                        <label class="form-check-label" for="autoToggle">Авто-мониторинг</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <button id="scanNowBtn" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Сканировать сейчас
                    </button>
                    <button id="applySettingsBtn" class="btn btn-outline-success">
                        <i class="bi bi-gear"></i> Применить настройки
                    </button>
                </div>
            </div>
            <hr class="my-3">
            <div class="row">
                <div class="col-md-4">
                    <small class="text-muted">Последний скан:</small><br>
                    <strong id="lastScanTime">—</strong>
                </div>
                <div class="col-md-4">
                    <small class="text-muted">Результат:</small><br>
                    <strong id="lastScanResult">—</strong>
                </div>
                <div class="col-md-4">
                    <small class="text-muted">Следующий скан:</small><br>
                    <strong id="nextScanTime">—</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- История сканов с выбором лимита -->
    <div id="scansHistoryContainer" class="card shadow-sm mb-4 d-none">
        <div class="card-header bg-info bg-opacity-10 fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clock-history"></i> История автоматических сканов</span>
            <div class="d-flex align-items-center">
                <label for="limitSelect" class="me-2 small fw-bold">Показать:</label>
                <select id="limitSelect" class="form-select form-select-sm" style="width: auto;">
                    <option value="10">10</option>
                    <option value="25" selected>25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <span class="ms-2 small text-muted">записей</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Файл</th>
                            <th>Дата</th>
                            <th>Размер</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="scansTableBody"></tbody>
                </table>
            </div>
            <div id="scansCountInfo" class="text-muted small mt-2"></div>
        </div>
    </div>

    <!-- 1. Панель выбора и управления моделями -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">🛠️ Управление моделями машинного обучения</h5>
            <div class="row align-items-end">
                <div class="col-md-4 mb-3 mb-md-0">
                    <label for="modelSelect" class="form-label fw-bold">Выберите алгоритм ML (согласно Главе 2.2):</label>
                    <select id="modelSelect" class="form-select">
                        <option value="LightGBM">LightGBM (Градиентный бустинг)</option>
                        <option value="RandomForest">Random Forest (Случайный лес)</option>
                        <option value="SVM">SVM (Метод опорных векторов)</option>
                        <option value="FastTree">FastTree (Градиентные деревья)</option>
                        <option value="IsolationForest">Isolation Forest (Поиск аномалий)</option>
                        <option value="Autoencoders">Autoencoders (Обнаружение аномалий)</option>
                        <option value="RnnLstm">RNN/LSTM (Прогнозирование инцидентов)</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <button id="trainSelectedBtn" class="btn btn-primary me-2">
                        <i class="bi bi-lightning-charge"></i> Обучить выбранную модель
                    </button>
                    <button id="trainAllBtn" class="btn btn-success">
                        <i class="bi bi-grid-3x3-gap"></i> Обучить все модели (для сравнения)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Таблица сравнения моделей (скрыта по умолчанию) -->
    <div id="comparisonTableContainer" class="card mb-4 shadow-sm d-none">
        <div class="card-header bg-info bg-opacity-10 fw-bold">
            📊 Сравнительный анализ метрик качества моделей (Глава 4.2)
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Модель</th>
                            <th>Accuracy (Точность)</th>
                            <th>Precision</th>
                            <th>Recall (Полнота)</th>
                            <th>F1-Score</th>
                            <th>AUC-ROC</th>
                        </tr>
                    </thead>
                    <tbody id="comparisonTableBody">
                        <!-- Данные заполняются через JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 3. Метрики активной модели и оценка -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card border-primary shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted">Общий показатель соответствия (Кз)</h5>
                    <div id="complianceScore" class="display-3 fw-bold text-primary">--</div>
                    <p class="text-muted small mt-2">Рассчитано на основе выбранной ML-модели</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Результаты оценки</h5>
                    <div id="modelMetricsSummary" class="mb-3 d-none">
                        <small class="text-muted">Метрики активной модели (<span id="activeModelName">LightGBM</span>):</small>
                        <div class="d-flex justify-content-around mt-2">
                            <span class="badge bg-primary">Acc: <span id="activeAcc">--</span>%</span>
                            <span class="badge bg-success">F1: <span id="activeF1">--</span>%</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">
                        Для корректной работы необходимо предварительно обучить модель.
                    </p>
                    <button id="assessSystemBtn" class="btn btn-success w-100" disabled>
                        <i class="bi bi-clipboard-check"></i> Оценить систему (SYS-001)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Детали оценки по требованиям -->
    <div id="resultsContainer" class="card shadow-sm mb-4 d-none">
        <div class="card-header bg-light fw-bold">
            🔍 Детали оценки по требованиям ФСТЭК (Приказ №21)
        </div>
        <div class="card-body">
            <ul id="metricsList" class="list-group list-group-flush"></ul>
        </div>
    </div>

    <!-- 5. Рекомендации -->
    <div id="recommendationsContainer" class="card shadow-sm d-none">
        <div class="card-header bg-warning bg-opacity-10 fw-bold">
            💡 Рекомендации по повышению защищённости
        </div>
        <div class="card-body" id="recommendationsList"></div>
    </div>
</div>

@section Scripts {
<script>
    // ====== МОНИТОРИНГ ======
    function loadMonitoringStatus() {
        fetch('/api/ml-analysis/monitoring')
            .then(r => r.json())
            .then(data => {
                document.getElementById('autoToggle').checked = data.isEnabled;
                document.getElementById('intervalSelect').value = data.intervalMinutes;
                document.getElementById('lastScanTime').textContent = 
                    data.lastScanTime ? new Date(data.lastScanTime).toLocaleString('ru-RU') : '—';
                document.getElementById('lastScanResult').innerHTML = 
                    data.lastScanResult ? 
                    `<span class="badge ${data.lastScanResult === 'ВЫСОКИЙ' ? 'bg-danger' : 'bg-success'}">${data.lastScanResult}</span>` : '—';
                document.getElementById('nextScanTime').textContent = 
                    data.nextScanTime ? new Date(data.nextScanTime).toLocaleString('ru-RU') : 'Выключено';
                
                if (data.totalScans > 0) {
                    document.getElementById('scansHistoryContainer').classList.remove('d-none');
                    loadScansHistory();
                }
            });
    }

    // ИСПРАВЛЕННАЯ ФУНКЦИЯ ЗАГРУЗКИ ИСТОРИИ С ЛИМИТОМ
    function loadScansHistory() {
        const limit = document.getElementById('limitSelect').value;
        fetch(`/api/ml-analysis/scans?limit=${limit}`)
            .then(r => r.json())
            .then(data => {
                const tbody = document.getElementById('scansTableBody');
                tbody.innerHTML = '';
                
                if (data.files && data.files.length > 0) {
                    data.files.forEach(f => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td><code>${f.fileName}</code></td>
                            <td>${new Date(f.createdAt).toLocaleString('ru-RU')}</td>
                            <td>${(f.size / 1024).toFixed(1)} KB</td>
                            <td><a href="/api/ml-analysis/scans/${f.fileName}" target="_blank" class="btn btn-sm btn-outline-primary">Открыть</a></td>
                        `;
                        tbody.appendChild(tr);
                    });
                    
                    document.getElementById('scansCountInfo').textContent = 
                        `Показано ${data.total} записей (лимит: ${data.limit})`;
                } else {
                    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Нет записей</td></tr>';
                    document.getElementById('scansCountInfo').textContent = '';
                }
            })
            .catch(e => {
                console.error('Ошибка загрузки истории:', e);
            });
    }

    // Обработчик изменения лимита в выпадающем списке
    document.getElementById('limitSelect').addEventListener('change', function() {
        loadScansHistory();
    });

    document.getElementById('scanNowBtn').addEventListener('click', async function() {
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Сканирование...';
        try {
            const r = await fetch('/api/ml-analysis/scan-now', { method: 'POST' });
            const data = await r.json();
            if (data.success) {
                alert(`✅ Сканирование завершено!\nРиск: ${data.lastScanResult}\nФайл: ${data.lastScanFile}`);
                loadMonitoringStatus();
            } else {
                alert('❌ ' + data.error);
            }
        } catch (e) { alert('❌ ' + e.message); }
        finally {
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-search"></i> Сканировать сейчас';
        }
    });

    document.getElementById('applySettingsBtn').addEventListener('click', async function() {
        const enabled = document.getElementById('autoToggle').checked;
        const interval = parseInt(document.getElementById('intervalSelect').value);
        try {
            const r = await fetch('/api/ml-analysis/monitoring', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isAutoMonitoringEnabled: enabled, intervalMinutes: interval })
            });
            const data = await r.json();
            if (data.success) {
                alert(`✅ Настройки применены!\nАвто-мониторинг: ${enabled ? 'ВКЛ' : 'ВЫКЛ'}\nИнтервал: ${interval} мин.`);
                loadMonitoringStatus();
            }
        } catch (e) { alert('❌ ' + e.message); }
    });

    // Загрузка при старте
    loadMonitoringStatus();
    setInterval(loadMonitoringStatus, 60000); // Обновлять статус раз в минуту

    // ====== ML МОДЕЛИ ======
    
    // --- 1. Обучение выбранной модели ---
    document.getElementById('trainSelectedBtn').addEventListener('click', async function() {
        const modelName = document.getElementById('modelSelect').value;
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Обучение...';
        
        try {
            const response = await fetch('/api/ml-analysis/train', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ modelName: modelName })
            });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('modelMetricsSummary').classList.remove('d-none');
                document.getElementById('activeModelName').textContent = data.metrics.modelName;
                document.getElementById('activeAcc').textContent = data.metrics.accuracy;
                document.getElementById('activeF1').textContent = data.metrics.f1Score;
                
                alert(`✅ Модель ${data.metrics.modelName} успешно обучена!\nAccuracy: ${data.metrics.accuracy}%\nF1-Score: ${data.metrics.f1Score}%`);
                document.getElementById('assessSystemBtn').disabled = false;
            } else {
                alert('❌ Ошибка при обучении модели: ' + data.error);
            }
        } catch (error) {
            alert('❌ Ошибка сети: ' + error.message);
        } finally {
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-lightning-charge"></i> Обучить выбранную модель';
        }
    });

    // --- 2. Обучение ВСЕХ моделей (для сравнения в диссертации) ---
    document.getElementById('trainAllBtn').addEventListener('click', async function() {
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Обучение всех моделей...';
        
        try {
            const response = await fetch('/api/ml-analysis/train-all', { method: 'POST' });
            const data = await response.json();
            
            if (data.success) {
                document.getElementById('comparisonTableContainer').classList.remove('d-none');
                const tbody = document.getElementById('comparisonTableBody');
                tbody.innerHTML = '';
                
                const bestModel = data.models.reduce((prev, current) => (prev.accuracy > current.accuracy) ? prev : current);
                
                data.models.forEach(m => {
                    const isBest = m.modelName === bestModel.modelName; 
                    const rowClass = isBest ? 'table-success fw-bold' : '';
                    const star = isBest ? ' ⭐' : '';
                    
                    const row = document.createElement('tr');
                    row.className = rowClass;
                    row.innerHTML = `
                        <td>${m.modelName}${star}</td>
                        <td>${m.accuracy}%</td>
                        <td>${m.precision}%</td>
                        <td>${m.recall}%</td>
                        <td>${m.f1Score}%</td>
                        <td>${m.auc}%</td>
                    `;
                    tbody.appendChild(row);
                });
                
                alert('✅ Все модели успешно обучены! Таблица сравнения обновлена.');
                document.getElementById('assessSystemBtn').disabled = false;
                
                document.getElementById('activeModelName').textContent = data.models[0].modelName;
                document.getElementById('activeAcc').textContent = data.models[0].accuracy;
                document.getElementById('activeF1').textContent = data.models[0].f1Score;
                document.getElementById('modelMetricsSummary').classList.remove('d-none');
            } else {
                alert('❌ Ошибка: ' + data.error);
            }
        } catch (error) {
            alert('❌ Ошибка сети: ' + error.message);
        } finally {
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-grid-3x3-gap"></i> Обучить все модели (для сравнения)';
        }
    });

    // --- 3. Оценка системы ---
    document.getElementById('assessSystemBtn').addEventListener('click', async function() {
        const modelName = document.getElementById('modelSelect').value;
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Оценка...';
        
        try {
            const response = await fetch('/api/ml-analysis/assess/SYS-001', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ modelName: modelName })
            });
            const data = await response.json();
            
            if (data.error) {
                alert('❌ ' + data.error);
                return;
            }
            
            const score = data.overallComplianceScore;
            const scoreElement = document.getElementById('complianceScore');
            scoreElement.textContent = score.toFixed(1) + '%';
            
            if (score >= 85) scoreElement.className = 'display-3 fw-bold text-success';
            else if (score >= 65) scoreElement.className = 'display-3 fw-bold text-warning';
            else scoreElement.className = 'display-3 fw-bold text-danger';
            
            const list = document.getElementById('metricsList');
            list.innerHTML = '';
            
            let compliantCount = 0;
            const recommendations = [];
            
            data.metrics.forEach(m => {
                const statusClass = m.isCompliant ? 'text-success' : 'text-danger';
                const statusIcon = m.isCompliant ? '✅' : '⚠️';
                const badgeClass = m.isCompliant ? 'bg-success' : 'bg-danger';
                const statusText = m.isCompliant ? 'Соответствует' : 'Нарушение';
                
                if (m.isCompliant) compliantCount++;
                
                if (!m.isCompliant) {
                    recommendations.push(`
                        <div class="alert alert-danger d-flex align-items-start" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
                            <div>
                                <strong>${m.requirementId}</strong><br>
                                <small>${m.evidence}</small>
                            </div>
                        </div>
                    `);
                }
                
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';
                li.innerHTML = `
                    <div>
                        <strong>${m.requirementId}</strong><br>
                        <small class="text-muted">${m.evidence}</small>
                    </div>
                    <div class="text-end">
                        <span class="badge ${badgeClass}">${statusIcon} ${statusText}</span><br>
                        <small class="text-muted">Уверенность: ${m.confidenceScore}%</small>
                    </div>
                `;
                list.appendChild(li);
            });
            
            document.getElementById('resultsContainer').classList.remove('d-none');
            
            if (recommendations.length > 0) {
                document.getElementById('recommendationsList').innerHTML = recommendations.join('');
                document.getElementById('recommendationsContainer').classList.remove('d-none');
            } else {
                document.getElementById('recommendationsContainer').classList.add('d-none');
            }
            
            const totalMetrics = data.metrics.length;
            const summary = `
                <div class="alert alert-info mt-3 mb-0">
                    <strong>📊 Итоговая статистика:</strong><br>
                    Соответствует: ${compliantCount} из ${totalMetrics} требований<br>
                    Нарушений: ${totalMetrics - compliantCount}<br>
                    Использованная модель: <strong>${data.modelName}</strong> (Accuracy: ${data.modelMetrics.accuracy}%)
                </div>
            `;
            
            const oldSummary = document.getElementById('resultsContainer').querySelector('.alert-info');
            if (oldSummary) oldSummary.remove();
            document.getElementById('resultsContainer').insertAdjacentHTML('beforeend', summary);
            
        } catch (error) {
            alert('❌ Ошибка при оценке: ' + error.message);
        } finally {
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-clipboard-check"></i> Оценить систему (SYS-001)';
        }
    });
</script>
}