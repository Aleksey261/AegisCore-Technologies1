@{
    ViewData["Title"] = "Трансграничная передача";
}

<div class="audit-page">
    <div class="page-header">
        <h1>
            <a href="/audit/protection" style="color: #64748b; text-decoration: none; margin-right: 12px; font-size: 24px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <i class="fas fa-globe"></i> Трансграничная передача
        </h1>
        <p style="color: #64748b; margin-top: 8px; margin-left: 36px;">
            Передача персональных данных за пределы Российской Федерации
        </p>
    </div>

    <div class="tabs-nav" style="margin-bottom: 24px;">
        <a href="/audit/protection/personal-data" class="tab-nav-item"><i class="fas fa-users"></i> Субъекты ПДн</a>
        <a href="/audit/protection/personal-data/categories" class="tab-nav-item"><i class="fas fa-list"></i> Категории ПДн</a>
        <a href="/audit/protection/personal-data/legal-basis" class="tab-nav-item"><i class="fas fa-file-contract"></i> Правовые основания</a>
        <a href="/audit/protection/personal-data/purposes" class="tab-nav-item"><i class="fas fa-bullseye"></i> Цели обработки</a>
        <a href="/audit/protection/personal-data/conditions" class="tab-nav-item"><i class="fas fa-cog"></i> Условия обработки</a>
        <a href="/audit/protection/personal-data/internal" class="tab-nav-item"><i class="fas fa-building"></i> Обработка внутри организации</a>
        <a href="/audit/protection/personal-data/third-parties" class="tab-nav-item"><i class="fas fa-handshake"></i> Обработка третьими лицами</a>
        <a href="/audit/protection/personal-data/non-automated" class="tab-nav-item"><i class="fas fa-file-alt"></i> Неавтоматизированная обработка</a>
        <a href="/audit/protection/personal-data/automated" class="tab-nav-item"><i class="fas fa-database"></i> Обработка ПДн в ИС</a>
        <a href="/audit/protection/personal-data/transboundary" class="tab-nav-item active"><i class="fas fa-globe"></i> Трансграничная передача</a>
    </div>

    <div class="toolbar">
        <div class="toolbar-left">
            <button class="btn btn-primary" onclick="openAddModal()"><i class="fas fa-plus"></i> Добавить</button>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" onclick="toggleDropdown('exportDropdown'); event.stopPropagation();"><i class="fas fa-download"></i> Экспорт в файл</button>
                <div class="dropdown-menu" id="exportDropdown">
                    <a onclick="exportTable('xlsx')"><i class="fas fa-file-excel"></i> Экспорт в XLSX</a>
                    <a onclick="exportTable('pdf')"><i class="fas fa-file-pdf"></i> Экспорт в PDF</a>
                </div>
            </div>
            <button class="btn btn-secondary" onclick="toggleTableSettings()"><i class="fas fa-cog"></i> Настройка таблицы</button>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Поиск..." oninput="filterTable()" />
            </div>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table" id="dataTable">
            <thead>
                <tr>
                    <th class="th-sortable" onclick="sortTable(0)">
                        <div class="th-header"><span>Информационная система</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTableColumn(0, this.value)" /></div>
                    </th>
                    <th class="th-sortable" onclick="sortTable(1)">
                        <div class="th-header"><span>Категория ПДн</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTableColumn(1, this.value)" /></div>
                    </th>
                    <th class="th-sortable" onclick="sortTable(2)">
                        <div class="th-header"><span>Страна</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTableColumn(2, this.value)" /></div>
                    </th>
                    <th style="width: 120px;">Действия</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="4" style="text-align: center; padding: 40px; color: #94a3b8;"><i class="fas fa-info-circle" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>Записи не добавлены. Нажмите "Добавить" для создания первой записи.</td></tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Модальное окно добавления -->
<div class="modal" id="addModal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header"><h3><i class="fas fa-plus"></i> Добавление записи</h3><button class="modal-close" onclick="closeModal('addModal')">&times;</button></div>
        <div class="modal-body">
            <div class="form-group">
                <label>Наименование ИС <span class="required">*</span></label>
                <div class="input-with-buttons">
                    <select id="modalIS" class="form-control" required>
                        <option value="">Выбрать...</option>
#pragma warning disable CS8602
                        @{ var infoSystems = Model?.AvailableInfoSystems; }
                        @if (infoSystems != null && infoSystems.Any())
                        {
                            foreach (var item in infoSystems)
                            {
                                var name = item?.Name ?? string.Empty;
                                <option value="@name">@name</option>
                            }
                        }
                        else
                        {
                            <option value="" disabled>Сначала добавьте ИС в справочник</option>
                        }
#pragma warning restore CS8602
                    </select>
                    <button type="button" class="btn-icon-ref" onclick="openISDictionary()" title="Добавить"><i class="fas fa-plus"></i></button>
                    <button type="button" class="btn-icon-ref" onclick="editISDictionary()" title="Редактировать"><i class="fas fa-edit"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label>Страна <span class="required">*</span></label>
                <div class="input-with-buttons">
                    <select id="modalCountry" class="form-control" required>
                        <option value="">Выбрать...</option>
                        <option value="Республика Беларусь">Республика Беларусь</option>
                        <option value="Казахстан">Казахстан</option>
                        <option value="Китай">Китай</option>
                        <option value="Иные страны">Иные страны</option>
                    </select>
                    <button type="button" class="btn-icon-ref" title="Добавить"><i class="fas fa-plus"></i></button>
                    <button type="button" class="btn-icon-ref" title="Редактировать"><i class="fas fa-edit"></i></button>
                </div>
            </div>
            <div class="form-group">
                <label>Категория ПДн <span class="required">*</span></label>
                <select id="modalCategory" class="form-control" required>
                    <option value="">Выбрать...</option>
#pragma warning disable CS8602
                    @{ var categoriesWithIS = Model?.ConditionsWithIS?.Categories; }
                    @if (categoriesWithIS != null && categoriesWithIS.Any())
                    {
                        foreach (var item in categoriesWithIS)
                        {
                            var name = item?.Name ?? string.Empty;
                            <option value="@name">@name</option>
                        }
                    }
                    else
                    {
                        <option value="" disabled>Сначала укажите категории с признаком "С использованием ИС" в условиях обработки</option>
                    }
#pragma warning restore CS8602
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeModal('addModal')">Отмена</button>
            <button type="button" class="btn btn-primary" onclick="saveData()"><i class="fas fa-save"></i> Сохранить</button>
        </div>
    </div>
</div>

<!-- Модальное окно настройки таблицы -->
<div class="modal" id="settingsModal">
    <div class="modal-content" style="max-width: 500px;">
        <div class="modal-header"><h3><i class="fas fa-cog"></i> Настройка таблицы</h3><button class="modal-close" onclick="closeModal('settingsModal')">&times;</button></div>
        <div class="modal-body">
            <div class="form-group">
                <label>Отображаемые столбцы:</label>
                <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
                    <label class="checkbox-label"><input type="checkbox" data-column="0" checked onchange="toggleColumn(0, this.checked)" /><span>Информационная система</span></label>
                    <label class="checkbox-label"><input type="checkbox" data-column="1" checked onchange="toggleColumn(1, this.checked)" /><span>Категория ПДн</span></label>
                    <label class="checkbox-label"><input type="checkbox" data-column="2" checked onchange="toggleColumn(2, this.checked)" /><span>Страна</span></label>
                    <label class="checkbox-label"><input type="checkbox" data-column="3" checked onchange="toggleColumn(3, this.checked)" /><span>Действия</span></label>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="resetTableSettings()"><i class="fas fa-undo"></i> Сбросить настройки</button>
            <button type="button" class="btn btn-primary" onclick="closeModal('settingsModal')"><i class="fas fa-check"></i> Применить</button>
        </div>
    </div>
</div>

<script>
    let tableData = [];
    let sortDirection = 0;
    let columnVisibility = [true, true, true, true];

    function openAddModal() {
        document.getElementById('modalIS').value = '';
        document.getElementById('modalCountry').value = '';
        document.getElementById('modalCategory').value = '';
        document.getElementById('addModal').classList.add('show');
    }
    function closeModal(modalId) { document.getElementById(modalId).classList.remove('show'); }

    // ✅ Функции для работы со справочниками
    function openISDictionary() { window.location.href = '/audit/protection/personal-data/automated'; }
    function editISDictionary() { window.location.href = '/audit/protection/personal-data/automated'; }

    function saveData() {
        const isName = document.getElementById('modalIS').value;
        const country = document.getElementById('modalCountry').value;
        const category = document.getElementById('modalCategory').value;

        if (!isName || !country || !category) { alert('Пожалуйста, заполните все обязательные поля'); return; }

        tableData.push({ id: Date.now(), isName, country, category });
        renderTable();
        closeModal('addModal');
    }

    function filterTable() { renderTable(document.getElementById('searchInput').value.toLowerCase()); }

    function sortTable(columnIndex) {
        sortDirection = columnIndex === sortDirection ? -sortDirection : 1;
        sortDirection = sortDirection || 1;
        const keys = ['isName', 'category', 'country'];
        const key = keys[columnIndex];
        tableData.sort((a, b) => {
            const aVal = a[key].toString().toLowerCase();
            const bVal = b[key].toString().toLowerCase();
            return aVal < bVal ? -1 * sortDirection : (aVal > bVal ? 1 * sortDirection : 0);
        });
        renderTable();
    }

    function renderTable(searchTerm = '') {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        const filteredData = tableData.filter(row => {
            if (!searchTerm) return true;
            return row.isName.toLowerCase().includes(searchTerm) || row.category.toLowerCase().includes(searchTerm) ||
                   row.country.toLowerCase().includes(searchTerm);
        });

        if (filteredData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; padding: 40px; color: #94a3b8;"><i class="fas fa-info-circle" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>${searchTerm ? 'Ничего не найдено' : 'Записи не добавлены. Нажмите "Добавить" для создания первой записи.'}</td></tr>`;
            return;
        }

        filteredData.forEach(row => {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td><strong>${row.isName}</strong></td><td><span class="badge warning">${row.category}</span></td><td>${row.country}</td>
                <td class="actions"><button class="btn-icon edit" onclick="editItem(${row.id})" title="Редактировать"><i class="fas fa-edit"></i></button>
                <button class="btn-icon delete" onclick="deleteItem(${row.id})" title="Удалить"><i class="fas fa-trash"></i></button></td>`;
            tbody.appendChild(tr);
        });
        
        applyColumnVisibility();
    }

    function editItem(id) {
        const item = tableData.find(r => r.id === id);
        if (!item) return;
        document.getElementById('modalIS').value = item.isName;
        document.getElementById('modalCountry').value = item.country;
        document.getElementById('modalCategory').value = item.category;
        document.getElementById('addModal').classList.add('show');
    }

    function deleteItem(id) {
        if (!confirm('Вы уверены, что хотите удалить эту запись?')) return;
        tableData = tableData.filter(r => r.id !== id);
        renderTable();
    }

    function exportTable(format) { closeAllDropdowns(); alert(`Экспорт в формате ${format.toUpperCase()} будет реализован`); }
    function toggleTableSettings() { document.getElementById('settingsModal').classList.add('show'); }

    function toggleColumn(columnIndex, visible) {
        columnVisibility[columnIndex] = visible;
        const table = document.getElementById('dataTable');
        const th = table.querySelectorAll('thead th')[columnIndex];
        if (th) th.style.display = visible ? '' : 'none';
        const rows = table.querySelectorAll('tbody tr');
        rows.forEach(row => {
            const td = row.querySelectorAll('td')[columnIndex];
            if (td) td.style.display = visible ? '' : 'none';
        });
    }

    function applyColumnVisibility() {
        const table = document.getElementById('dataTable');
        const ths = table.querySelectorAll('thead th');
        const rows = table.querySelectorAll('tbody tr');
        ths.forEach((th, index) => {
            if (columnVisibility[index] !== undefined) th.style.display = columnVisibility[index] ? '' : 'none';
        });
        rows.forEach(row => {
            const tds = row.querySelectorAll('td');
            tds.forEach((td, index) => {
                if (columnVisibility[index] !== undefined) td.style.display = columnVisibility[index] ? '' : 'none';
            });
        });
    }

    function resetTableSettings() {
        if (!confirm('Сбросить все настройки таблицы к значениям по умолчанию?')) return;
        columnVisibility = [true, true, true, true];
        document.querySelectorAll('#settingsModal input[type="checkbox"]').forEach(cb => { cb.checked = true; });
        applyColumnVisibility();
        alert('Настройки таблицы сброшены');
    }

    function toggleDropdown(dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        const isOpen = dropdown.classList.contains('show');
        closeAllDropdowns();
        if (!isOpen) dropdown.classList.add('show');
    }
    function closeAllDropdowns() { document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.remove('show')); }
    document.addEventListener('click', function(e) { if (!e.target.closest('.dropdown')) closeAllDropdowns(); });
    window.onclick = function(event) { if (event.target.classList.contains('modal')) event.target.classList.remove('show'); }

    function filterTableColumn(columnIndex, value) {
        const tbody = document.getElementById('tableBody');
        const rows = tbody.querySelectorAll('tr');
        const searchTerm = value.toLowerCase();
        rows.forEach(row => {
            const cell = row.cells[columnIndex];
            if (cell) {
                const cellText = cell.textContent.toLowerCase();
                row.style.display = cellText.includes(searchTerm) ? '' : 'none';
            }
        });
    }
</script>

<style>
    .th-sortable { cursor: pointer; user-select: none; }
    .th-sortable:hover { background: #f1f5f9; }
    .th-header { display: flex; align-items: center; gap: 6px; }
    .sortable-icon { color: #94a3b8; font-size: 12px; }
    .actions { display: flex; gap: 4px; justify-content: flex-end; }
    
    .th-filter-row { margin-top: 4px; }
    .filter-inline-input {
        width: 100%; padding: 6px 10px; border: 1px solid #e2e8f0; border-radius: 6px;
        font-size: 12px; background: white; font-family: inherit;
    }
    .filter-inline-input:focus { outline: none; border-color: #4F46E5; box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.1); }

    .dropdown { position: relative; display: inline-block; }
    .dropdown-toggle { cursor: pointer; }
    .dropdown-menu {
        display: none; position: absolute; top: 100%; left: 0; min-width: 180px;
        background: white; border: 1px solid #e2e8f0; border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); z-index: 1000; margin-top: 4px;
    }
    .dropdown-menu.show { display: block; }
    .dropdown-menu a {
        display: flex; align-items: center; gap: 8px; padding: 10px 16px;
        color: #1e293b; text-decoration: none; font-size: 14px; cursor: pointer; transition: background 0.2s;
    }
    .dropdown-menu a:hover { background: #f1f5f9; }
    .dropdown-menu a:first-child { border-radius: 8px 8px 0 0; }
    .dropdown-menu a:last-child { border-radius: 0 0 8px 8px; }
    .dropdown-menu a i { width: 16px; text-align: center; }
    
    .input-with-buttons { display: flex; gap: 8px; align-items: center; }
    .input-with-buttons .form-control { flex: 1; }
    .btn-icon-ref {
        background: none; border: 1px solid #e2e8f0; border-radius: 6px;
        padding: 8px 12px; cursor: pointer; color: #64748b;
    }
    .btn-icon-ref:hover { background: #f8fafc; color: #4F46E5; }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 14px;
        color: #475569;
    }
    .checkbox-label input[type="checkbox"] {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }
    
    .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
    }
    .badge.warning { background: #fef3c7; color: #92400e; }
</style>