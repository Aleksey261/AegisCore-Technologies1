<script>
    // ============================================================
    // ДАННЫЕ (хранятся в памяти)
    // ============================================================
    let roomAccessData = [];
    let editingId = null;
    let allEmployees = [];
    
    // ============================================================
    // ВЫПАДАЮЩИЕ МЕНЮ
    // ============================================================
    function toggleDropdown(id) {
        const menu = document.getElementById(id);
        document.querySelectorAll('.dropdown-menu').forEach(m => { if (m.id !== id) m.classList.remove('show'); });
        menu.classList.toggle('show');
        event.stopPropagation();
    }
    
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
            document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
        }
    });
    
    // ============================================================
    // НАСТРОЙКА ТАБЛИЦ
    // ============================================================
    function toggleColumn(className) {
        const cells = document.querySelectorAll('.' + className);
        cells.forEach(cell => {
            const isHidden = cell.style.display === 'none';
            cell.style.display = isHidden ? '' : 'none';
        });
    }
    
    function resetRoomTableSettings() {
        const defaultVisible = ['col-room', 'col-room-pos', 'col-room-emp'];
        document.querySelectorAll('.col-room, .col-room-pos, .col-room-emp').forEach(cell => cell.style.display = '');
        const menu = document.getElementById('settingsRoomDropdown');
        if (menu) {
            menu.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = true);
        }
    }
    
    // ============================================================
    // ФИЛЬТРАЦИЯ ТАБЛИЦ
    // ============================================================
    function filterTable(tableId, searchIdOrCol, value) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = tbody.querySelectorAll('tr');
        if (typeof searchIdOrCol === 'string' && searchIdOrCol === 'roomAccessSearch') {
            const searchTerm = document.getElementById(searchIdOrCol)?.value?.toLowerCase() || '';
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
            return;
        }
        const colIndex = typeof searchIdOrCol === 'number' ? searchIdOrCol : parseInt(searchIdOrCol);
        const searchVal = (value || '').toLowerCase();
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                const cellText = cell.textContent.toLowerCase();
                row.style.display = cellText.includes(searchVal) ? '' : 'none';
            }
        });
    }
    
    // ============================================================
    // ЭКСПОРТ
    // ============================================================
    function exportTable(tableId, format) {
        closeAllDropdowns();
        alert(`Экспорт в формате ${format.toUpperCase()} будет реализован`);
    }
    
    function closeAllDropdowns() {
        document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.remove('show'));
    }
    
    // ============================================================
    // РАБОТА С СОТРУДНИКАМИ
    // ============================================================
    function populateEmployeeSelect(selectId) {
        const select = document.getElementById(selectId);
        if (!select) return;
        select.innerHTML = '<option value="">Выбрать...</option>';
        allEmployees.forEach(emp => {
            select.innerHTML += `<option value="${emp.id}">${emp.fio}</option>`;
        });
        if (allEmployees.length === 0) {
            select.innerHTML = '<option value="">Нет сотрудников</option>';
        }
    }
    
    function populateRoomSelect(selectId) {
        const select = document.getElementById(selectId);
        if (!select) return;
        select.innerHTML = '<option value="">Выбрать...</option>';
        const rooms = ['Кабинет 101', 'Серверная комната', 'Архив', 'Переговорная', 'Кабинет 205'];
        rooms.forEach(room => {
            select.innerHTML += `<option value="${room}">${room}</option>`;
        });
    }
    
    function openEmployeeListForRoom() { 
        window.location.href = '/audit/organization?section=employees'; 
    }
    
    function addEmployeeForRoom() { 
        window.location.href = '/audit/organization?section=employees'; 
    }
    
    function editEmployeeForRoom() {
        const select = document.getElementById('roomAccessEmployee');
        const selectedValue = select.value;
        if (!selectedValue) {
            alert('Сначала выберите сотрудника для редактирования');
            return;
        }
        window.location.href = '/audit/organization?section=employees';
    }
    
    function openRoomList() {
        alert('Здесь будет открыт список помещений');
    }
    
    function editRoom() {
        const select = document.getElementById('roomAccessRoom');
        const selectedValue = select.value;
        if (!selectedValue) {
            alert('Сначала выберите помещение для редактирования');
            return;
        }
        const newName = prompt('Введите новое название помещения:', selectedValue);
        if (newName && newName.trim() && newName.trim() !== selectedValue) {
            const option = select.querySelector('option[value="' + selectedValue + '"]');
            if (option) {
                option.value = newName.trim();
                option.textContent = newName.trim();
            }
        }
    }
    
    function addRoom() {
        const newRoom = prompt('Введите название нового помещения:');
        if (newRoom && newRoom.trim()) {
            const select = document.getElementById('roomAccessRoom');
            const option = document.createElement('option');
            option.value = newRoom.trim();
            option.textContent = newRoom.trim();
            option.selected = true;
            select.appendChild(option);
        }
    }
    
    // ============================================================
    // ПРОВЕРКА ДОСТУПА СОТРУДНИКА
    // ============================================================
    function checkEmployeeAccess(employeeId) {
        const employee = allEmployees.find(emp => emp.id == employeeId);
        if (!employee) return false;
        return employee.hasAccess !== false;
    }
    
    // ============================================================
    // ВКЛАДКА 3: ДОСТУП В ПОМЕЩЕНИЯ (Рисунок 172)
    // ============================================================
    function openRoomAccessModal(id = null) {
        const modal = document.getElementById('roomAccessModal');
        const title = document.getElementById('roomAccessModalTitle');
        if (id) {
            editingId = id;
            title.textContent = 'Редактирование';
            const data = roomAccessData.find(item => item.id === id);
            if (data) {
                document.getElementById('roomAccessId').value = data.id;
                document.getElementById('roomAccessRoom').value = data.roomId || '';
                document.getElementById('roomAccessEmployee').value = data.employeeId || '';
                document.getElementById('roomAccessStartDate').value = data.startDate || '';
                document.getElementById('roomAccessEndDate').value = data.endDate || '';
            }
        } else {
            editingId = null;
            title.textContent = 'Добавление';
            document.getElementById('roomAccessId').value = '';
            document.getElementById('roomAccessRoom').value = '';
            document.getElementById('roomAccessEmployee').value = '';
            document.getElementById('roomAccessStartDate').value = '';
            document.getElementById('roomAccessEndDate').value = '';
        }
        populateEmployeeSelect('roomAccessEmployee');
        populateRoomSelect('roomAccessRoom');
        modal.classList.add('show');
    }
    
    function closeRoomAccessModal() {
        document.getElementById('roomAccessModal').classList.remove('show');
        editingId = null;
    }
    
    function saveRoomAccess(e) {
        e.preventDefault();
        const roomId = document.getElementById('roomAccessRoom').value;
        const employeeId = document.getElementById('roomAccessEmployee').value;
        const startDate = document.getElementById('roomAccessStartDate').value;
        const endDate = document.getElementById('roomAccessEndDate').value;
        
        if (!roomId || !employeeId) {
            alert('Пожалуйста, заполните все обязательные поля');
            return;
        }
        
        if (!checkEmployeeAccess(employeeId)) {
            document.getElementById('errorMessage').textContent = 'У данного сотрудника отсутствует доступ к работе с конфиденциальной информацией';
            document.getElementById('errorModal').classList.add('show');
            return;
        }
        
        const employee = allEmployees.find(emp => emp.id == employeeId);
        const employeeText = employee ? employee.fio : document.getElementById('roomAccessEmployee').options[document.getElementById('roomAccessEmployee').selectedIndex]?.text || 'Сотрудник';
        const position = employee ? employee.position : document.getElementById('roomAccessEmployee').options[document.getElementById('roomAccessEmployee').selectedIndex]?.text || '';
        const roomText = document.getElementById('roomAccessRoom').options[document.getElementById('roomAccessRoom').selectedIndex]?.text || 'Помещение';
        
        const id = document.getElementById('roomAccessId').value;
        const newData = {
            id: id ? parseInt(id) : Date.now(),
            roomId: roomId,
            roomText: roomText,
            employeeId: parseInt(employeeId),
            employeeText: employeeText,
            position: position,
            startDate: startDate || '',
            endDate: endDate || ''
        };
        
        if (id) {
            const index = roomAccessData.findIndex(item => item.id == id);
            if (index !== -1) roomAccessData[index] = newData;
        } else {
            roomAccessData.push(newData);
        }
        renderRoomAccessTable();
        closeRoomAccessModal();
    }
    
    function deleteRoomAccess(id) {
        if (confirm('Вы уверены, что хотите удалить эту запись?')) {
            roomAccessData = roomAccessData.filter(item => item.id !== id);
            renderRoomAccessTable();
        }
    }
    
    function renderRoomAccessTable() {
        const tbody = document.getElementById('roomAccessTableBody');
        tbody.innerHTML = '';
        if (roomAccessData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 60px 40px; color: #94a3b8;">Записи не добавлены</td></tr>';
            return;
        }
        roomAccessData.forEach(item => {
            const tr = document.createElement('tr');
            tr.innerHTML = `<td class="col-room">${item.roomText}</td>
                            <td class="col-room-pos">${item.position || '-'}</td>
                            <td class="col-room-emp">${item.employeeText}</td>
                            <td class="actions">
                                <button class="btn-icon edit" onclick="openRoomAccessModal(${item.id})"><i class="fas fa-edit"></i></button>
                                <button class="btn-icon delete" onclick="deleteRoomAccess(${item.id})"><i class="fas fa-trash"></i></button>
                            </td>`;
            tbody.appendChild(tr);
        });
    }
    
    // ============================================================
    // МОДАЛЬНОЕ ОКНО ОШИБКИ
    // ============================================================
    function closeErrorModal() {
        document.getElementById('errorModal').classList.remove('show');
    }
    
    // ============================================================
    // ЗАКРЫТИЕ МОДАЛЬНЫХ ОКОН ПРИ КЛИКЕ ВНЕ
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        allEmployees = [
            @foreach (var emp in employeesList) {
                <text>{ id: @emp.Id, fio: "@emp.Fio", position: "@emp.Position", department: "@emp.Department", hasAccess: @(emp.HasAccess != null ? emp.HasAccess.ToString().ToLower() : "true") },</text>
            }
        ];
        
        if (allEmployees.length === 0) {
            allEmployees = [
                { id: 1, fio: "Иванов Иван Иванович", position: "Начальник отдела", department: "Отдел безопасности", hasAccess: true },
                { id: 2, fio: "Петров Петр Петрович", position: "Ведущий специалист", department: "IT-отдел", hasAccess: false },
                { id: 3, fio: "Сидорова Анна Сергеевна", position: "Специалист", department: "Кадровый отдел", hasAccess: true }
            ];
        }
        
        // Загружаем данные из localStorage
        try {
            const saved = localStorage.getItem('roomAccessData');
            if (saved) {
                roomAccessData = JSON.parse(saved);
            }
        } catch(e) {}
        
        renderRoomAccessTable();
        
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('show');
                }
            });
        });
    });
</script>