@{
    ViewData["Title"] = "Доступ в помещения";
    
    // Получаем список сотрудников из ViewBag (передается из контроллера)
    var employeesList = ViewBag.Employees as IEnumerable<dynamic> ?? new List<dynamic>();
    // Для демонстрации добавляем заглушку, если список пуст
    if (!employeesList.Any())
    {
        employeesList = new List<dynamic>
        {
            new { Id = 1, Fio = "Иванов Иван Иванович", Position = "Начальник отдела", Department = "Отдел безопасности", HasAccess = true },
            new { Id = 2, Fio = "Петров Петр Петрович", Position = "Ведущий специалист", Department = "IT-отдел", HasAccess = false },
            new { Id = 3, Fio = "Сидорова Анна Сергеевна", Position = "Специалист", Department = "Кадровый отдел", HasAccess = true }
        };
    }
}

<div class="page-header">
    <h1>
        <a href="/audit/protection/otherconfidential" style="color: #64748b; text-decoration: none; margin-right: 12px; font-size: 24px;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <i class="fas fa-door-closed"></i> Доступ в помещения
    </h1>
    <p style="color: #64748b; margin-top: 8px; margin-left: 36px;">Управление доступом в помещения для обработки конфиденциальной информации</p>
</div>

<!-- ВКЛАДКИ -->
<div class="tabs-nav">
    <a href="/audit/protection/other-confidential" class="tab-nav-item" id="tab-btn-confidential-list">
        <i class="fas fa-list"></i> <span>Перечень сведений</span>
    </a>
    <a href="/audit/protection/other-confidential/access" class="tab-nav-item active" id="tab-btn-access-info">
        <i class="fas fa-user-shield"></i> <span>Доступ к информации</span>
    </a>
    <a href="/audit/protection/other-confidential/rooms" class="tab-nav-item" id="tab-btn-room-access">
        <i class="fas fa-door-closed"></i> <span>Доступ в помещения</span>
    </a>
</div>

<!-- Форма с содержимым вкладок -->
<div class="form-content">
    <div id="tab-room-access" class="tab-pane active">
        <div class="toolbar">
            <div class="toolbar-left">
                <button class="btn btn-primary" onclick="openRoomAccessModal()">
                    <i class="fas fa-plus"></i> Добавить
                </button>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" onclick="toggleDropdown('exportDropdown3')">
                        <i class="fas fa-file-export"></i> Экспорт в файл
                        <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>
                    </button>
                    <div id="exportDropdown3" class="dropdown-menu">
                        <a onclick="exportTable('roomAccessTable', 'xlsx')"><i class="fas fa-file-excel"></i> Экспорт в XLSX</a>
                        <a onclick="exportTable('roomAccessTable', 'pdf')"><i class="fas fa-file-pdf"></i> Экспорт в PDF</a>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" onclick="toggleDropdown('settingsRoomDropdown')">
                        <i class="fas fa-cog"></i> Настройка
                        <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>
                    </button>
                    <div id="settingsRoomDropdown" class="dropdown-menu">
                        <label class="dropdown-item"><input type="checkbox" checked onchange="toggleColumn('col-room')"><span>Помещение</span></label>
                        <label class="dropdown-item"><input type="checkbox" checked onchange="toggleColumn('col-room-pos')"><span>Должность</span></label>
                        <label class="dropdown-item"><input type="checkbox" checked onchange="toggleColumn('col-room-emp')"><span>ФИО сотрудника</span></label>
                        <hr style="margin: 4px 0;">
                        <a href="#" onclick="resetRoomTableSettings(); return false;"><i class="fas fa-undo"></i> Сбросить настройки</a>
                    </div>
                </div>
            </div>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="roomAccessSearch" placeholder="Поиск..." oninput="filterTable('roomAccessTable', 'roomAccessSearch')" />
            </div>
        </div>

        <div class="table-container">
            <table id="roomAccessTable" class="data-table">
                <thead>
                    <tr>
                        <th class="th-sortable col-room">
                            <div class="th-header"><span>Помещение</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('roomAccessTable', 0, this.value)" /></div>
                        </th>
                        <th class="th-sortable col-room-pos">
                            <div class="th-header"><span>Должность в организации</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('roomAccessTable', 1, this.value)" /></div>
                        </th>
                        <th class="th-sortable col-room-emp">
                            <div class="th-header"><span>ФИО сотрудника</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('roomAccessTable', 2, this.value)" /></div>
                        </th>
                        <th style="width: 140px;">Действия</th>
                    </tr>
                </thead>
                <tbody id="roomAccessTableBody">
                    <tr><td colspan="4" style="text-align: center; padding: 60px 40px; color: #94a3b8;">Записи не добавлены</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛЬНОЕ ОКНО: Доступ в помещения (Рисунок 172) -->
<!-- ============================================================ -->
<div class="modal" id="roomAccessModal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h3 id="roomAccessModalTitle">Добавление</h3>
            <button class="modal-close" onclick="closeRoomAccessModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="roomAccessForm" onsubmit="saveRoomAccess(event)">
                <input type="hidden" id="roomAccessId" />
                <div class="form-group">
                    <label>Помещение <span class="required">*</span></label>
                    <div class="input-with-buttons">
                        <select id="roomAccessRoom" class="form-control" required>
                            <option value="">Выбрать...</option>
                        </select>
                        <button type="button" class="btn-icon-ref" onclick="openRoomList()" title="Список помещений">
                            <i class="fas fa-list"></i>
                        </button>
                        <button type="button" class="btn-icon-ref add" onclick="addRoom()" title="Добавить помещение">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button type="button" class="btn-icon-ref" onclick="editRoom()" title="Редактировать помещение">
                            <i class="fas fa-edit"></i>
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label>ФИО сотрудника <span class="required">*</span></label>
                    <div class="input-with-buttons">
                        <select id="roomAccessEmployee" class="form-control" required>
                            <option value="">Выбрать...</option>
                        </select>
                        <button type="button" class="btn-icon-ref" onclick="openEmployeeListForRoom()" title="Список сотрудников"><i class="fas fa-list"></i></button>
                        <button type="button" class="btn-icon-ref add" onclick="addEmployeeForRoom()" title="Добавить сотрудника"><i class="fas fa-plus"></i></button>
                        <button type="button" class="btn-icon-ref" onclick="editEmployeeForRoom()" title="Редактировать сотрудника"><i class="fas fa-edit"></i></button>
                    </div>
                </div>
                <div class="form-group">
                    <label>Дата начала</label>
                    <input type="date" id="roomAccessStartDate" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Дата окончания</label>
                    <input type="date" id="roomAccessEndDate" class="form-control" />
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeRoomAccessModal()">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

