<script>
    // Глобальные переменные
    let currentCriteriaId = null;
    let criteriaData = {};
    let operationData = [];
    let editingOperationId = null;

    function showTab(tabName) {
        document.querySelectorAll('.tab-pane').forEach(pane => {
            pane.classList.remove('active');
        });
        document.querySelectorAll('.tab-nav-item').forEach(item => {
            item.classList.remove('active');
        });
        
        document.getElementById('tab-' + tabName).classList.add('active');
        document.getElementById('tab-btn-' + tabName).classList.add('active');
    }

    function saveMainInfo() {
        const type = document.getElementById('objType').value;
        const name = document.getElementById('objName').value.trim();
        const address = document.getElementById('objAddress').value.trim();
        const purpose = document.getElementById('objPurpose').value.trim();
        const sphere = document.getElementById('objSphere').value;

        if (!type || !name || !address || !purpose || !sphere) {
            alert('Пожалуйста, заполните все обязательные поля (отмечены звездочкой)');
            return;
        }
        alert('Основные сведения сохранены!\n\nТеперь доступны для заполнения остальные разделы.');
    }

    function saveNetworkInfo() {
        const category = document.getElementById('networkCategory').value;
        const operator = document.getElementById('operatorName').value;
        const purpose = document.getElementById('networkPurpose').value;
        const method = document.getElementById('interactionMethod').value;

        if (!category || !operator || !purpose || !method) {
            alert('Пожалуйста, заполните все обязательные поля (отмечены звездочкой)');
            return;
        }
        alert('Сведения о взаимодействии с сетью электросвязи сохранены!');
    }

    function saveSoftwareInfo() {
        const paSystems = document.getElementById('paSystems').value.trim();
        const osSoftware = document.getElementById('osSoftware').value.trim();
        const appSoftware = document.getElementById('appSoftware').value.trim();
        const securityTools = document.getElementById('securityTools').value.trim();

        if (!paSystems || !osSoftware || !appSoftware || !securityTools) {
            alert('Пожалуйста, заполните все обязательные поля (отмечены звездочкой)');
            return;
        }
        alert('Сведения о программных и программно-аппаратных средствах сохранены!');
    }

    let selectedViolators = [];
    let selectedThreats = [];
    let selectedIncidents = [];
    let selectedOrgMeasures = [];
    let selectedTechMeasures = [];

    function addViolatorTag() {
        const select = document.getElementById('violatorSelect');
        const value = select.value;
        const text = select.options[select.selectedIndex].text;
        if (!value || selectedViolators.includes(value)) { select.value = ''; return; }
        selectedViolators.push(value);
        const tag = document.createElement('div');
        tag.className = 'tag';
        tag.id = 'violator-tag-' + value;
        tag.innerHTML = `<span>${text}</span><span class="tag-remove" onclick="removeViolatorTag('${value}')">&times;</span>`;
        document.getElementById('violatorTags').appendChild(tag);
        select.value = '';
    }
    function removeViolatorTag(value) {
        selectedViolators = selectedViolators.filter(v => v !== value);
        const tag = document.getElementById('violator-tag-' + value);
        if (tag) tag.remove();
    }

    function addThreatTag() {
        const select = document.getElementById('threatSelect');
        const value = select.value;
        const text = select.options[select.selectedIndex].text;
        if (!value || selectedThreats.includes(value)) { select.value = ''; return; }
        selectedThreats.push(value);
        const tag = document.createElement('div');
        tag.className = 'tag';
        tag.id = 'threat-tag-' + value;
        tag.innerHTML = `<span>${text}</span><span class="tag-remove" onclick="removeThreatTag('${value}')">&times;</span>`;
        document.getElementById('threatTags').appendChild(tag);
        select.value = '';
    }
    function removeThreatTag(value) {
        selectedThreats = selectedThreats.filter(t => t !== value);
        const tag = document.getElementById('threat-tag-' + value);
        if (tag) tag.remove();
    }

    function addIncidentTag() {
        const select = document.getElementById('incidentSelect');
        const value = select.value;
        const text = select.options[select.selectedIndex].text;
        if (!value || selectedIncidents.includes(value)) { select.value = ''; return; }
        selectedIncidents.push(value);
        const tag = document.createElement('div');
        tag.className = 'tag';
        tag.id = 'incident-tag-' + value;
        tag.innerHTML = `<span>${text}</span><span class="tag-remove" onclick="removeIncidentTag('${value}')">&times;</span>`;
        document.getElementById('incidentTags').appendChild(tag);
        select.value = '';
    }
    function removeIncidentTag(value) {
        selectedIncidents = selectedIncidents.filter(i => i !== value);
        const tag = document.getElementById('incident-tag-' + value);
        if (tag) tag.remove();
    }

    function addOrgMeasureTag() {
        const select = document.getElementById('orgMeasuresSelect');
        const value = select.value;
        const text = select.options[select.selectedIndex].text;
        if (!value || selectedOrgMeasures.includes(value)) { select.value = ''; return; }
        selectedOrgMeasures.push(value);
        const tag = document.createElement('div');
        tag.className = 'tag';
        tag.id = 'org-measure-tag-' + value;
        tag.innerHTML = `<span>${text}</span><span class="tag-remove" onclick="removeOrgMeasureTag('${value}')">&times;</span>`;
        document.getElementById('orgMeasuresTags').appendChild(tag);
        select.value = '';
    }
    function removeOrgMeasureTag(value) {
        selectedOrgMeasures = selectedOrgMeasures.filter(m => m !== value);
        const tag = document.getElementById('org-measure-tag-' + value);
        if (tag) tag.remove();
    }

    function addTechMeasureTag() {
        const select = document.getElementById('techMeasuresSelect');
        const value = select.value;
        const text = select.options[select.selectedIndex].text;
        if (!value || selectedTechMeasures.includes(value)) { select.value = ''; return; }
        selectedTechMeasures.push(value);
        const tag = document.createElement('div');
        tag.className = 'tag';
        tag.id = 'tech-measure-tag-' + value;
        tag.innerHTML = `<span>${text}</span><span class="tag-remove" onclick="removeTechMeasureTag('${value}')">&times;</span>`;
        document.getElementById('techMeasuresTags').appendChild(tag);
        select.value = '';
    }
    function removeTechMeasureTag(value) {
        selectedTechMeasures = selectedTechMeasures.filter(m => m !== value);
        const tag = document.getElementById('tech-measure-tag-' + value);
        if (tag) tag.remove();
    }

    function saveThreatsInfo() {
        if (selectedViolators.length === 0) { alert('Пожалуйста, выберите хотя бы одну категорию нарушителей'); return; }
        if (selectedThreats.length === 0) { alert('Пожалуйста, добавьте хотя бы одну основную угрозу'); return; }
        alert('Сведения об угрозах безопасности информации и категориях нарушителей сохранены!');
    }

    function saveIncidentsInfo() {
        if (selectedIncidents.length === 0) { alert('Пожалуйста, выберите хотя бы один тип компьютерного инцидента'); return; }
        alert('Типы компьютерных инцидентов сохранены!');
    }

    function saveMeasuresInfo() {
        if (selectedOrgMeasures.length === 0) { alert('Пожалуйста, выберите хотя бы одну организационную меру'); return; }
        if (selectedTechMeasures.length === 0) { alert('Пожалуйста, выберите хотя бы одну техническую меру'); return; }
        alert('Организационные и технические меры сохранены!');
    }

    function saveCategorizationInfo() {
        const result = document.querySelector('input[name="categorizationResult"]:checked');
        if (!result) { alert('Пожалуйста, выберите категорию значимости'); return; }
        alert('Категорирование сохранено!');
    }

    function toggleDropdown(dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        const isOpen = dropdown.classList.contains('show');
        closeAllDropdowns();
        if (!isOpen) dropdown.classList.add('show');
    }

    function closeAllDropdowns() {
        document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.remove('show'));
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) closeAllDropdowns();
    });

    function exportCategorization(format) {
        closeAllDropdowns();
        alert(`Экспорт в формате ${format.toUpperCase()} будет реализован`);
    }

    function filterCategorization() {
        const searchTerm = document.getElementById('categorizationSearch').value.toLowerCase();
        const items = document.querySelectorAll('.criteria-item');
        
        items.forEach(item => {
            const text = item.textContent.toLowerCase();
            if (text.includes(searchTerm)) {
                item.classList.add('show');
                item.style.display = '';
                const groupName = item.dataset.group;
                const group = document.querySelector(`.criteria-group[data-group="${groupName}"]`);
                if (group) {
                    const icon = group.querySelector('i');
                    icon.classList.remove('fa-chevron-down');
                    icon.classList.add('fa-chevron-up');
                }
            } else {
                item.classList.remove('show');
                item.style.display = 'none';
            }
        });

        if (searchTerm === '') {
            items.forEach(item => {
                item.classList.remove('show');
                item.style.display = 'none';
            });
            document.querySelectorAll('.criteria-group i').forEach(icon => {
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            });
        }
    }

    // ✅ ФУНКЦИИ ДЛЯ МОДАЛЬНОГО ОКНА КАТЕГОРИРОВАНИЯ
    function openCriteriaModal(criteriaId) {
        currentCriteriaId = criteriaId;
        const modal = document.getElementById('criteriaModal');
        const title = document.getElementById('modalTitle');
        
        const row = document.querySelector(`tr[data-criteria="${criteriaId}"]`);
        const indicatorText = row.querySelector('td:first-child').textContent.trim();
        title.textContent = indicatorText;
        
        if (criteriaData[criteriaId]) {
            const data = criteriaData[criteriaId];
            document.getElementById('notApplicable').checked = data.notApplicable || false;
            document.getElementById('criteriaValueSelect').value = data.valueSelect || '';
            document.getElementById('criteriaValueText').value = data.valueText || '';
            document.getElementById('criteriaJustification').value = data.justification || '';
        } else {
            document.getElementById('notApplicable').checked = false;
            document.getElementById('criteriaValueSelect').value = '';
            document.getElementById('criteriaValueText').value = '';
            document.getElementById('criteriaJustification').value = '';
        }
        
        toggleNotApplicableInModal();
        modal.classList.add('show');
    }

    function closeCriteriaModal() {
        const modal = document.getElementById('criteriaModal');
        modal.classList.remove('show');
        currentCriteriaId = null;
    }

    function toggleNotApplicableInModal() {
        const isNotApplicable = document.getElementById('notApplicable').checked;
        const fields = document.getElementById('criteriaFields');
        
        if (isNotApplicable) {
            fields.style.opacity = '0.5';
            fields.style.pointerEvents = 'none';
        } else {
            fields.style.opacity = '1';
            fields.style.pointerEvents = 'auto';
        }
    }

    function saveCriteriaModal() {
        const isNotApplicable = document.getElementById('notApplicable').checked;
        const valueSelect = document.getElementById('criteriaValueSelect').value;
        const valueText = document.getElementById('criteriaValueText').value.trim();
        const justification = document.getElementById('criteriaJustification').value.trim();
        
        if (!isNotApplicable) {
            if (!valueSelect && !valueText) {
                alert('Пожалуйста, заполните значение показателя');
                return;
            }
            if (!justification) {
                alert('Пожалуйста, заполните обоснование');
                return;
            }
        }
        
        criteriaData[currentCriteriaId] = {
            notApplicable: isNotApplicable,
            valueSelect: valueSelect,
            valueText: valueText,
            justification: justification
        };
        
        const valueDisplay = document.getElementById(`display-${currentCriteriaId}`);
        const justDisplay = document.getElementById(`display-just-${currentCriteriaId}`);
        
        if (isNotApplicable) {
            valueDisplay.textContent = 'неприменимо';
            valueDisplay.style.color = '#94a3b8';
            valueDisplay.style.fontStyle = 'italic';
            justDisplay.textContent = 'неприменимо';
            justDisplay.style.color = '#94a3b8';
            justDisplay.style.fontStyle = 'italic';
        } else {
            const displayValue = valueText || valueSelect;
            valueDisplay.textContent = displayValue;
            valueDisplay.style.color = '#1e293b';
            valueDisplay.style.fontStyle = 'normal';
            justDisplay.textContent = justification;
            justDisplay.style.color = '#1e293b';
            justDisplay.style.fontStyle = 'normal';
        }
        
        closeCriteriaModal();
        alert('Показатель сохранен!');
    }

    // ✅ ФУНКЦИИ ДЛЯ ВКЛАДКИ "СВЕДЕНИЯ ОБ ЭКСПЛУАТАЦИИ" (ОБНОВЛЕНО)
    function openOperationModal(id = null) {
        const modal = document.getElementById('operationModal');
        const title = document.getElementById('operationModalTitle');
        
        if (id) {
            editingOperationId = id;
            title.textContent = 'Редактирование субъекта';
            const data = operationData.find(item => item.id === id);
            if (data) {
                document.getElementById('subjectType').value = data.subjectType;
                document.getElementById('subjectName').value = data.subjectName || '';
                document.getElementById('kiiElement').value = data.kiiElement;
            }
        } else {
            editingOperationId = null;
            title.textContent = 'Добавление нового субъекта';
            document.getElementById('subjectType').value = '';
            document.getElementById('subjectName').value = '';
            document.getElementById('kiiElement').value = '';
        }
        
        modal.classList.add('show');
    }

    function closeOperationModal() {
        const modal = document.getElementById('operationModal');
        modal.classList.remove('show');
        editingOperationId = null;
    }

    function saveOperationModal() {
        const subjectType = document.getElementById('subjectType').value;
        const subjectName = document.getElementById('subjectName').value.trim();
        const kiiElement = document.getElementById('kiiElement').value;
        
        if (!subjectType || !subjectName || !kiiElement) {
            alert('Пожалуйста, заполните все обязательные поля');
            return;
        }
        
        const subjectTypeText = document.getElementById('subjectType').options[document.getElementById('subjectType').selectedIndex].text;
        const kiiElementText = document.getElementById('kiiElement').options[document.getElementById('kiiElement').selectedIndex].text;
        
        if (editingOperationId) {
            const index = operationData.findIndex(item => item.id === editingOperationId);
            if (index !== -1) {
                operationData[index] = {
                    id: editingOperationId,
                    subjectType: subjectType,
                    subjectTypeText: subjectTypeText,
                    subjectName: subjectName,
                    kiiElement: kiiElement,
                    kiiElementText: kiiElementText
                };
            }
        } else {
            const newId = Date.now();
            operationData.push({
                id: newId,
                subjectType: subjectType,
                subjectTypeText: subjectTypeText,
                subjectName: subjectName,
                kiiElement: kiiElement,
                kiiElementText: kiiElementText
            });
        }
        
        renderOperationTable();
        closeOperationModal();
        alert('Субъект сохранен!');
    }

    function deleteOperation(id) {
        if (confirm('Вы уверены, что хотите удалить эту запись?')) {
            operationData = operationData.filter(item => item.id !== id);
            renderOperationTable();
        }
    }

    function renderOperationTable() {
        const tbody = document.getElementById('operationTableBody');
        tbody.innerHTML = '';
        
        if (operationData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; padding: 40px; color: #94a3b8;">Объекты КИИ не добавлены</td></tr>`;
            return;
        }

        operationData.forEach(item => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td style="padding: 12px; border-bottom: 1px solid #e2e8f0;">${item.subjectTypeText}</td>
                <td style="padding: 12px; border-bottom: 1px solid #e2e8f0;">${item.subjectName}</td>
                <td style="padding: 12px; border-bottom: 1px solid #e2e8f0;">${item.kiiElementText}</td>
                <td style="padding: 12px; text-align: center; border-bottom: 1px solid #e2e8f0;">
                    <button type="button" class="btn-action btn-edit" onclick="openOperationModal(${item.id})" title="Редактировать">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="btn-action btn-delete" onclick="deleteOperation(${item.id})" title="Удалить">
                        <i class="fas fa-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function filterOperationTable() {
        const searchTerm = document.getElementById('operationSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#operationTableBody tr');
        
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            if (text.includes(searchTerm)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function exportOperation(format) {
        closeAllDropdowns();
        alert(`Экспорт в формате ${format.toUpperCase()} будет реализован`);
    }

    function saveOperationInfo() {
        if (operationData.length === 0) {
            alert('Добавьте хотя бы одного субъекта');
            return;
        }
        alert('Сведения об эксплуатации сохранены!');
    }

    // Инициализация при загрузке страницы
    document.addEventListener('DOMContentLoaded', function() {
        // Обработка клика по группам критериев (сворачивание/разворачивание)
        document.querySelectorAll('.criteria-group').forEach(group => {
            group.addEventListener('click', function() {
                const groupName = this.dataset.group;
                const icon = this.querySelector('i');
                const items = document.querySelectorAll(`.criteria-item[data-group="${groupName}"]`);
                
                items.forEach(item => {
                    item.classList.toggle('show');
                    if (item.classList.contains('show')) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
                
                if (icon.classList.contains('fa-chevron-down')) {
                    icon.classList.remove('fa-chevron-down');
                    icon.classList.add('fa-chevron-up');
                } else {
                    icon.classList.remove('fa-chevron-up');
                    icon.classList.add('fa-chevron-down');
                }
            });
        });

        // Рендер пустой таблицы эксплуатации при загрузке
        renderOperationTable();
    });

    // Закрытие модальных окон при клике вне их области
    document.getElementById('criteriaModal').addEventListener('click', function(e) {
        if (e.target === this) closeCriteriaModal();
    });

    document.getElementById('operationModal').addEventListener('click', function(e) {
        if (e.target === this) closeOperationModal();
    });
</script>