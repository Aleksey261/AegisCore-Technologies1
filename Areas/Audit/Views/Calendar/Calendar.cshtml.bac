@model List<AegisCore.Models.CalendarEvent>
@{
    ViewData["Title"] = "Календарь";
}

<div class="dashboard-main">
    <div class="welcome-section">
        <h1><i class="fas fa-calendar"></i> Календарь</h1>
        <p>Планирование мероприятий и событий</p>
    </div>

    <div class="stats-section">
        <div class="section-header">
            <h2>События</h2>
            <button class="btn btn-primary" onclick="alert('Функция добавления события')">
                <i class="fas fa-plus"></i> Добавить событие
            </button>
        </div>
        
        <table class="data-table">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Дата начала</th>
                    <th>Тип</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var evt in Model)
                {
                    <tr>
                        <td>@evt.Title</td>
                        <td>@evt.StartDate.ToString("dd.MM.yyyy")</td>
                        <td>@evt.Type</td>
                        <td><span class="badge @(evt.Completed ? "success" : "warning")">@(evt.Completed ? "Завершено" : "Запланировано")</span></td>
                        <td class="actions">
                            <button class="btn-icon edit"><i class="fas fa-edit"></i></button>
                            <button class="btn-icon delete"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>