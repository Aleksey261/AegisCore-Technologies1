@model AegisCore.Models.InfrastructureViewModel
@{
    ViewData["Title"] = "Хранилища";
}

<div class="section-header">
    <h2 class="section-title">
        <i class="fas fa-hdd"></i> Хранилища материальных носителей ПДн
    </h2>
    <div class="header-info">
        <i class="fas fa-info-circle" title="Учёт хранилищ"></i>
        <span style="color: #64748b; font-size: 14px;">В данном разделе указываются места хранения материальных носителей ПДн.</span>
    </div>
</div>

<div class="toolbar">
    <div class="toolbar-left">
        <!-- Кнопка Добавить СЛЕВА -->
        <button class="btn btn-primary" onclick="openStorageModal()">
            <i class="fas fa-plus"></i> Добавить
        </button>

        <button class="btn btn-secondary" onclick="openImportModal('storage')">
            <i class="fas fa-file-import"></i> Загрузить из файла
        </button>

        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="storageSearch" placeholder="Поиск по хранилищам..." value="@Model.Search" oninput="filterStorage()" />
        </div>
    </div>
</div>

<div class="table-container">
    <table class="data-table" id="storageTable">
        <thead>
            <tr>
                <th class="th-sortable">
                    <div class="th-header">
                        <span>Вид</span>
                        <i class="fas fa-sort sortable-icon"></i>
                    </div>
                    <div class="th-filter-row">
                        <select class="filter-inline-select" onchange="filterTable('storageTable', 0, this.value)">
                            <option value="">(Все)</option>
                            <option value="Жесткий диск">Жесткий диск</option>
                            <option value="SSD накопитель">SSD накопитель</option>
                            <option value="USB-флеш">USB-флеш</option>
                            <option value="Оптический диск">Оптический диск</option>
                            <option value="Лента">Лента</option>
                            <option value="Сетевое хранилище">Сетевое хранилище</option>
                        </select>
                    </div>
                </th>
                <th class="th-sortable">
                    <div class="th-header">
                        <span>Наименование</span>
                        <i class="fas fa-sort sortable-icon"></i>
                    </div>
                    <div class="th-filter-row">
                        <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('storageTable', 1, this.value)" />
                    </div>
                </th>
                <th class="th-sortable">
                    <div class="th-header">
                        <span>Инв. номер</span>
                        <i class="fas fa-sort sortable-icon"></i>
                    </div>
                    <div class="th-filter-row">
                        <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('storageTable', 2, this.value)" />
                    </div>
                </th>
                <th class="th-sortable">
                    <div class="th-header">
                        <span>Дата приобретения</span>
                        <i class="fas fa-sort sortable-icon"></i>
                    </div>
                    <div class="th-filter-row">
                        <input type="date" class="filter-inline-input" oninput="filterTable('storageTable', 3, this.value)" />
                    </div>
                </th>
                <th class="th-sortable">
                    <div class="th-header">
                        <span>Дата списания</span>
                        <i class="fas fa-sort sortable-icon"></i>
                    </div>
                    <div class="th-filter-row">
                        <input type="date" class="filter-inline-input" oninput="filterTable('storageTable', 4, this.value)" />
                    </div>
                </th>
                <th style="width: 100px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Storages != null && Model.Storages.Any())
            {
                @foreach (var item in Model.Storages)
                {
                    <tr data-id="@item.Id">
                        <td><span class="badge info">@item.Type</span></td>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.InventoryNumber</td>
                        <td>@(item.PurchaseDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td class="@(item.WriteOffDate.HasValue ? "text-danger" : "")">
                            @(item.WriteOffDate?.ToString("dd.MM.yyyy") ?? "—")
                        </td>
                        <td class="actions">
                            <button class="btn-icon edit" title="Редактировать" onclick="editStorage('@item.Id')"><i class="fas fa-edit"></i></button>
                            <button class="btn-icon delete" title="Удалить" onclick="deleteStorage('@item.Id')"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align: center; padding: 60px 40px; color: #94a3b8;">
                        <i class="fas fa-hdd" style="font-size: 64px; margin-bottom: 16px; display: block; color: #cbd5e1;"></i>
                        <div style="font-size: 16px; font-weight: 500;">Хранилища не добавлены</div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="pagination">
        <div class="pagination-page-size">
            <label>Показывать по:</label>
            <select onchange="changePageSize(this.value)">
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
        <div class="pagination-info">
            Страница @Model.CurrentPage из @Model.TotalPages (Всего элементов: @Model.TotalItems)
        </div>
        <div class="pagination-buttons">
            @if (Model.CurrentPage > 1)
            {
                <a href="/audit/infrastructure?section=storage&page=@(Model.CurrentPage - 1)" class="btn-pagination">‹</a>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="/audit/infrastructure?section=storage&page=@i" class="btn-pagination @(i == Model.CurrentPage ? "active" : "")">@i</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="/audit/infrastructure?section=storage&page=@(Model.CurrentPage + 1)" class="btn-pagination">›</a>
            }
        </div>
    </div>
}

<!-- ============================================================ -->
<!-- МОДАЛКА ДОБАВЛЕНИЯ/РЕДАКТИРОВАНИЯ ХРАНИЛИЩА (Рисунок 40) -->
<!-- ============================================================ -->
<div class="modal" id="storageModal">
    <div class="modal-content" style="max-width: 650px;">
        <div class="modal-header">
            <h3 id="storageModalTitle">Добавление хранилища</h3>
            <button class="modal-close" onclick="closeStorageModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="storageForm" onsubmit="saveStorage(event)">
                <input type="hidden" id="storageId" name="id" />
                
                <div class="form-group">
                    <label>Вид <span class="required">*</span></label>
                    <div class="input-with-buttons">
                        <select name="type" id="storageType" class="form-control" required>
                            <option value="">Выбрать...</option>
                            <option value="Жесткий диск">Жесткий диск</option>
                            <option value="SSD накопитель">SSD накопитель</option>
                            <option value="USB-флеш">USB-флеш</option>
                            <option value="Оптический диск">Оптический диск</option>
                            <option value="Лента">Лента</option>
                            <option value="Сетевое хранилище">Сетевое хранилище</option>
                        </select>
                    </div>
                    <!-- Ссылка "+ Новый вид" под полем (Рисунок 40) -->
                    <button type="button" class="btn-link-add" onclick="openAddTypeModal()" title="Добавить новый вид">
                        <i class="fas fa-plus"></i> Новый вид
                    </button>
                </div>
                
                <div class="form-group">
                    <label>Наименование <span class="required">*</span></label>
                    <input type="text" name="name" id="storageName" class="form-control" required placeholder="Введите наименование" />
                </div>
                
                <div class="form-group">
                    <label>Инвентарный номер <span class="required">*</span></label>
                    <input type="text" name="inventoryNumber" id="storageInventoryNumber" class="form-control" required placeholder="Введите инвентарный номер" />
                </div>
                
                <div class="form-group">
                    <label>Описание</label>
                    <textarea name="description" id="storageDescription" class="form-control" rows="3" placeholder="Введите описание"></textarea>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Дата приобретения <span class="required">*</span></label>
                        <input type="date" name="purchaseDate" id="storagePurchaseDate" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Дата списания</label>
                        <input type="date" name="writeOffDate" id="storageWriteOffDate" class="form-control" />
                    </div>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeStorageModal()">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛКА ДОБАВЛЕНИЯ НОВОГО ВИДА ХРАНИЛИЩА (Рисунок 41) -->
<!-- ============================================================ -->
<div class="modal" id="addTypeModal">
    <div class="modal-content" style="max-width: 500px;">
        <div class="modal-header">
            <h3>Добавление вид хранилища</h3>
            <button class="modal-close" onclick="closeAddTypeModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addTypeForm" onsubmit="saveNewType(event)">
                <div class="form-group">
                    <label>Наименование <span class="required">*</span></label>
                    <input type="text" id="newTypeName" class="form-control" required placeholder="Введите наименование вида" />
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeAddTypeModal()">Отменить</button>
                    <button type="submit" class="btn btn-primary">Сохранить вид</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛКА ИМПОРТА (Рисунок 42) -->
<!-- ============================================================ -->
<div class="modal" id="importModal">
    <div class="modal-content" style="max-width: 650px;">
        <div class="modal-header">
            <h3>Загрузка списка хранилищ</h3>
            <button class="modal-close" onclick="closeImportModal()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="import-info" style="background: #f8fafc; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                <p style="margin: 0 0 12px 0;"><i class="fas fa-info-circle" style="color: #3b82f6;"></i> Вы можете загрузить файл в формате *.xls, *.xlsx, *.ods. Размер файла не должен превышать 20МВ. Формат файла можно посмотреть <a href="#" style="color: #4F46E5; text-decoration: underline;">здесь</a></p>
            </div>
            
            <div class="upload-area" id="uploadArea" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)" style="border: 2px dashed #cbd5e1; border-radius: 8px; padding: 40px; text-align: center; background: #f8fafc; cursor: pointer; transition: all 0.2s;">
                <div class="upload-placeholder">
                    <i class="fas fa-cloud-upload-alt" style="font-size: 48px; color: #94a3b8; margin-bottom: 16px;"></i>
                    <p style="color: #64748b; margin-bottom: 16px;">Выберите файл или перетащите его в эту область</p>
                    <input type="file" id="importFile" accept=".xls,.xlsx,.ods" style="display: none;" onchange="handleFileSelect(event)" />
                    <button type="button" class="btn btn-primary" onclick="document.getElementById('importFile').click()">
                        <i class="fas fa-folder-open"></i> Выберите файл
                    </button>
                </div>
            </div>
            
            <div class="form-actions" style="margin-top: 20px;">
                <button type="button" class="btn btn-secondary" onclick="closeImportModal()">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="uploadImportFile()">
                    <i class="fas fa-upload"></i> Загрузить данные в таблицу
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛКА УСПЕШНОЙ ЗАГРУЗКИ (Рисунок 43) -->
<!-- ============================================================ -->
<div class="modal" id="successImportModal">
    <div class="modal-content" style="max-width: 400px;">
        <div class="modal-header">
            <h3 style="color: #10b981;"><i class="fas fa-check-circle"></i> Успешно</h3>
            <button class="modal-close" onclick="closeSuccessImportModal()">&times;</button>
        </div>
        <div class="modal-body">
            <p id="importSuccessMessage" style="font-size: 14px; color: #475569; margin: 0;">Файл хран.xlsx обработан. Загружено строк: 0</p>
            <div class="form-actions" style="justify-content: center; border-top: none; padding-top: 16px; margin-top: 16px;">
                <button type="button" class="btn btn-secondary" onclick="closeSuccessImportModal()">ОК</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛКА ОШИБКИ ПРИ УДАЛЕНИИ (Рисунок 44) -->
<!-- ============================================================ -->
<div class="modal" id="errorModal">
    <div class="modal-content" style="max-width: 400px;">
        <div class="modal-header">
            <h3 style="color: #ef4444;"><i class="fas fa-exclamation-triangle"></i> Ошибка</h3>
            <button class="modal-close" onclick="closeErrorModal()">&times;</button>
        </div>
        <div class="modal-body">
            <p id="errorMessage" style="font-size: 14px; color: #475569; margin: 0;">Невозможно удалить. Данная запись используется.</p>
            <div class="form-actions" style="justify-content: center; border-top: none; padding-top: 16px; margin-top: 16px;">
                <button type="button" class="btn btn-secondary" onclick="closeErrorModal()">ОК</button>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-link-add {
        background: none;
        border: none;
        color: #4F46E5;
        cursor: pointer;
        font-size: 13px;
        padding: 4px 8px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
        margin-top: 4px;
    }
    .btn-link-add:hover {
        color: #4338CA;
        text-decoration: underline;
    }
    .upload-area.drag-over {
        border-color: #4F46E5;
        background: #eef2ff;
    }
    .file-info {
        background: white;
        padding: 16px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }
    .file-name {
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 8px;
    }
    .file-size {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 8px;
    }
    .file-status {
        color: #10b981;
        font-size: 13px;
    }
</style>

<script>
    const storagesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Storages ?? new List<AegisCore.Models.Storage>()));

    // ============================================================
    // МОДАЛКА ХРАНИЛИЩА
    // ============================================================
    function openStorageModal() {
        document.getElementById('storageForm').reset();
        document.getElementById('storageId').value = '';
        document.getElementById('storageModalTitle').textContent = 'Добавление хранилища';
        document.getElementById('storageModal').classList.add('show');
    }

    function closeStorageModal() {
        document.getElementById('storageModal').classList.remove('show');
    }

    function editStorage(id) {
        const item = storagesData.find(s => s.id === id);
        if (!item) return;
        document.getElementById('storageId').value = item.id;
        document.getElementById('storageType').value = item.type || '';
        document.getElementById('storageName').value = item.name || '';
        document.getElementById('storageInventoryNumber').value = item.inventoryNumber || '';
        document.getElementById('storageDescription').value = item.description || '';
        document.getElementById('storagePurchaseDate').value = item.purchaseDate ? item.purchaseDate.split('T')[0] : '';
        document.getElementById('storageWriteOffDate').value = item.writeOffDate ? item.writeOffDate.split('T')[0] : '';
        document.getElementById('storageModalTitle').textContent = 'Редактирование хранилища';
        document.getElementById('storageModal').classList.add('show');
    }

    function deleteStorage(id) {
        if (!confirm('Удалить запись?')) return;
        fetch('/audit/infrastructure/storage/delete/' + id, { method: 'DELETE' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    // Показываем модалку ошибки (Рисунок 44)
                    document.getElementById('errorMessage').textContent = data.error || 'Невозможно удалить. Данная запись используется.';
                    document.getElementById('errorModal').classList.add('show');
                }
            });
    }

    function saveStorage(e) {
        e.preventDefault();
        const form = e.target;
        const data = {
            id: form.id.value || null,
            type: form.type.value,
            name: form.name.value,
            inventoryNumber: form.inventoryNumber.value,
            description: form.description.value,
            purchaseDate: form.purchaseDate.value || null,
            writeOffDate: form.writeOffDate.value || null
        };
        fetch('/audit/infrastructure/storage/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                closeStorageModal();
                location.reload();
            } else {
                alert(result.error || 'Ошибка при сохранении');
            }
        });
    }

    // ============================================================
    // МОДАЛКА ДОБАВЛЕНИЯ НОВОГО ВИДА (Рисунок 41)
    // ============================================================
    function openAddTypeModal() {
        document.getElementById('addTypeForm').reset();
        document.getElementById('addTypeModal').classList.add('show');
    }

    function closeAddTypeModal() {
        document.getElementById('addTypeModal').classList.remove('show');
    }

    function saveNewType(e) {
        e.preventDefault();
        const newType = document.getElementById('newTypeName').value;
        const select = document.getElementById('storageType');
        const option = document.createElement('option');
        option.value = newType;
        option.textContent = newType;
        option.selected = true;
        select.appendChild(option);
        closeAddTypeModal();
        closeStorageModal();
        openStorageModal(); // Reopen to show new type selected
    }

    // ============================================================
    // ИМПОРТ ИЗ ФАЙЛА (Рисунок 42)
    // ============================================================
    function openImportModal(type) {
        document.getElementById('uploadArea').innerHTML = `
            <div class="upload-placeholder">
                <i class="fas fa-cloud-upload-alt" style="font-size: 48px; color: #94a3b8; margin-bottom: 16px;"></i>
                <p style="color: #64748b; margin-bottom: 16px;">Выберите файл или перетащите его в эту область</p>
                <input type="file" id="importFile" accept=".xls,.xlsx,.ods" style="display: none;" onchange="handleFileSelect(event)" />
                <button type="button" class="btn btn-primary" onclick="document.getElementById('importFile').click()">
                    <i class="fas fa-folder-open"></i> Выберите файл
                </button>
            </div>
        `;
        document.getElementById('importModal').classList.add('show');
    }

    function closeImportModal() {
        document.getElementById('importModal').classList.remove('show');
    }

    function handleDragOver(e) {
        e.preventDefault();
        e.currentTarget.classList.add('drag-over');
    }

    function handleDragLeave(e) {
        e.currentTarget.classList.remove('drag-over');
    }

    function handleDrop(e) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-over');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            document.getElementById('importFile').files = files;
            showFileInfo(files[0]);
        }
    }

    function handleFileSelect(e) {
        if (e.target.files.length > 0) {
            showFileInfo(e.target.files[0]);
        }
    }

    function showFileInfo(file) {
        const uploadArea = document.getElementById('uploadArea');
        uploadArea.innerHTML = `
            <div class="file-info">
                <div class="file-name"><i class="fas fa-file-excel"></i> ${file.name}</div>
                <div class="file-size">${(file.size / 1024).toFixed(2)} KB</div>
                <div class="file-status"><i class="fas fa-check-circle"></i> Файл готов к загрузке</div>
            </div>
        `;
    }

    function uploadImportFile() {
        // Имитация успешной загрузки (Рисунок 43)
        document.getElementById('importSuccessMessage').textContent = 'Файл хран.xlsx обработан. Загружено строк: 0';
        closeImportModal();
        document.getElementById('successImportModal').classList.add('show');
    }

    function closeSuccessImportModal() {
        document.getElementById('successImportModal').classList.remove('show');
        location.reload();
    }

    function downloadTemplate(type) {
        alert('Скачивание шаблона для: ' + type);
    }

    // ============================================================
    // ФИЛЬТРАЦИЯ
    // ============================================================
    function filterStorage() {
        const search = document.getElementById('storageSearch').value.toLowerCase();
        document.querySelectorAll('#storageTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(search) ? '' : 'none';
        });
    }

    function filterTable(tableId, colIndex, value) {
        const table = document.getElementById(tableId);
        const rows = table.querySelectorAll('tbody tr');
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                const text = cell.textContent.toLowerCase();
                row.style.display = text.includes(value.toLowerCase()) ? '' : 'none';
            }
        });
    }

    function changePageSize(size) {
        const url = new URL(window.location);
        url.searchParams.set('pageSize', size);
        window.location.href = url.toString();
    }

    function closeErrorModal() {
        document.getElementById('errorModal').classList.remove('show');
    }
</script>