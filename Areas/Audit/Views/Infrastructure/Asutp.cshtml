@model AegisCore.Models.InfrastructureViewModel
@{
    ViewData["Title"] = "АСУ ТП";
}

@if (ViewBag.ShowCreateModal == true)
{
    <!-- ============================================================ -->
    <!-- НОВАЯ ВКЛАДКА: ДОБАВЛЕНИЕ АСУ ТП -->
    <!-- ============================================================ -->
    
    <div class="section-header">
        <h2 class="section-title">
            <i class="fas fa-industry"></i> АСУ ТП
        </h2>
        <div class="header-info">
            <i class="fas fa-info-circle" title="Учёт АСУ ТП"></i>
            <span style="color: #64748b; font-size: 14px;">Автоматизированная система управления технологическими процессами</span>
        </div>
    </div>

    <!-- ✅ ДОБАВЛЕН TOOLBAR -->
    <div class="toolbar">
        <div class="toolbar-left">
            <a href="/audit/infrastructure?section=asutp" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Назад к списку
            </a>
        </div>
    </div>

    <div class="tabs-nav" style="margin-bottom: 20px;">
        <a href="#tab-basic" class="tab-nav-item active" onclick="switchTab(event, 'tab-basic')">
            <i class="fas fa-info-circle"></i> Основные сведения
        </a>
        <a href="#tab-classification" class="tab-nav-item" onclick="switchTab(event, 'tab-classification')">
            <i class="fas fa-layer-group"></i> Классификация АСУ
        </a>
        <a href="#tab-attestation" class="tab-nav-item" onclick="switchTab(event, 'tab-attestation')">
            <i class="fas fa-certificate"></i> Аттестация
        </a>
        <a href="#tab-software" class="tab-nav-item" onclick="switchTab(event, 'tab-software')">
            <i class="fas fa-laptop-code"></i> Перечень ПО в АСУ
        </a>
        <a href="#tab-structural" class="tab-nav-item" onclick="switchTab(event, 'tab-structural')">
            <i class="fas fa-sitemap"></i> Структурные элементы
        </a>
        <a href="#tab-users" class="tab-nav-item" onclick="switchTab(event, 'tab-users')">
            <i class="fas fa-users"></i> Группы пользователей
        </a>
        <a href="#tab-schemes" class="tab-nav-item" onclick="switchTab(event, 'tab-schemes')">
            <i class="fas fa-project-diagram"></i> Схемы
        </a>
        <a href="#tab-documents" class="tab-nav-item" onclick="switchTab(event, 'tab-documents')">
            <i class="fas fa-file-alt"></i> Документы
        </a>
    </div>

    <form id="asutpForm" onsubmit="saveAsutp(event)">
        <input type="hidden" id="asutpId" name="id" />

        <!-- Вкладка 1: Основные сведения -->
        <div id="tab-basic" class="tab-content active">
            <h3 style="margin-bottom: 20px; color: #1e293b;">Основные сведения</h3>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Наименование <span class="required">*</span></label>
                    <input type="text" name="name" id="asutpName" class="form-control" required placeholder="Введите наименование АСУ ТП" />
                </div>
                <div class="form-group">
                    <label>Дата ввода в эксплуатацию</label>
                    <input type="date" name="commissioningDate" id="asutpCommissioningDate" class="form-control" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Номер акта</label>
                    <input type="text" name="actNumber" id="asutpActNumber" class="form-control" placeholder="Введите номер акта" />
                </div>
                <div class="form-group">
                    <label>Обладатель информации</label>
                    <div class="input-with-buttons">
                        <select name="informationOwner" id="asutpInformationOwner" class="form-control">
                            <option value="">Выбрать...</option>
                            @if (Model.Organizations != null)
                            {
                                @foreach (var org in Model.Organizations)
                                {
                                    <option value="@org.Name">@org.Name</option>
                                }
                            }
                        </select>
                        <button type="button" class="btn-icon-ref" title="Редактировать" onclick="editReference('organizations')">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button type="button" class="btn-icon-ref add" title="Добавить" onclick="openOrganizationModal()">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Назначение системы <span class="required">*</span></label>
                <textarea name="purpose" id="asutpPurpose" class="form-control" rows="3" required placeholder="Опишите назначение системы"></textarea>
            </div>

            <div class="form-group">
                <label>Цели</label>
                <textarea name="goals" id="asutpGoals" class="form-control" rows="3" placeholder="Опишите цели системы"></textarea>
            </div>

            <div class="form-group">
                <label>Задачи, которые решает система</label>
                <textarea name="tasks" id="asutpTasks" class="form-control" rows="3" placeholder="Опишите задачи системы"></textarea>
            </div>

            <div class="form-group">
                <label>Обрабатываемые сведения</label>
                <textarea name="processedData" id="asutpProcessedData" class="form-control" rows="3" placeholder="Опишите обрабатываемые сведения"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Вид размещения</label>
                    <select name="placementType" id="asutpPlacementType" class="form-control">
                        <option value="">Выбрать...</option>
                        <option value="Локальное">Локальное</option>
                        <option value="Распределенное">Распределенное</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Режим обработки данных</label>
                    <select name="processingMode" id="asutpProcessingMode" class="form-control">
                        <option value="">Выбрать...</option>
                        <option value="Автоматизированный">Автоматизированный</option>
                        <option value="Автоматический">Автоматический</option>
                        <option value="Ручной">Ручной</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Взаимодействие с другими системами</label>
                <textarea name="systemInteraction" id="asutpSystemInteraction" class="form-control" rows="3" placeholder="Опишите взаимодействие с другими системами"></textarea>
            </div>

            <div class="form-group">
                <label>Характеристики безопасности</label>
                <select name="securityCharacteristics" id="asutpSecurityCharacteristics" class="form-control">
                    <option value="">Выбрать...</option>
                    <option value="Высокий">Высокий</option>
                    <option value="Средний">Средний</option>
                    <option value="Низкий">Низкий</option>
                </select>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="isCriticalObject" id="asutpIsCriticalObject" />
                    <span>Установлено на критически важных объектах</span>
                </label>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" name="usesSkzi" id="asutpUsesSkzi" />
                    <span>Используется СКЗИ</span>
                </label>
            </div>

            <div class="form-actions">
                <a href="/audit/infrastructure?section=asutp" class="btn btn-secondary">Отмена</a>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-classification')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- ✅ Вкладка 2: Классификация АСУ -->
        <div id="tab-classification" class="tab-content">
            <h3 style="margin-bottom: 20px; color: #1e293b;">Классификация системы</h3>
            
            <div style="background: #f8fafc; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                <h4 style="margin-bottom: 12px; color: #475569;">Классификация защищенности АСУ ТП</h4>
                
                <div class="form-group">
                    <label>Уровень защищаемой информации <span class="required">*</span></label>
                    <select name="significanceLevel" id="asutpSignificanceLevel" class="form-control" required>
                        <option value="">Выбрать...</option>
                        <option value="У1">У1</option>
                        <option value="У2">У2</option>
                        <option value="У3">У3</option>
                        <option value="У31">У31</option>
                        <option value="У32">У32</option>
                        <option value="У4">У4</option>
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Класс защищенности</label>
                        <div class="input-with-buttons">
                            <input type="text" id="calculatedAsutpSecurityClass" class="form-control" readonly placeholder="Определяется автоматически" />
                            <button type="button" class="btn btn-secondary" onclick="calculateAsutpSecurityClass()">Определить</button>
                        </div>
                        <input type="hidden" name="securityClass" id="asutpSecurityClass" />
                    </div>
                    <div class="form-group">
                        <label>Дата акта</label>
                        <input type="date" id="asutpSecurityClassDate" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Номер акта</label>
                    <input type="text" id="asutpSecurityClassActNumber" class="form-control" placeholder="Введите номер акта" />
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-basic')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-attestation')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 3: Аттестация -->
        <div id="tab-attestation" class="tab-content">
            <h3 style="margin-bottom: 20px; color: #1e293b;">Сведения о соответствии требованиям по защите информации</h3>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Дата протокола аттестационных испытаний</label>
                    <input type="date" name="protocolDate" id="asutpProtocolDate" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Номер протокола аттестационных испытаний</label>
                    <input type="text" name="protocolNumber" id="asutpProtocolNumber" class="form-control" placeholder="Введите номер протокола" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Дата заключения аттестационных испытаний</label>
                    <input type="date" name="conclusionDate" id="asutpConclusionDate" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Номер заключения аттестационных испытаний</label>
                    <input type="text" name="conclusionNumber" id="asutpConclusionNumber" class="form-control" placeholder="Введите номер заключения" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Дата аттестата соответствия</label>
                    <input type="date" name="certificateDate" id="asutpCertificateDate" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Номер аттестата соответствия</label>
                    <input type="text" name="certificateNumber" id="asutpCertificateNumber" class="form-control" placeholder="Введите номер аттестата" />
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-classification')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-software')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- ✅ Вкладка 4: Перечень ПО в АСУ -->
        <div id="tab-software" class="tab-content">
            <div class="section-header" style="margin-bottom: 20px;">
                <h3 style="color: #1e293b;">Перечень ПО входящих в состав АСУ ТП</h3>
            </div>
            
            <div class="toolbar" style="margin-bottom: 20px;">
                <div class="toolbar-left">
                    <button type="button" class="btn btn-primary" onclick="openSoftwareSelectionModal()">
                        <i class="fas fa-plus"></i> Добавить
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="softwareInAsutpSearch" placeholder="Поиск..." oninput="filterSoftwareInAsutp()" />
                    </div>
                </div>
            </div>
            
            <div class="table-container">
                <table class="data-table" id="softwareInAsutpTable">
                    <thead>
                        <tr>
                            <th style="width: 40px;"><input type="checkbox" id="selectAllSoftwareInAsutp" onchange="toggleSelectAllSoftwareInAsutp()" /></th>
                            <th>Наименование</th>
                            <th>Номер</th>
                            <th>Производитель</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody id="softwareInAsutpBody">
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8;">
                                ПО не добавлено
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-attestation')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-structural')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 5: Структурные элементы -->
        <div id="tab-structural" class="tab-content">
            <div class="section-header" style="margin-bottom: 20px;">
                <h3 style="color: #1e293b;">Структурные элементы</h3>
            </div>
            
            <div class="toolbar" style="margin-bottom: 20px;">
                <div class="toolbar-left">
                    <button type="button" class="btn btn-primary" onclick="openStructuralElementModal()">
                        <i class="fas fa-plus"></i> Добавить
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="structuralElementSearch" placeholder="Поиск..." oninput="filterStructuralElements()" />
                    </div>
                </div>
            </div>
            
            <div class="table-container">
                <table class="data-table" id="structuralElementsTable">
                    <thead>
                        <tr>
                            <th>Структурный элемент</th>
                            <th>Краткое описание</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody id="structuralElementsBody">
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 40px; color: #94a3b8;">
                                Структурные элементы не добавлены
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-software')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-users')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 6: Группы пользователей -->
        <div id="tab-users" class="tab-content">
            <div class="section-header" style="margin-bottom: 20px;">
                <h3 style="color: #1e293b;">Группы пользователей</h3>
            </div>
            
            <div class="toolbar" style="margin-bottom: 20px;">
                <div class="toolbar-left">
                    <button type="button" class="btn btn-primary" onclick="openUserGroupModal()">
                        <i class="fas fa-plus"></i> Добавить
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="userGroupSearch" placeholder="Поиск..." oninput="filterUserGroups()" />
                    </div>
                </div>
            </div>
            
            <div class="table-container">
                <table class="data-table" id="userGroupsTable">
                    <thead>
                        <tr>
                            <th>Пользователь</th>
                            <th>Краткое описание</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody id="userGroupsBody">
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 40px; color: #94a3b8;">
                                Группы пользователей не добавлены
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-structural')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-schemes')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 7: Схемы -->
        <div id="tab-schemes" class="tab-content">
            <div class="section-header" style="margin-bottom: 20px;">
                <h3 style="color: #1e293b;">Схемы работы системы</h3>
            </div>
            
            <div class="toolbar" style="margin-bottom: 20px;">
                <div class="toolbar-left">
                    <button type="button" class="btn btn-primary" onclick="openSchemeModal()">
                        <i class="fas fa-plus"></i> Добавить
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="schemeSearch" placeholder="Поиск..." oninput="filterSchemes()" />
                    </div>
                </div>
            </div>
            
            <div class="table-container">
                <table class="data-table" id="schemesTable">
                    <thead>
                        <tr>
                            <th>Вид</th>
                            <th>Схема</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody id="schemesBody">
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 40px; color: #94a3b8;">
                                Схемы не добавлены
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-users')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-documents')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 8: Документы -->
        <div id="tab-documents" class="tab-content">
            <div class="section-header" style="margin-bottom: 20px;">
                <h3 style="color: #1e293b;">Основные документы на систему</h3>
            </div>
            
            <div class="toolbar" style="margin-bottom: 20px;">
                <div class="toolbar-left">
                    <button type="button" class="btn btn-primary" onclick="openDocumentModal()">
                        <i class="fas fa-plus"></i> Добавить
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="documentSearch" placeholder="Поиск..." oninput="filterDocuments()" />
                    </div>
                </div>
            </div>
            
            <div class="table-container">
                <table class="data-table" id="documentsTable">
                    <thead>
                        <tr>
                            <th>Наименование документа</th>
                            <th>Статус</th>
                            <th>Сформирован/загружен</th>
                            <th style="width: 150px;"></th>
                        </tr>
                    </thead>
                    <tbody id="documentsBody">
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 40px; color: #94a3b8;">
                                Документы не добавлены
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-schemes')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="submit" class="btn btn-primary" form="asutpForm"><i class="fas fa-save"></i> Сохранить АСУ ТП</button>
            </div>
        </div>

        <!-- ✅ МОДАЛЬНОЕ ОКНО ВЫБОРА ПО -->
        <div class="modal" id="softwareSelectionModal">
            <div class="modal-content" style="max-width: 700px;">
                <div class="modal-header">
                    <h3>Список ПО</h3>
                    <button type="button" class="modal-close" onclick="closeSoftwareSelectionModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="toolbar" style="margin-bottom: 16px;">
                        <button type="button" class="btn btn-primary" onclick="openAddSoftwareFromModal()">
                            <i class="fas fa-plus"></i> Добавить ПО
                        </button>
                        <div class="search-box" style="flex: 1;">
                            <i class="fas fa-search"></i>
                            <input type="text" id="softwareListSearch" placeholder="Поиск..." oninput="filterSoftwareList()" />
                        </div>
                    </div>
                    
                    <div style="max-height: 400px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
                        <div id="softwareListContainer">
                            <!-- Здесь будет список ПО с чекбоксами -->
                        </div>
                    </div>
                    
                    <div class="form-actions" style="margin-top: 16px; justify-content: flex-end;">
                        <button type="button" class="btn btn-secondary" onclick="closeSoftwareSelectionModal()">Отмена</button>
                        <button type="button" class="btn btn-primary" onclick="saveSelectedSoftware()">Сохранить</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ✅ МОДАЛЬНОЕ ОКНО ДОБАВЛЕНИЯ ПО -->
        <div class="modal" id="addSoftwareModal">
            <div class="modal-content" style="max-width: 600px;">
                <div class="modal-header">
                    <h3>Добавление ПО</h3>
                    <button type="button" class="modal-close" onclick="closeAddSoftwareModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <form id="addSoftwareForm" onsubmit="saveNewSoftware(event)">
                        <div class="form-group">
                            <label>Наименование <span class="required">*</span></label>
                            <input type="text" id="newSoftwareName" class="form-control" required placeholder="Введите наименование ПО" />
                        </div>
                        <div class="form-group">
                            <label>Номер</label>
                            <input type="text" id="newSoftwareNumber" class="form-control" placeholder="Введите номер версии" />
                        </div>
                        <div class="form-group">
                            <label>Производитель</label>
                            <input type="text" id="newSoftwareManufacturer" class="form-control" placeholder="Введите производителя" />
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary" onclick="closeAddSoftwareModal()">Отмена</button>
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ✅ МОДАЛЬНОЕ ОКНО СТРУКТУРНОГО ЭЛЕМЕНТА -->
