    function openSchemeModal() {
        document.getElementById('schemeForm').reset();
        document.getElementById('schemeId').value = '';
        document.getElementById('schemeType').value = '';
        currentSchemeFile = null;
        document.getElementById('schemeFileName').style.display = 'none';
        document.getElementById('schemeModal').classList.add('show');
    }

    function closeSchemeModal() {
        document.getElementById('schemeModal').classList.remove('show');
    }

    function handleSchemeDragOver(e) {
        e.preventDefault();
        e.currentTarget.classList.add('drag-over');
    }

    function handleSchemeDragLeave(e) {
        e.currentTarget.classList.remove('drag-over');
    }

    function handleSchemeDrop(e) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-over');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            document.getElementById('schemeFile').files = files;
            handleSchemeFileSelect({ target: { files: files } });
        }
    }

    function handleSchemeFileSelect(e) {
        const file = e.target.files[0];
        if (file) {
            currentSchemeFile = file;
            document.getElementById('schemeFileNameText').textContent = file.name;
            document.getElementById('schemeFileName').style.display = 'block';
        }
    }

    function saveScheme(e) {
        e.preventDefault();
        const id = document.getElementById('schemeId').value || Date.now().toString();
        const scheme = {
            id: id,
            type: document.getElementById('schemeType').value,
            fileName: currentSchemeFile ? currentSchemeFile.name : 'scheme.png',
            file: currentSchemeFile
        };
        const existingIndex = schemes.findIndex(s => s.id === id);
        if (existingIndex >= 0) {
            schemes[existingIndex] = scheme;
        } else {
            schemes.push(scheme);
        }
        closeSchemeModal();
        renderSchemes();
    }

    function renderSchemes() {
        const tbody = document.getElementById('schemesBody');
        if (schemes.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 40px; color: #94a3b8;">Схемы не добавлены</td></tr>';
            return;
        }
        let html = '';
        schemes.forEach(scheme => {
            html += `
                <tr>
                    <td><strong>${scheme.type}</strong></td>
                    <td><i class="fas fa-image" style="color: #4F46E5;"></i> ${scheme.fileName}</td>
                    <td class="actions">
                        <button class="btn-icon edit" title="Редактировать" onclick="editScheme('${scheme.id}')"><i class="fas fa-edit"></i></button>
                        <button class="btn-icon delete" title="Удалить" onclick="deleteScheme('${scheme.id}')"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
    }

    function editScheme(id) {
        const scheme = schemes.find(s => s.id === id);
        if (!scheme) return;
        document.getElementById('schemeId').value = scheme.id;
        document.getElementById('schemeType').value = scheme.type || '';
        if (scheme.fileName) {
            document.getElementById('schemeFileNameText').textContent = scheme.fileName;
            document.getElementById('schemeFileName').style.display = 'block';
        }
        document.getElementById('schemeModal').classList.add('show');
