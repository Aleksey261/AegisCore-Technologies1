@model AegisCore.Models.InfrastructureViewModel
@{
    ViewData["Title"] = "Информационные системы";
}

@if (ViewBag.ShowCreateModal == true)
{
    <!-- ============================================================ -->
    <!-- НОВАЯ ВКЛАДКА: ДОБАВЛЕНИЕ ИНФОРМАЦИОННОЙ СИСТЕМЫ (Рисунок 68) -->
    <!-- ============================================================ -->
    
    <div class="section-header">
        <h2 class="section-title">
            <i class="fas fa-desktop"></i> Информационные системы
        </h2>
        <div class="header-info">
            <i class="fas fa-info-circle" title="Учёт ИС"></i>
            <span style="color: #64748b; font-size: 14px;">Согласно текущему законодательству РФ необходимо вести учет всех информационных систем организации.</span>
        </div>
    </div>

    <!-- ✅ ДОБАВЛЕН TOOLBAR -->
    <div class="toolbar">
        <div class="toolbar-left">
            <a href="/audit/infrastructure?section=info-systems" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Назад к списку
            </a>
        </div>
    </div>

    <div class="tabs-nav" style="margin-bottom: 20px;">
        <a href="#tab-basic" class="tab-nav-item active" onclick="switchTab(event, 'tab-basic')">
            <i class="fas fa-info-circle"></i> Основные сведения
        </a>
        <a href="#tab-classification" class="tab-nav-item" onclick="switchTab(event, 'tab-classification')">
            <i class="fas fa-layer-group"></i> Классификация ИС
        </a>
        <a href="#tab-attestation" class="tab-nav-item" onclick="switchTab(event, 'tab-attestation')">
            <i class="fas fa-certificate"></i> Аттестация
        </a>
        <a href="#tab-database" class="tab-nav-item" onclick="switchTab(event, 'tab-database')">
            <i class="fas fa-database"></i> БД и ЦОД
        </a>
        <a href="#tab-software" class="tab-nav-item" onclick="switchTab(event, 'tab-software')">
            <i class="fas fa-laptop-code"></i> Перечень ПО в ИС
        </a>
        <a href="#tab-structural" class="tab-nav-item" onclick="switchTab(event, 'tab-structural')">
            <i class="fas fa-sitemap"></i> Структурные элементы
        </a>
        <a href="#tab-users" class="tab-nav-item" onclick="switchTab(event, 'tab-users')">
            <i class="fas fa-users"></i> Группы пользователей
        </a>
        <a href="#tab-schemes" class="tab-nav-item" onclick="switchTab(event, 'tab-schemes')">
            <i class="fas fa-project-diagram"></i> Схемы
        </a>
        <a href="#tab-documents" class="tab-nav-item" onclick="switchTab(event, 'tab-documents')">
            <i class="fas fa-file-alt"></i> Документы
        </a>
    </div>

    <form id="infoSystemForm" onsubmit="saveInfoSystem(event)">
        <input type="hidden" id="infoSystemId" name="id" />

        <!-- Вкладка 1: Основные сведения (Рисунок 68) -->
        <div id="tab-basic" class="tab-content active">
            <h3 style="margin-bottom: 20px; color: #1e293b;">Основные сведения</h3>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Наименование <span class="required">*</span></label>
                    <input type="text" name="name" id="infoSystemName" class="form-control" required placeholder="Введите наименование ИС" />
                </div>
                <div class="form-group">
                    <label>Тип <span class="required">*</span></label>
                    <select name="type" id="infoSystemType" class="form-control" required>
                        <option value="">Выбрать...</option>
                        <option value="ГИС/МИС.ИСПДн">ГИС/МИС.ИСПДн</option>
                        <option value="ИСПДн">ИСПДн</option>
                        <option value="ГИС">ГИС</option>
                        <option value="КИИ">КИИ</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Роль</label>
                    <select name="role" id="infoSystemRole" class="form-control">
                        <option value="">Выбрать...</option>
                        <option value="Основная">Основная</option>
                        <option value="Вспомогательная">Вспомогательная</option>
                        <option value="Тестовая">Тестовая</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Обладатель информации</label>
                    <div class="input-with-buttons">
                        <select name="informationOwner" id="infoSystemInformationOwner" class="form-control">
                            <option value="">Выбрать...</option>
                            @if (Model.Organizations != null)
                            {
                                @foreach (var org in Model.Organizations)
                                {
                                    <option value="@org.Name">@org.Name</option>
                                }
                            }
                        </select>
                        <button type="button" class="btn-icon-ref" title="Редактировать" onclick="editReference('organizations')">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button type="button" class="btn-icon-ref add" title="Добавить" onclick="openOrganizationModal()">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="form-group">
                    <label>Дата ввода в эксплуатацию</label>
                    <input type="date" name="createdAt" id="infoSystemCreatedAt" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Назначение <span class="required">*</span></label>
                <textarea name="purpose" id="infoSystemPurpose" class="form-control" rows="3" required placeholder="Опишите назначение системы"></textarea>
            </div>

            <div class="form-group">
                <label>Цели</label>
                <textarea name="goals" id="infoSystemGoals" class="form-control" rows="3" placeholder="Опишите цели системы"></textarea>
            </div>

            <div class="form-group">
                <label>Задачи</label>
                <textarea name="tasks" id="infoSystemTasks" class="form-control" rows="3" placeholder="Опишите задачи системы"></textarea>
            </div>

            <div class="form-group">
                <label>Обрабатываемые сведения</label>
                <textarea name="processedData" id="infoSystemProcessedData" class="form-control" rows="3" placeholder="Опишите обрабатываемые сведения"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Вид информации</label>
                    <select name="informationType" id="infoSystemInformationType" class="form-control">
                        <option value="">Выбрать...</option>
                        <option value="Персональные данные">Персональные данные</option>
                        <option value="Конфиденциальная">Конфиденциальная</option>
                        <option value="Служебная тайна">Служебная тайна</option>
                        <option value="Открытая">Открытая</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Режимы обработки данных</label>
                    <select name="processingModes" id="infoSystemProcessingModes" class="form-control">
                        <option value="">Выбрать...</option>
                        <option value="Автоматизированный">Автоматизированный</option>
                        <option value="Автоматический">Автоматический</option>
                        <option value="Ручной">Ручной</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Взаимодействие с другими системами</label>
                <textarea name="systemInteraction" id="infoSystemSystemInteraction" class="form-control" rows="3" placeholder="Опишите взаимодействие с другими системами"></textarea>
            </div>

            <div class="form-group">
                <label>Характеристики безопасности</label>
                <select name="securityCharacteristics" id="infoSystemSecurityCharacteristics" class="form-control">
                    <option value="">Выбрать...</option>
                    <option value="Высокий">Высокий</option>
                    <option value="Средний">Средний</option>
                    <option value="Низкий">Низкий</option>
                </select>
            </div>

            <div class="form-group">
                <label>Используемые СКЗИ</label>
                <div class="input-with-buttons">
                    <select name="usedSkzi" id="infoSystemUsedSkzi" class="form-control">
                        <option value="">Выбрать...</option>
                        @if (Model.SkziNames != null)
                        {
                            @foreach (var skzi in Model.SkziNames)
                            {
                                <option value="@skzi">@skzi</option>
                            }
                        }
                    </select>
                    <button type="button" class="btn-icon-ref" title="Редактировать" onclick="editReference('skzi')">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="btn-icon-ref add" title="Добавить" onclick="openReferenceModal('skzi')">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
            </div>

            <div class="form-actions">
                <a href="/audit/infrastructure?section=info-systems" class="btn btn-secondary">Отмена</a>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-classification')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 2: Классификация ИС (Рисунок 69) -->
        <div id="tab-classification" class="tab-content">
            <h3 style="margin-bottom: 20px; color: #1e293b;">Классификация информационной системы</h3>
            
            <div style="background: #f8fafc; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                <h4 style="margin-bottom: 12px; color: #475569;">Классификация защищенности ИС</h4>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Уровень значимости информации <span class="required">*</span></label>
                        <select name="significanceLevel" id="infoSystemSignificanceLevel" class="form-control" required onchange="calculateSecurityClass()">
                            <option value="">Выбрать...</option>
                            <option value="Значимая">Значимая</option>
                            <option value="Незначимая">Незначимая</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Масштаб <span class="required">*</span></label>
                        <select name="scale" id="infoSystemScale" class="form-control" required onchange="calculateSecurityClass()">
                            <option value="">Выбрать...</option>
                            <option value="Федеральный">Федеральный</option>
                            <option value="Региональный">Региональный</option>
                            <option value="Муниципальный">Муниципальный</option>
                            <option value="Локальный">Локальный</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Класс защищенности</label>
                        <input type="text" id="calculatedSecurityClass" class="form-control" readonly placeholder="Определяется автоматически" />
                        <input type="hidden" name="securityClass" id="infoSystemSecurityClass" />
                    </div>
                    <div class="form-group">
                        <label>Дата</label>
                        <input type="date" id="securityClassDate" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Номер акта</label>
                    <input type="text" id="securityClassActNumber" class="form-control" placeholder="Введите номер акта" />
                </div>
            </div>

            <div style="background: #f8fafc; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                <h4 style="margin-bottom: 12px; color: #475569;">Уровень защищенности ПДн</h4>
                
                <div class="form-row">
                    <div class="form-group">
                        <label>Категория ПДн <span class="required">*</span></label>
                        <select name="dataCategory" id="infoSystemDataCategory" class="form-control" required onchange="calculateSecurityLevel()">
                            <option value="">Выбрать...</option>
                            <option value="Общедоступные">Общедоступные</option>
                            <option value="Биометрические">Биометрические</option>
                            <option value="Специальные">Специальные</option>
                            <option value="Иные">Иные</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Категория субъектов <span class="required">*</span></label>
                        <select name="processingType" id="infoSystemProcessingType" class="form-control" required onchange="calculateSecurityLevel()">
                            <option value="">Выбрать...</option>
                            <option value="Сотрудники">Сотрудники</option>
                            <option value="Клиенты">Клиенты</option>
                            <option value="Партнеры">Партнеры</option>
                            <option value="Иные">Иные</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Тип угроз <span class="required">*</span></label>
                        <select name="threatType" id="infoSystemThreatType" class="form-control" required onchange="calculateSecurityLevel()">
                            <option value="">Выбрать...</option>
                            <option value="Актуальные">Актуальные</option>
                            <option value="Неактуальные">Неактуальные</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Количество субъектов <span class="required">*</span></label>
                        <input type="number" name="subjectsCount" id="infoSystemSubjectsCount" class="form-control" required min="0" onchange="calculateSecurityLevel()" placeholder="0" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Уровень защищенности</label>
                        <input type="text" id="calculatedSecurityLevel" class="form-control" readonly placeholder="Определяется автоматически" />
                        <input type="hidden" name="securityLevel" id="infoSystemSecurityLevel" />
                    </div>
                    <div class="form-group">
                        <label>Дата</label>
                        <input type="date" id="securityLevelDate" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Номер акта</label>
                    <input type="text" id="securityLevelActNumber" class="form-control" placeholder="Введите номер акта" />
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-basic')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-attestation')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 3: Аттестация (Рисунок 70) -->
        <div id="tab-attestation" class="tab-content">
            <h3 style="margin-bottom: 20px; color: #1e293b;">Сведения о соответствии требованиям по защите информации</h3>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Дата протокола аттестационных испытаний</label>
                    <input type="date" name="protocolDate" id="infoSystemProtocolDate" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Номер протокола аттестационных испытаний</label>
                    <input type="text" name="protocolNumber" id="infoSystemProtocolNumber" class="form-control" placeholder="Введите номер протокола" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Дата заключения аттестационных испытаний</label>
                    <input type="date" name="conclusionDate" id="infoSystemConclusionDate" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Номер заключения аттестационных испытаний</label>
                    <input type="text" name="conclusionNumber" id="infoSystemConclusionNumber" class="form-control" placeholder="Введите номер заключения" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Дата аттестата соответствия</label>
                    <input type="date" name="certificateDate" id="infoSystemCertificateDate" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Номер аттестата соответствия</label>
                    <input type="text" name="certificateNumber" id="infoSystemCertificateNumber" class="form-control" placeholder="Введите номер аттестата" />
                </div>
            </div>

            <div class="form-group">
                <label>Статус соответствия</label>
                <select name="complianceStatus" id="infoSystemComplianceStatus" class="form-control">
                    <option value="">Выбрать...</option>
                    <option value="Соответствует">Соответствует</option>
                    <option value="Не соответствует">Не соответствует</option>
                    <option value="Требует доработки">Требует доработки</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-classification')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-database')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 4: БД и ЦОД (Рисунок 71-72) -->
        <div id="tab-database" class="tab-content">
            <h3 style="margin-bottom: 20px; color: #1e293b;">База данных и ЦОДы</h3>
            
            <div id="databaseLocationsList">
                <!-- Здесь будет динамический список БД и ЦОД -->
            </div>

            <button type="button" class="btn btn-secondary" onclick="addDatabaseLocation()" style="margin-bottom: 20px;">
                <i class="fas fa-plus"></i> Добавить БД/ЦОД
            </button>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-attestation')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-software')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Вкладка 5: Перечень ПО в ИС (Рисунок 73-74) -->
        <div id="tab-software" class="tab-content">
            <div class="section-header" style="margin-bottom: 20px;">
                <h3 style="color: #1e293b;">Перечень ПО входящих в состав ИС</h3>
            </div>
            
            <div class="toolbar" style="margin-bottom: 20px;">
                <div class="toolbar-left">
                    <button type="button" class="btn btn-primary" onclick="openSoftwareSelectionModal()">
                        <i class="fas fa-plus"></i> Добавить
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="softwareInSystemSearch" placeholder="Поиск..." oninput="filterSoftwareInSystem()" />
                    </div>
                </div>
            </div>
            
            <div class="table-container">
                <table class="data-table" id="softwareInSystemTable">
                    <thead>
                        <tr>
                            <th style="width: 40px;"><input type="checkbox" id="selectAllSoftwareInSystem" onchange="toggleSelectAllSoftwareInSystem()" /></th>
                            <th>Наименование</th>
                            <th>Номер</th>
                            <th>Производитель</th>
                            <th style="width: 100px;"></th>
                        </tr>
                    </thead>
                    <tbody id="softwareInSystemBody">
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8;">
                                ПО не добавлено
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="switchToTab('tab-database')"><i class="fas fa-arrow-left"></i> Назад</button>
                <button type="button" class="btn btn-primary" onclick="switchToTab('tab-structural')">Далее <i class="fas fa-arrow-right"></i></button>
            </div>
        </div>

        <!-- Модальное окно выбора ПО (Рисунок 74) -->
        <div class="modal" id="softwareSelectionModal">
            <div class="modal-content" style="max-width: 700px;">
                <div class="modal-header">
                    <h3>Список ПО</h3>
                    <button type="button" class="modal-close" onclick="closeSoftwareSelectionModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="toolbar" style="margin-bottom: 16px;">
                        <button type="button" class="btn btn-primary" onclick="openAddSoftwareFromModal()">
                            <i class="fas fa-plus"></i> Добавить ПО
                        </button>
                        <div class="search-box" style="flex: 1;">
                            <i class="fas fa-search"></i>
                            <input type="text" id="softwareListSearch" placeholder="Поиск..." oninput="filterSoftwareList()" />
                        </div>
                    </div>
                    
                    <div style="max-height: 400px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
                        <div id="softwareListContainer">
                            <!-- Здесь будет список ПО с чекбоксами -->
                        </div>
                    </div>
                    
                    <div class="form-actions" style="margin-top: 16px; justify-content: flex-end;">
                        <button type="button" class="btn btn-secondary" onclick="closeSoftwareSelectionModal()">Отмена</button>
                        <button type="button" class="btn btn-primary" onclick="saveSelectedSoftware()">Сохранить</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно добавления ПО -->
        <div class="modal" id="addSoftwareModal">
            <div class="modal-content" style="max-width: 600px;">
                <div class="modal-header">
                    <h3>Добавление ПО</h3>
                    <button type="button" class="modal-close" onclick="closeAddSoftwareModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <form id="addSoftwareForm" onsubmit="saveNewSoftware(event)">
                        <div class="form-group">
                            <label>Наименование <span class="required">*</span></label>
                            <input type="text" id="newSoftwareName" class="form-control" required placeholder="Введите наименование ПО" />
                        </div>
                        <div class="form-group">
                            <label>Номер</label>
                            <input type="text" id="newSoftwareNumber" class="form-control" placeholder="Введите номер версии" />
                        </div>
                        <div class="form-group">
                            <label>Производитель</label>
                            <input type="text" id="newSoftwareManufacturer" class="form-control" placeholder="Введите производителя" />
                        </div>
                        <div class="form-actions">
                            <button type="button" class="btn btn-secondary" onclick="closeAddSoftwareModal()">Отмена</button>
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Вкладка 6: Структурные элементы (Рисунок 75-76) -->
        <div id="tab-structural" class="tab-content">
            <div class="section-header" style="margin-bottom: 20px;">
                <h3 style="color: #1e293b;">Структурные элементы</h3>
            </div>
            
            <div class="toolbar" style="margin-bottom: 20px;">
                <div class="toolbar-left">
                    <button type="button" class="btn btn-primary" onclick="openStructuralElementModal()">
                        <i class="fas fa-plus"></i> Добавить
                    </button>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="structuralElementSearch" placeholder="Поиск..." oninput="filterStructuralElements()" />
                    </div>
                </div>
            </div>
            
            <div class="table-container">
                <table class="data-table" id="structuralElementsTable">
                    <thead>
                        <tr>
                            <th>Структурный элемент</th>
