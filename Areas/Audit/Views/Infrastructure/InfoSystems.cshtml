        document.getElementById('structuralElementModal').classList.add('show');
    }

    function closeStructuralElementModal() {
        document.getElementById('structuralElementModal').classList.remove('show');
    }

    function editStructuralElement(id) {
        const element = structuralElements.find(e => e.id === id);
        if (!element) return;
        document.getElementById('structuralElementId').value = element.id;
        document.getElementById('structuralElementType').value = element.type || '';
        document.getElementById('structuralElementDescription').value = element.description || '';
        document.getElementById('structuralElementInteraction').value = element.interaction || '';
        document.getElementById('structuralElementModalTitle').textContent = 'Редактирование';
        document.getElementById('structuralElementModal').classList.add('show');
    }

    function saveStructuralElement(e) {
        e.preventDefault();
        const id = document.getElementById('structuralElementId').value || Date.now().toString();
        const element = {
            id: id,
            type: document.getElementById('structuralElementType').value,
            description: document.getElementById('structuralElementDescription').value,
            interaction: document.getElementById('structuralElementInteraction').value
        };
        const existingIndex = structuralElements.findIndex(e => e.id === id);
        if (existingIndex >= 0) {
            structuralElements[existingIndex] = element;
        } else {
            structuralElements.push(element);
        }
        closeStructuralElementModal();
        renderStructuralElements();
    }

    function renderStructuralElements() {
        const tbody = document.getElementById('structuralElementsBody');
        if (structuralElements.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; padding: 40px; color: #94a3b8;">Структурные элементы не добавлены</td></tr>';
            return;
