else
{
    <!-- ============================================================ -->
    <!-- СПИСОК ИНФОРМАЦИОННЫХ СИСТЕМ (Рисунок 1) -->
    <!-- ============================================================ -->
    
    <div class="section-header">
        <h2 class="section-title">
            <i class="fas fa-desktop"></i> Информационные системы
        </h2>
        <div class="header-info">
            <i class="fas fa-info-circle" title="Учёт ИС"></i>
            <span style="color: #64748b; font-size: 14px;">Согласно текущему законодательству РФ необходимо вести учет всех информационных систем организации.</span>
        </div>
    </div>

    <!-- TOOLBAR с кнопкой "Добавить" и общим поиском -->
    <div class="toolbar">
        <div class="toolbar-left">
            <a href="/audit/infrastructure/create-info-system" class="btn btn-primary">
                <i class="fas fa-plus"></i> Добавить
            </a>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="infoSystemSearch" placeholder="Поиск по информационным системам..." value="@Model.Search" oninput="filterInfoSystems()" />
            </div>
        </div>
    </div>

    <!-- ТАБЛИЦА с двумя колонками: Наименование и Номер -->
    <div class="table-container">
        <table class="data-table" id="infoSystemsTable">
            <thead>
                <tr>
                    <th class="th-sortable" onclick="sortTable('infoSystemsTable', 0)">
                        <div class="th-header">
                            <span>Наименование</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('infoSystemsTable', 0, this.value)" />
                        </div>
                    </th>
                    <th class="th-sortable" onclick="sortTable('infoSystemsTable', 1)">
                        <div class="th-header">
                            <span>Тип</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('infoSystemsTable', 1, this.value)" />
                        </div>
                    </th>
                    <th class="th-sortable" onclick="sortTable('infoSystemsTable', 2)">
                        <div class="th-header">
                            <span>Номер</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('infoSystemsTable', 2, this.value)" />
                        </div>
                    </th>
                    <th class="th-sortable" onclick="sortTable('infoSystemsTable', 3)">
                        <div class="th-header">
                            <span>Класс защищенности ИС</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('infoSystemsTable', 3, this.value)" />
                        </div>
                    </th>
                    <th class="th-sortable" onclick="sortTable('infoSystemsTable', 4)">
                        <div class="th-header">
                            <span>Класс защищенности ПДн</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('infoSystemsTable', 4, this.value)" />
                        </div>
                    </th>
                    <th style="width: 100px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.InfoSystems != null && Model.InfoSystems.Any())
                {
                    @foreach (var item in Model.InfoSystems)
                    {
                        <tr data-id="@item.Id">
                            <td><strong>@item.Name</strong></td>
                            <td>@(item.Type ?? "—")</td>
                            <td>@(item.RegistrationNumber ?? "—")</td>
                            <td><span class="badge warning">@(item.SecurityClass ?? "—")</span></td>
                            <td><span class="badge success">@(item.SecurityLevel ?? "—")</span></td>
                            <td class="actions">
                                <button class="btn-icon edit" title="Редактировать" onclick="editInfoSystem('@item.Id')"><i class="fas fa-edit"></i></button>
                                <button class="btn-icon delete" title="Удалить" onclick="deleteInfoSystem('@item.Id')"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 60px 40px; color: #94a3b8;">
                            <i class="fas fa-desktop" style="font-size: 64px; margin-bottom: 16px; display: block; color: #cbd5e1;"></i>
                            <div style="font-size: 16px; font-weight: 500;">Информационные системы не добавлены</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            <div class="pagination-page-size">
                <label>Показывать по:</label>
                <select onchange="changePageSize(this.value)"><option value="10" selected>10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option></select>
            </div>
            <div class="pagination-info">Страница @Model.CurrentPage из @Model.TotalPages (Всего элементов: @Model.TotalItems)</div>
            <div class="pagination-buttons">
                @if (Model.CurrentPage > 1) { <a href="/audit/infrastructure?section=info-systems&page=@(Model.CurrentPage - 1)" class="btn-pagination">‹</a> }
                @for (int i = 1; i <= Model.TotalPages; i++) { <a href="/audit/infrastructure?section=info-systems&page=@i" class="btn-pagination @(i == Model.CurrentPage ? "active" : "")">@i</a> }
                @if (Model.CurrentPage < Model.TotalPages) { <a href="/audit/infrastructure?section=info-systems&page=@(Model.CurrentPage + 1)" class="btn-pagination">›</a> }
            </div>
        </div>
    }
}

