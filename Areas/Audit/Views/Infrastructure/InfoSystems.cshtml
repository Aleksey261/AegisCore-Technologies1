        const container = document.getElementById('databaseLocationsList');
        const index = container.children.length;
        const div = document.createElement('div');
        div.className = 'database-location-item';
        div.style.cssText = 'background: #f8fafc; padding: 16px; border-radius: 8px; margin-bottom: 12px; border: 1px solid #e2e8f0;';
