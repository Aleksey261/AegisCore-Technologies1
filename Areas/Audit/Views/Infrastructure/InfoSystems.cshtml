    function renderSoftwareInSystem() {
        const tbody = document.getElementById('softwareInSystemBody');
        if (selectedSoftwareIds.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8;">ПО не добавлено</td></tr>';
            return;
        }
        let html = '';
