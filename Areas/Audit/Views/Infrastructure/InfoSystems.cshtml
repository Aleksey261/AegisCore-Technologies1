    function openDocumentModal() {
        document.getElementById('documentForm').reset();
        document.getElementById('documentId').value = '';
        document.getElementById('documentType').value = '';
        currentDocumentFile = null;
        document.getElementById('documentFileGroup').style.display = 'none';
        document.getElementById('documentFileName').style.display = 'none';
        document.getElementById('documentModal').classList.add('show');
    }

    function closeDocumentModal() {
        document.getElementById('documentModal').classList.remove('show');
    }

    function handleDocumentTypeChange() {
        const type = document.getElementById('documentType').value;
        const fileGroup = document.getElementById('documentFileGroup');
        const requiresFile = type.includes('Техническое задание') || 
                            type.includes('Технический проект') || 
                            type.includes('Описание технологического') ||
                            type.includes('Разрешительная система') ||
                            type.includes('Модель угроз');
        fileGroup.style.display = requiresFile ? 'block' : 'none';
    }

    function handleDocumentDragOver(e) {
        e.preventDefault();
        e.currentTarget.classList.add('drag-over');
    }

    function handleDocumentDragLeave(e) {
        e.currentTarget.classList.remove('drag-over');
    }

    function handleDocumentDrop(e) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-over');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            document.getElementById('documentFile').files = files;
            handleDocumentFileSelect({ target: { files: files } });
        }
    }

    function handleDocumentFileSelect(e) {
        const file = e.target.files[0];
        if (file) {
            currentDocumentFile = file;
            document.getElementById('documentFileNameText').textContent = file.name;
            document.getElementById('documentFileName').style.display = 'block';
        }
    }

    function saveDocument(e) {
        e.preventDefault();
        const id = document.getElementById('documentId').value || Date.now().toString();
        const type = document.getElementById('documentType').value;
        const isMainDocument = type.includes('Технический паспорт') || 
                              type.includes('Приказ на ввод') || 
                              type.includes('Акт классификации') ||
                              type.includes('Акт определения');
        const doc = {
            id: id,
            type: type,
            status: isMainDocument ? 'Не сформирован' : (currentDocumentFile ? 'Загружен' : 'Не загружен'),
            fileName: currentDocumentFile ? currentDocumentFile.name : null,
            file: currentDocumentFile,
            isMainDocument: isMainDocument
        };
        const existingIndex = documents.findIndex(d => d.id === id);
        if (existingIndex >= 0) {
            documents[existingIndex] = doc;
        } else {
            documents.push(doc);
        }
        closeDocumentModal();
        renderDocuments();
    }

    function renderDocuments() {
        const tbody = document.getElementById('documentsBody');
        if (documents.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 40px; color: #94a3b8;">Документы не добавлены</td></tr>';
            return;
        }
        let html = '';
        documents.forEach(doc => {
            let statusBadge = '';
            if (doc.status === 'Сформирован' || doc.status === 'Загружен') {
                statusBadge = '<span class="badge success">' + doc.status + '</span>';
            } else {
                statusBadge = '<span class="badge warning">' + doc.status + '</span>';
            }
            let actions = '';
            if (doc.isMainDocument) {
                if (doc.status === 'Не сформирован') {
                    actions = `<button class="btn-icon edit" title="Сформировать" onclick="generateDocument('${doc.id}')"><i class="fas fa-file-alt"></i></button>`;
                } else {
                    actions = `
                        <button class="btn-icon edit" title="Переформировать" onclick="confirmRegenerate('${doc.id}')"><i class="fas fa-sync-alt"></i></button>
                        <button class="btn-icon" title="Скачать" onclick="downloadDocument('${doc.id}')"><i class="fas fa-download"></i></button>
                    `;
                }
            } else {
                actions = `<button class="btn-icon edit" title="Загрузить" onclick="uploadApprovedDocument('${doc.id}')"><i class="fas fa-upload"></i></button>`;
            }
            html += `
                <tr>
                    <td><strong>${doc.type}</strong></td>
                    <td>${statusBadge}</td>
                    <td>${doc.fileName || '—'}</td>
                    <td class="actions">
                        ${actions}
                        <button class="btn-icon delete" title="Удалить" onclick="deleteDocument('${doc.id}')"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
    }

    function generateDocument(id) {
        const doc = documents.find(d => d.id === id);
        if (!doc) return;
        doc.status = 'Сформирован';
        doc.fileName = doc.type.replace(/\s+/g, '_') + '.pdf';
        alert('Документ "' + doc.type + '" сформирован. Скачайте его, распечатайте, подпишите и загрузите утвержденную версию.');
        renderDocuments();
    }

    function confirmRegenerate(id) {
        documentToRegenerate = id;
        document.getElementById('confirmRegenerateModal').classList.add('show');
    }

    function closeConfirmRegenerateModal() {
        document.getElementById('confirmRegenerateModal').classList.remove('show');
        documentToRegenerate = null;
    }

    function confirmRegenerateDocument() {
        if (documentToRegenerate) {
            generateDocument(documentToRegenerate);
            closeConfirmRegenerateModal();
        }
    }

    function downloadDocument(id) {
        const doc = documents.find(d => d.id === id);
        if (!doc) return;
        alert('Скачивание документа: ' + doc.fileName);
    }

    function uploadApprovedDocument(id) {
        const doc = documents.find(d => d.id === id);
        if (!doc) return;
        document.getElementById('documentId').value = id;
        document.getElementById('documentType').value = doc.type;
        document.getElementById('documentFileGroup').style.display = 'block';
        handleDocumentTypeChange();
        document.getElementById('documentModal').classList.add('show');
    }

    function deleteDocument(id) {
        if (!confirm('Удалить документ?')) return;
        documents = documents.filter(d => d.id !== id);
        renderDocuments();
    }

    function filterDocuments() {
        const search = document.getElementById('documentSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#documentsTable tbody tr');
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(search) ? '' : 'none';
        });
    }

    function editInfoSystem(id) {
        const item = infoSystemsData.find(s => s.id === id);
        if (!item) return;
        window.location.href = '/audit/infrastructure/create-info-system?edit=' + id;
    }

    function deleteInfoSystem(id) {
        if (!confirm('Удалить информационную систему?')) return;
        fetch('/audit/infrastructure/info-systems/delete/' + id, { method: 'DELETE' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Ошибка при удалении');
                }
            });
    }

    function saveInfoSystem(e) {
        e.preventDefault();
        const form = e.target;
        const data = {
            id: form.id.value || null,
            name: form.name.value,
            type: form.type.value,
            role: form.role.value,
            purpose: form.purpose.value,
            goals: form.goals.value,
            tasks: form.tasks.value,
            createdAt: form.createdAt.value || null,
            significanceLevel: form.significanceLevel.value,
            scale: form.scale.value,
            securityClass: form.securityClass.value,
            dataCategory: form.dataCategory.value,
            processingType: form.processingType.value,
            threatType: form.threatType.value,
            subjectsCount: parseInt(form.subjectsCount.value) || 0,
            securityLevel: form.securityLevel.value,
            attestationDate: form.attestationDate.value || null,
            attestationNumber: form.attestationNumber.value,
            attestationValidUntil: form.attestationValidUntil.value || null,
            attestationBody: form.attestationBody.value,
            complianceStatus: form.complianceStatus.value
        };
        fetch('/audit/infrastructure/info-systems/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                window.location.href = '/audit/infrastructure?section=info-systems';
            } else {
                alert(result.error || 'Ошибка при сохранении');
            }
        });
    }

    function filterInfoSystems() {
        const search = document.getElementById('infoSystemSearch').value.toLowerCase();
        document.querySelectorAll('#infoSystemsTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(search) ? '' : 'none';
        });
    }

    function filterTable(tableId, colIndex, value) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const rows = table.querySelectorAll('tbody tr');
        const searchValue = value.toLowerCase();
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                const text = cell.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            }
        });
    }

    function sortTable(tableId, colIndex) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        
        // Определяем направление сортировки
        const currentDir = table.getAttribute('data-sort-dir') || 'asc';
        const newDir = currentDir === 'asc' ? 'desc' : 'asc';
        table.setAttribute('data-sort-dir', newDir);
        
        rows.sort((a, b) => {
            const aText = a.cells[colIndex]?.textContent.trim() || '';
            const bText = b.cells[colIndex]?.textContent.trim() || '';
            
            if (newDir === 'asc') {
                return aText.localeCompare(bText, 'ru');
            } else {
                return bText.localeCompare(aText, 'ru');
            }
        });
        
        rows.forEach(row => tbody.appendChild(row));
    }

    function changePageSize(size) {
        const url = new URL(window.location);
        url.searchParams.set('pageSize', size);
        window.location.href = url.toString();
    }
</script>