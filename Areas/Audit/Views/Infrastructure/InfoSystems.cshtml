            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h4 style="margin: 0; color: #475569;">БД/ЦОД #${index + 1}</h4>
                <button type="button" class="btn-icon delete" onclick="this.closest('.database-location-item').remove()">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Страна, где расположена БД <span class="required">*</span></label>
                    <select class="form-control" required>
                        <option value="">Выбрать...</option>
                        <option value="Россия">Россия</option>
                        <option value="Другая">Другая</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Адрес ЦОДа</label>
                    <input type="text" class="form-control" placeholder="Введите адрес ЦОДа" />
                </div>
            </div>
            <div class="form-group">
                <label>Собственный ЦОД</label>
                <select class="form-control">
                    <option value="">Выбрать...</option>
                    <option value="Да">Да</option>
                    <option value="Нет">Нет</option>
                </select>
