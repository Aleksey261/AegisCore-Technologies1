    function openSoftwareSelectionModal() {
        document.getElementById('softwareSelectionModal').classList.add('show');
        renderSoftwareList();
    }

    function closeSoftwareSelectionModal() {
        document.getElementById('softwareSelectionModal').classList.remove('show');
    }

    function renderSoftwareList() {
        const container = document.getElementById('softwareListContainer');
        const searchTerm = document.getElementById('softwareListSearch').value.toLowerCase();
        
        let html = `
            <div style="padding: 12px 16px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 12px; background: #f8fafc;">
                <input type="checkbox" id="selectAllSoftware" onchange="toggleSelectAllSoftware()" style="width: 18px; height: 18px; cursor: pointer;" />
                <label for="selectAllSoftware" style="flex: 1; cursor: pointer; font-weight: 500; color: #1e293b;">
                    Выбрать все
                </label>
            </div>
        `;
        
        let hasItems = false;
        availableSoftware.forEach(sw => {
            if (sw.name.toLowerCase().includes(searchTerm) || 
                (sw.version && sw.version.toLowerCase().includes(searchTerm)) ||
                (sw.manufacturer && sw.manufacturer.toLowerCase().includes(searchTerm))) {
                
                hasItems = true;
                const isChecked = selectedSoftwareIds.includes(sw.id) ? 'checked' : '';
                html += `
                    <div style="padding: 12px 16px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 12px;">
                        <input type="checkbox" id="sw_${sw.id}" value="${sw.id}" ${isChecked} onchange="toggleSoftwareSelection('${sw.id}')" style="width: 18px; height: 18px; cursor: pointer;" />
                        <label for="sw_${sw.id}" style="flex: 1; cursor: pointer; margin: 0;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="font-weight: 500; color: #1e293b;">${sw.name}</div>
                                ${sw.version ? `<div style="font-size: 13px; color: #64748b;">${sw.version}</div>` : ''}
                            </div>
                            ${sw.manufacturer ? `<div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">${sw.manufacturer}</div>` : ''}
                        </label>
                    </div>
                `;
            }
        });
        
        if (!hasItems) {
            html = '<div style="padding: 40px; text-align: center; color: #94a3b8;">ПО не найдено</div>';
        }
        
        container.innerHTML = html;
    }

    function filterSoftwareList() { renderSoftwareList(); }

    function toggleSelectAllSoftware() {
        const selectAllCheckbox = document.getElementById('selectAllSoftware');
        const checkboxes = document.querySelectorAll('#softwareListContainer input[type="checkbox"]:not(#selectAllSoftware)');
        const selectAll = selectAllCheckbox.checked;
        
        checkboxes.forEach(cb => {
            cb.checked = selectAll;
            const id = cb.value;
            if (selectAll && !selectedSoftwareIds.includes(id)) {
                selectedSoftwareIds.push(id);
            } else if (!selectAll) {
                selectedSoftwareIds = selectedSoftwareIds.filter(sid => sid !== id);
            }
        });
    }

    function toggleSoftwareSelection(id) {
        if (selectedSoftwareIds.includes(id)) {
            selectedSoftwareIds = selectedSoftwareIds.filter(sid => sid !== id);
        } else {
            selectedSoftwareIds.push(id);
        }
        
        // Обновляем состояние чекбокса "Выбрать все"
        const allCheckboxes = document.querySelectorAll('#softwareListContainer input[type="checkbox"]:not(#selectAllSoftware)');
        const checkedCheckboxes = document.querySelectorAll('#softwareListContainer input[type="checkbox"]:not(#selectAllSoftware):checked');
        const selectAllCheckbox = document.getElementById('selectAllSoftware');
        
        if (selectAllCheckbox) {
            selectAllCheckbox.checked = allCheckboxes.length > 0 && allCheckboxes.length === checkedCheckboxes.length;
        }
    }

    function saveSelectedSoftware() {
        alert(`Выбрано ПО: ${selectedSoftwareIds.length} элементов`);
        closeSoftwareSelectionModal();
        renderSoftwareInSystem();
    }

