        document.getElementById('addSoftwareModal').classList.add('show');
    }

    function closeAddSoftwareModal() {
        document.getElementById('addSoftwareModal').classList.remove('show');
    }

    function saveNewSoftware(e) {
        e.preventDefault();
        const newSoftware = {
            id: Date.now().toString(),
            name: document.getElementById('newSoftwareName').value,
            version: document.getElementById('newSoftwareNumber').value,  // Используем version для хранения номера
            manufacturer: document.getElementById('newSoftwareManufacturer').value
        };
        availableSoftware.push(newSoftware);
        closeAddSoftwareModal();
        openSoftwareSelectionModal();
        alert('ПО добавлено в список');
