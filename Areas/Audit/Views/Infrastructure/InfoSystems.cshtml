            const sw = availableSoftware.find(s => s.id === id);
            if (sw) {
                html += `
                    <tr>
                        <td><input type="checkbox" checked /></td>
                        <td><strong>${sw.name}</strong></td>
                        <td>${sw.version || '—'}</td>
                        <td>${sw.manufacturer || '—'}</td>
                        <td class="actions">
                            <button class="btn-icon edit" title="Редактировать"><i class="fas fa-edit"></i></button>
                            <button class="btn-icon delete" title="Удалить" onclick="removeSoftwareFromSystem('${id}')"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            }
        });
        tbody.innerHTML = html;
    }

    function removeSoftwareFromSystem(id) {
        selectedSoftwareIds = selectedSoftwareIds.filter(sid => sid !== id);
        renderSoftwareInSystem();
    }

    function filterSoftwareInSystem() {
        const search = document.getElementById('softwareInSystemSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#softwareInSystemTable tbody tr');
        rows.forEach(row => {
