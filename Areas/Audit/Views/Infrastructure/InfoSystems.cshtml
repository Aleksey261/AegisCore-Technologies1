        { id: '1', name: 'Astra Linux', version: '2342325', manufacturer: 'РусБИТех-Астра' },
        { id: '2', name: 'Advanced', version: '6452353635', manufacturer: '' },
        { id: '3', name: 'CRM', version: '', manufacturer: '' },
        { id: '4', name: 'Firebird', version: '', manufacturer: 'Firebird Project' },
        { id: '5', name: 'Microsoft Windows', version: '6797989', manufacturer: 'Microsoft' },
        { id: '6', name: 'SQL', version: '22', manufacturer: 'Microsoft' },
        { id: '7', name: 'AISC ЛЕД', version: '56546546', manufacturer: '' },
