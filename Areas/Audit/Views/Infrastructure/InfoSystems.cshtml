    function switchTab(event, tabId) {
        event.preventDefault();
        document.querySelectorAll('.tab-nav-item').forEach(item => item.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        event.currentTarget.classList.add('active');
        document.getElementById(tabId).classList.add('active');
    }

    function switchToTab(tabId) {
        const tabLink = document.querySelector(`a[href="#${tabId}"]`);
        if (tabLink) tabLink.click();
    }

    function calculateSecurityClass() {
        const significance = document.getElementById('infoSystemSignificanceLevel').value;
        const scale = document.getElementById('infoSystemScale').value;
        let securityClass = '';
        if (significance === 'Значимая') {
            if (scale === 'Федеральный') securityClass = 'К1';
            else if (scale === 'Региональный') securityClass = 'К2';
            else if (scale === 'Муниципальный') securityClass = 'К3';
            else securityClass = 'К4';
        } else {
            securityClass = 'К4';
        }
        document.getElementById('calculatedSecurityClass').value = securityClass;
        document.getElementById('infoSystemSecurityClass').value = securityClass;
    }

    function calculateSecurityLevel() {
        const dataCategory = document.getElementById('infoSystemDataCategory').value;
        const processingType = document.getElementById('infoSystemProcessingType').value;
        const threatType = document.getElementById('infoSystemThreatType').value;
        const subjectsCount = parseInt(document.getElementById('infoSystemSubjectsCount').value) || 0;
        let securityLevel = '';
        if (dataCategory === 'Биометрические' || dataCategory === 'Специальные') {
            securityLevel = 'УЗ1';
        } else if (subjectsCount > 100000) {
            securityLevel = 'УЗ2';
        } else if (subjectsCount > 10000) {
            securityLevel = 'УЗ3';
        } else {
            securityLevel = 'УЗ4';
        }
        document.getElementById('calculatedSecurityLevel').value = securityLevel;
        document.getElementById('infoSystemSecurityLevel').value = securityLevel;
    }

