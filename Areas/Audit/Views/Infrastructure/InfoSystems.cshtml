        structuralElements.forEach(el => {
            html += `
                <tr>
                    <td><strong>${el.type}</strong></td>
                    <td>${el.description}</td>
                    <td class="actions">
                        <button class="btn-icon edit" title="Редактировать" onclick="editStructuralElement('${el.id}')"><i class="fas fa-edit"></i></button>
                        <button class="btn-icon delete" title="Удалить" onclick="deleteStructuralElement('${el.id}')"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            `;
        });
        tbody.innerHTML = html;
    }

    function deleteStructuralElement(id) {
        if (!confirm('Удалить структурный элемент?')) return;
        structuralElements = structuralElements.filter(e => e.id !== id);
        renderStructuralElements();
    }

