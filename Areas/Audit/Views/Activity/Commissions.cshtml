@{
    ViewData["Title"] = "Документы";
    
    // Получаем список документов из ViewBag (передается из контроллера)
    var documentsList = ViewBag.Documents as List<Dictionary<string, string>> ?? new List<Dictionary<string, string>>();
    // Для демонстрации добавляем заглушку, если список пуст
    if (!documentsList.Any())
    {
        documentsList = new List<Dictionary<string, string>>
        {
            new() { { "id", "1" }, { "name", "Инструкция ответственного за организацию работ по технической защите ПДн" }, { "status", "approved" }, { "date", "14.09.2023" }, { "version", "1.0" } },
            new() { { "id", "2" }, { "name", "Инструкция ответственного пользователя СКЗИ" }, { "status", "approved" }, { "date", "14.09.2023" }, { "version", "2.1" } },
            new() { { "id", "3" }, { "name", "Инструкция по внесению изменений в списки пользователей и наделение их полномочиями доступа к ресурсам ИС" }, { "status", "needs_approval" }, { "date", "20.10.2023" }, { "version", "3.0" } },
            new() { { "id", "4" }, { "name", "Инструкция по организации антивирусной защиты" }, { "status", "modified" }, { "date", "05.11.2023" }, { "version", "1.2" } },
            new() { { "id", "5" }, { "name", "Инструкция по организации парольной защиты" }, { "status", "not_generated" }, { "date", "—" }, { "version", "—" } },
            new() { { "id", "6" }, { "name", "Приказ о назначении администратора информационной безопасности" }, { "status", "error" }, { "date", "14.09.2022" }, { "version", "1.0" } }
        };
    }
    
    var stats = GetDocumentStats(documentsList);
    var totalDocs = documentsList.Count;
    var approvedCount = stats.GetValueOrDefault("approved", 0);
    var needsApprovalCount = stats.GetValueOrDefault("needs_approval", 0) + stats.GetValueOrDefault("modified", 0);
    var errorCount = stats.GetValueOrDefault("error", 0);
    var notGeneratedCount = stats.GetValueOrDefault("not_generated", 0);
    var readyPercent = totalDocs > 0 ? (int)Math.Round((double)approvedCount / totalDocs * 100) : 0;
}

<div class="page-header">
    <h1>
        <a href="/audit/activity" style="color: #64748b; text-decoration: none; margin-right: 12px; font-size: 24px;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <i class="fas fa-file-alt"></i> Документы
    </h1>
    <p style="color: #64748b; margin-top: 8px; margin-left: 36px;">Автоматическое формирование необходимых документов по вопросам обеспечения безопасности информации</p>
</div>

<!-- Вкладки навигации -->
<div class="tabs-nav">
    <a href="/audit/activity/responsible" class="tab-nav-item">Ответственные лица</a>
    <a href="/audit/activity/commissions" class="tab-nav-item">Комиссии</a>
    <a href="/audit/activity/documents" class="tab-nav-item active">Документы</a>
    <a href="/audit/activity/warranty" class="tab-nav-item">Гарантия</a>
    <a href="/audit/activity/notifications" class="tab-nav-item">Уведомления</a>
    <a href="/audit/activity/situations" class="tab-nav-item">Ситуации</a>
    <a href="/audit/activity/monitoring" class="tab-nav-item">Мониторинг</a>
</div>

<div class="form-content">
    <!-- Информационное сообщение -->
    <div class="info-panel" style="margin-bottom: 20px; padding: 16px; background: #f8fafc; border-radius: 8px; border-left: 4px solid #4F46E5;">
        <p style="margin: 0; color: #475569; font-size: 14px;">
            <i class="fas fa-info-circle" style="color: #4F46E5;"></i>
            Перечень организационно-распорядительных документов по информационной безопасности. Документы формируются автоматически на основании ранее введенной информации.
        </p>
    </div>

    <!-- Панель со статистикой и диаграммой -->
    <div class="stats-panel">
        <div class="stats-left">
            <div class="chart-container">
                <canvas id="documentsChart" width="140" height="140"></canvas>
                <div class="chart-center">
                    <span class="chart-percent">@readyPercent%</span>
                    <span class="chart-label">Готовность</span>
                </div>
            </div>
            <div class="legend">
                <div class="legend-item" data-status="approved">
                    <span class="legend-color" style="background: #22c55e;"></span>
                    <span>Сформировано и утверждено</span>
                </div>
                <div class="legend-item" data-status="needs_approval">
                    <span class="legend-color" style="background: #eab308;"></span>
                    <span>Сформировано, необходимо утвердить</span>
                </div>
                <div class="legend-item" data-status="modified">
                    <span class="legend-color" style="background: #f59e0b;"></span>
                    <span>Изменен, необходимо утвердить</span>
                </div>
                <div class="legend-item" data-status="error">
                    <span class="legend-color" style="background: #ef4444;"></span>
                    <span>Ошибка при формировании</span>
                </div>
                <div class="legend-item" data-status="not_generated">
                    <span class="legend-color" style="background: #94a3b8;"></span>
                    <span>Не сформировано</span>
                </div>
            </div>
        </div>
        <div class="stats-right">
            <div class="stat-item">
                <span class="stat-label">Всего документов:</span>
                <span class="stat-value">@totalDocs</span>
            </div>
            <div class="stat-item">
                <span class="stat-label" style="color: #22c55e;">● Утверждено:</span>
                <span class="stat-value">@approvedCount</span>
            </div>
            <div class="stat-item">
                <span class="stat-label" style="color: #eab308;">● Ожидают утверждения:</span>
                <span class="stat-value">@needsApprovalCount</span>
            </div>
            <div class="stat-item">
                <span class="stat-label" style="color: #ef4444;">● Ошибки:</span>
                <span class="stat-value">@errorCount</span>
            </div>
        </div>
    </div>

    <!-- Панель инструментов -->
    <div class="toolbar">
        <div class="toolbar-left">
            <button class="btn btn-primary" onclick="generateAllDocuments()">
                <i class="fas fa-sync"></i> Сформировать все документы
            </button>
            <button class="btn btn-secondary" onclick="alert('Настройка')">
                <i class="fas fa-cog"></i> Настройка
            </button>
        </div>
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="documentsSearch" placeholder="Поиск..." oninput="filterTable('documentsTable', 'documentsSearch')" />
        </div>
    </div>

    <!-- Таблица документов -->
    <div class="table-container">
        <table id="documentsTable" class="data-table">
            <thead>
                <tr>
                    <th class="th-sortable" style="min-width: 300px;">
                        <div class="th-header"><span>Наименование документа</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 0, this.value)" /></div>
                    </th>
                    <th class="th-sortable">
                        <div class="th-header"><span>Статус</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row">
                            <select class="filter-inline-select" onchange="filterTable('documentsTable', 1, this.value)">
                                <option value="">(Все)</option>
                                <option value="approved">Сформировано и утверждено</option>
                                <option value="needs_approval">Сформировано, необходимо утвердить</option>
                                <option value="modified">Изменен, необходимо утвердить</option>
                                <option value="error">Ошибка при формировании</option>
                                <option value="not_generated">Не сформировано</option>
                            </select>
                        </div>
                    </th>
                    <th class="th-sortable">
                        <div class="th-header"><span>Дата создания</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="date" class="filter-inline-input" oninput="filterTable('documentsTable', 2, this.value)" /></div>
                    </th>
                    <th class="th-sortable">
                        <div class="th-header"><span>Документ</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 3, this.value)" /></div>
                    </th>
                    <th class="th-sortable">
                        <div class="th-header"><span>Утвержденный документ</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 4, this.value)" /></div>
                    </th>
                    <th style="width: 100px;">Действия</th>
                </tr>
            </thead>
            <tbody id="documentsTableBody">
                @if (documentsList.Any())
                {
                    @foreach (var item in documentsList)
                    {
                        var status = item["status"];
                        var statusText = GetStatusText(status);
                        var statusColor = GetStatusColor(status);
                        var date = item["date"] ?? "—";
                        var version = item["version"] ?? "—";
                        var name = item["name"] ?? "Документ";
                        var id = item["id"] ?? "0";
                        
                        <tr data-id="@id" data-status="@status">
                            <td><strong>@name</strong></td>
                            <td>
                                <span class="status-badge" style="background: @statusColor; color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; display: inline-block;">
                                    @statusText
                                </span>
                                @if (status == "error")
                                {
                                    <button class="btn-icon" style="background: none; color: #ef4444; font-size: 16px;" onclick="showErrorDetails('@id')" title="Подробнее об ошибке">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                }
                            </td>
                            <td>@date</td>
                            <td>
                                @if (status != "not_generated" && status != "error")
                                {
                                    <button class="btn-icon" style="background: #e0f2fe; color: #0284c7;" onclick="downloadDocument('@id')" title="Скачать документ">
                                        <i class="fas fa-download"></i>
                                    </button>
                                    <span style="font-size: 12px; color: #94a3b8; margin-left: 4px;">v@(version)</span>
                                }
                                else
                                {
                                    <span style="font-size: 12px; color: #94a3b8;">—</span>
                                }
                            </td>
                            <td>
                                @if (status == "approved")
                                {
                                    <span style="font-size: 12px; color: #22c55e;">
                                        <i class="fas fa-check-circle"></i> Прикреплен
                                    </span>
                                }
                                else if (status == "needs_approval" || status == "modified")
                                {
                                    <button class="btn-icon" style="background: #d1fae5; color: #059669;" onclick="attachDocument('@id')" title="Прикрепить утвержденный документ">
                                        <i class="fas fa-paperclip"></i>
                                    </button>
                                    <span style="font-size: 12px; color: #f59e0b; margin-left: 4px;">Не прикреплен</span>
                                }
                                else
                                {
                                    <span style="font-size: 12px; color: #94a3b8;">—</span>
                                }
                            </td>
                            <td class="actions">
                                <button class="btn-icon edit" onclick="editDocument('@id')" title="Редактировать">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn-icon delete" onclick="deleteDocument('@id')" title="Удалить">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 60px 40px; color: #94a3b8;">
                            <i class="fas fa-file-alt" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>
                            Документы не добавлены
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    <div class="pagination">
        <div class="pagination-page-size">
            <label>Показывать по:</label>
            <select onchange="changePageSize(this.value)">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="20">20</option>
            </select>
        </div>
        <div class="pagination-info">Страница 1 из 1 (Всего элементов: @documentsList.Count)</div>
        <div class="pagination-buttons">
            <button class="btn-pagination" disabled>‹</button>
            <button class="btn-pagination active">1</button>
            <button class="btn-pagination" disabled>›</button>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛЬНОЕ ОКНО: Уведомление о формировании (Рисунок 192) -->
<!-- ============================================================ -->
<div class="modal" id="successModal">
    <div class="modal-content" style="max-width: 400px;">
        <div class="modal-header">
            <h3 style="color: #22c55e;"><i class="fas fa-check-circle"></i> Успешно</h3>
            <button class="modal-close" onclick="closeSuccessModal()">&times;</button>
        </div>
        <div class="modal-body">
            <p id="successMessage" style="font-size: 14px; color: #475569; margin: 0; text-align: center;">
                Документы успешно сформированы
            </p>
            <div class="form-actions" style="justify-content: center; border-top: none; padding-top: 16px; margin-top: 16px;">
                <button type="button" class="btn btn-primary" onclick="closeSuccessModal()">ОК</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛЬНОЕ ОКНО: Ошибка при формировании (Рисунок 193) -->
<!-- ============================================================ -->
<div class="modal" id="errorDetailsModal">
    <div class="modal-content" style="max-width: 500px;">
        <div class="modal-header">
            <h3 style="color: #ef4444;"><i class="fas fa-exclamation-triangle"></i> Ошибка при формировании файла</h3>
            <button class="modal-close" onclick="closeErrorDetails()">&times;</button>
        </div>
        <div class="modal-body">
            <div style="padding: 16px; background: #fef2f2; border-radius: 8px; border-left: 4px solid #ef4444;">
                <p style="margin: 0; font-size: 14px; color: #475569;">
                    <strong id="errorDocName">Приказ о назначении администратора информационной безопасности</strong>
                </p>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #dc2626;">
                    <i class="fas fa-info-circle"></i> <span id="errorDetailsText">Администратор информационной безопасности не найден</span>
                </p>
            </div>
            <div class="form-actions" style="justify-content: center; border-top: none; padding-top: 16px; margin-top: 16px;">
                <button type="button" class="btn btn-secondary" onclick="closeErrorDetails()">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛЬНОЕ ОКНО: Прикрепление документа -->
<!-- ============================================================ -->
<div class="modal" id="attachModal">
    <div class="modal-content" style="max-width: 550px;">
        <div class="modal-header">
            <h3>Прикрепление утвержденного документа</h3>
            <button class="modal-close" onclick="closeAttachModal()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Документ</label>
                <div class="upload-area" id="attachUploadArea" 
                     ondragover="handleAttachDragOver(event)" 
                     ondragleave="handleAttachDragLeave(event)" 
                     ondrop="handleAttachDrop(event)">
                    <div class="upload-placeholder" id="attachPlaceholder">
                        <i class="fas fa-cloud-upload-alt" style="font-size: 32px; color: #94a3b8;"></i>
                        <p style="margin: 8px 0; color: #94a3b8; font-size: 14px;">
                            или перетащите файл в эту область
                        </p>
                        <input type="file" id="attachFile" accept=".pdf,.jpg,.jpeg,.doc,.docx" style="display: none;" onchange="handleAttachFileSelect(event)" />
                        <button type="button" class="btn btn-sm btn-secondary" onclick="document.getElementById('attachFile').click()">
                            <i class="fas fa-folder-open"></i> Выберите файл
                        </button>
                    </div>
                    <div class="file-info" id="attachFileInfo" style="display: none;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <i class="fas fa-file-pdf" style="font-size: 24px; color: #dc2626;"></i>
                            <div>
                                <div id="attachFileName" style="font-weight: 500; color: #1e293b;">document.pdf</div>
                                <div id="attachFileSize" style="font-size: 12px; color: #94a3b8;">0 KB</div>
                            </div>
                            <button type="button" class="btn-icon delete" onclick="removeAttachFile()" style="margin-left: auto;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">
                    <i class="fas fa-info-circle"></i> Разрешены файлы форматов *.pdf, *.jpg, *.jpeg, *.doc, *.docx
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="closeAttachModal()">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="saveAttachDocument()">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<script>
    let attachFileObj = null;
    let currentDocId = null;

    // ============================================================
    // ДИАГРАММА
    // ============================================================
    document.addEventListener('DOMContentLoaded', function() {
        drawChart();
        setupLegendHover();
    });

    function drawChart() {
        const canvas = document.getElementById('documentsChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const total = @documentsList.Count;
        if (total === 0) {
            ctx.font = '16px sans-serif';
            ctx.fillStyle = '#94a3b8';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('Нет данных', 70, 70);
            return;
        }
        
        const statusData = [
            { value: @approvedCount, color: '#22c55e' },
            { value: @stats.GetValueOrDefault("needs_approval", 0), color: '#eab308' },
            { value: @stats.GetValueOrDefault("modified", 0), color: '#f59e0b' },
            { value: @errorCount, color: '#ef4444' },
            { value: @notGeneratedCount, color: '#94a3b8' }
        ];
        
        let startAngle = -Math.PI / 2;
        const radius = 55;
        const centerX = 70;
        const centerY = 70;
        
        ctx.clearRect(0, 0, 140, 140);
        
        statusData.forEach(item => {
            if (item.value === 0) return;
            const sliceAngle = (item.value / total) * 2 * Math.PI;
            ctx.beginPath();
            ctx.moveTo(centerX, centerY);
            ctx.arc(centerX, centerY, radius, startAngle, startAngle + sliceAngle);
            ctx.closePath();
            ctx.fillStyle = item.color;
            ctx.fill();
            startAngle += sliceAngle;
        });
        
        ctx.beginPath();
        ctx.arc(centerX, centerY, 38, 0, 2 * Math.PI);
        ctx.fillStyle = '#f8fafc';
        ctx.fill();
        ctx.strokeStyle = '#e2e8f0';
        ctx.lineWidth = 1;
        ctx.stroke();
    }

    function setupLegendHover() {
        document.querySelectorAll('.legend-item').forEach(item => {
            item.addEventListener('mouseenter', function() {
                const status = this.dataset.status;
                highlightSector(status);
                this.style.opacity = '1';
            });
            item.addEventListener('mouseleave', function() {
                resetSectors();
                this.style.opacity = '';
            });
        });
    }

    function highlightSector(status) {
        drawChart();
    }

    function resetSectors() {
        drawChart();
    }

    // ============================================================
    // УПРАВЛЕНИЕ ДОКУМЕНТАМИ
    // ============================================================
    function generateAllDocuments() {
        if (confirm('Сформировать все документы?')) {
            setTimeout(function() {
                document.getElementById('successMessage').textContent = 'Документы успешно сформированы';
                document.getElementById('successModal').classList.add('show');
                setTimeout(function() {
                    location.reload();
                }, 1500);
            }, 500);
        }
    }

    function closeSuccessModal() {
        document.getElementById('successModal').classList.remove('show');
    }

    function downloadDocument(id) {
        alert('Скачивание документа ID: ' + id);
    }

    function attachDocument(id) {
        currentDocId = id;
        attachFileObj = null;
        document.getElementById('attachFileInfo').style.display = 'none';
        document.getElementById('attachPlaceholder').style.display = 'block';
        document.getElementById('attachFile').value = '';
        document.getElementById('attachModal').classList.add('show');
    }

    function closeAttachModal() {
        document.getElementById('attachModal').classList.remove('show');
        currentDocId = null;
    }

    function saveAttachDocument() {
        if (!attachFileObj) {
            alert('Пожалуйста, выберите файл для прикрепления');
            return;
        }
        alert('Документ ID ' + currentDocId + ' успешно прикреплен. Статус обновлен на "Утвержден"');
        closeAttachModal();
        location.reload();
    }

    function handleAttachDragOver(e) {
        e.preventDefault();
        document.getElementById('attachUploadArea').classList.add('drag-over');
    }

    function handleAttachDragLeave(e) {
        e.preventDefault();
        document.getElementById('attachUploadArea').classList.remove('drag-over');
    }

    function handleAttachDrop(e) {
        e.preventDefault();
        document.getElementById('attachUploadArea').classList.remove('drag-over');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            processAttachFile(files[0]);
        }
    }

    function handleAttachFileSelect(e) {
        if (e.target.files.length > 0) {
            processAttachFile(e.target.files[0]);
        }
    }

    function processAttachFile(file) {
        const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
        if (!allowedTypes.includes(file.type)) {
            alert('Пожалуйста, выберите файл в формате PDF, JPG, JPEG, DOC или DOCX');
            return;
        }
        attachFileObj = file;
        document.getElementById('attachFileName').textContent = file.name;
        document.getElementById('attachFileSize').textContent = (file.size / 1024).toFixed(2) + ' KB';
        document.getElementById('attachFileInfo').style.display = 'block';
        document.getElementById('attachPlaceholder').style.display = 'none';
    }

    function removeAttachFile() {
        attachFileObj = null;
        document.getElementById('attachFileInfo').style.display = 'none';
        document.getElementById('attachPlaceholder').style.display = 'block';
        document.getElementById('attachFile').value = '';
    }

    function showErrorDetails(id) {
        const doc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(documentsList));
        const item = doc.find(d => d.id === id);
        if (item) {
            document.getElementById('errorDocName').textContent = item.name || 'Документ';
            document.getElementById('errorDetailsText').textContent = 'Администратор информационной безопасности не найден';
        }
        document.getElementById('errorDetailsModal').classList.add('show');
    }

    function closeErrorDetails() {
        document.getElementById('errorDetailsModal').classList.remove('show');
    }

    function editDocument(id) {
        alert('Редактирование документа ID: ' + id);
    }

    function deleteDocument(id) {
        if (confirm('Вы уверены, что хотите удалить этот документ?')) {
            alert('Документ ID ' + id + ' удален');
        }
    }

    // ============================================================
    // ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
    // ============================================================
    function filterTable(tableId, searchIdOrCol, value) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = tbody.querySelectorAll('tr');
        if (typeof searchIdOrCol === 'string') {
            const searchTerm = document.getElementById(searchIdOrCol)?.value?.toLowerCase() || '';
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(searchTerm) ? '' : 'none';
            });
            return;
        }
        const colIndex = typeof searchIdOrCol === 'number' ? searchIdOrCol : parseInt(searchIdOrCol);
        const searchVal = (value || '').toLowerCase();
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                row.style.display = cell.textContent.toLowerCase().includes(searchVal) ? '' : 'none';
            }
        });
    }

    function changePageSize(value) {
        alert('Изменение размера страницы на ' + value);
    }

    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('show');
        });
    });
</script>

@functions {
    private Dictionary<string, long> GetDocumentStats(List<Dictionary<string, string>> docs)
    {
        var statuses = new[] { "approved", "needs_approval", "modified", "error", "not_generated" };
        var result = new Dictionary<string, long>();
        foreach (var status in statuses)
        {
            result[status] = docs.Count(d => d["status"] == status);
        }
        return result;
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "approved" => "Сформировано и утверждено",
            "needs_approval" => "Сформировано, необходимо утвердить",
            "modified" => "Изменен, необходимо утвердить",
            "error" => "Ошибка при формировании",
            "not_generated" => "Не сформировано",
            _ => status
        };
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "approved" => "#22c55e",
            "needs_approval" => "#eab308",
            "modified" => "#f59e0b",
            "error" => "#ef4444",
            "not_generated" => "#94a3b8",
            _ => "#94a3b8"
        };
    }
}

