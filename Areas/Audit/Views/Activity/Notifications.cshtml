<script>
    let lettersData = [];

    document.addEventListener('DOMContentLoaded', function() {
        try {
            const saved = localStorage.getItem('notificationsData');
            if (saved) {
                lettersData = JSON.parse(saved);
            } else {
                lettersData = [
                    { id: 1, type: 'Уведомление об обработке (о намерении осуществлять обработку ПДн)', sendDate: '30.04.2022', status: 'Отправлено' }
                ];
                localStorage.setItem('notificationsData', JSON.stringify(lettersData));
            }
        } catch(e) {
            lettersData = [];
        }
        renderLettersTable();
    });

    function switchNotificationTab(tab, btn) {
        document.querySelectorAll('.notification-tab').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.sub-tab').forEach(el => el.classList.remove('active'));
        document.getElementById('notification-' + tab).style.display = 'block';
        if (btn) btn.classList.add('active');
    }

    function renderLettersTable() {
        const tbody = document.getElementById('lettersTableBody');
        tbody.innerHTML = '';
        if (lettersData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align: center; padding: 60px 40px; color: #94a3b8;">Уведомления не созданы</td></tr>';
            return;
        }
        lettersData.forEach(item => {
            const statusColor = item.status === 'Отправлено' ? '#22c55e' : item.status === 'Создано' ? '#f59e0b' : '#94a3b8';
            const tr = document.createElement('tr');
            tr.innerHTML = `<td><strong>${item.type}</strong></td>
                            <td>${item.sendDate}</td>
                            <td><span class="status-badge" style="background: ${statusColor}; color: white; padding: 4px 12px; border-radius: 12px; font-size: 12px; display: inline-block;">${item.status}</span></td>
                            <td class="actions">
                                <button class="btn-icon" style="background: #e0f2fe; color: #0284c7;" onclick="viewNotification(${item.id})"><i class="fas fa-eye"></i></button>
                                <button class="btn-icon edit" onclick="editNotification(${item.id})"><i class="fas fa-edit"></i></button>
                                <button class="btn-icon delete" onclick="deleteNotification(${item.id})"><i class="fas fa-trash"></i></button>
                            </td>`;
            tbody.appendChild(tr);
        });
    }

    function saveNotificationMain(e) {
        e.preventDefault();
        alert('Основные сведения сохранены!');
    }

    function checkRegistry() {
        document.getElementById('registryModal').classList.add('show');
    }

    function closeRegistryModal() {
        document.getElementById('registryModal').classList.remove('show');
        document.getElementById('confirmModal').classList.add('show');
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').classList.remove('show');
    }

    function confirmUpdate() {
        closeConfirmModal();
        alert('Данные успешно обновлены из реестра операторов');
        document.getElementById('registryNumber').value = '08-0007079';
        document.getElementById('registryStartDate').value = '2008-01-24';
    }

    function createNotification() {
        document.getElementById('notificationModalTitle').textContent = 'Уведомление об обработке ПДн';
        document.getElementById('notifConfirmRead').checked = false;
        document.getElementById('notifConfirmConsent').checked = false;
        document.getElementById('notificationModal').classList.add('show');
    }

    function closeNotificationModal() {
        document.getElementById('notificationModal').classList.remove('show');
    }

    function submitNotification(e) {
        e.preventDefault();
        const operatorType = document.getElementById('notifOperatorType').value;
        const operatorName = document.getElementById('notifOperatorName').value.trim();
        const read = document.getElementById('notifConfirmRead').checked;
        const consent = document.getElementById('notifConfirmConsent').checked;
        
        if (!operatorType || !operatorName) {
            alert('Пожалуйста, заполните все обязательные поля');
            return;
        }
        if (!read || !consent) {
            alert('Необходимо подтвердить ознакомление и согласие на передачу');
            return;
        }
        
        const newLetter = {
            id: Date.now(),
            type: 'Уведомление об обработке (о намерении осуществлять обработку ПДн)',
            sendDate: new Date().toLocaleDateString('ru-RU'),
            status: 'Создано'
        };
        lettersData.push(newLetter);
        localStorage.setItem('notificationsData', JSON.stringify(lettersData));
        renderLettersTable();
        closeNotificationModal();
        alert('Уведомление сформировано успешно! Откройте новую вкладку для просмотра и распечатайте документ.');
    }

    function createChangeLetter() {
        document.getElementById('changeConfirmRead').checked = false;
        document.getElementById('changeConfirmConsent').checked = false;
        document.getElementById('changeLetterModal').classList.add('show');
    }

    function closeChangeLetterModal() {
        document.getElementById('changeLetterModal').classList.remove('show');
    }

    function submitChangeLetter(e) {
        e.preventDefault();
        const operatorType = document.getElementById('changeOperatorType').value;
        const operatorName = document.getElementById('changeOperatorName').value.trim();
        const read = document.getElementById('changeConfirmRead').checked;
        const consent = document.getElementById('changeConfirmConsent').checked;
        
        if (!operatorType || !operatorName) {
            alert('Пожалуйста, заполните все обязательные поля');
            return;
        }
        if (!read || !consent) {
            alert('Необходимо подтвердить ознакомление и согласие на передачу');
            return;
        }
        
        const newLetter = {
            id: Date.now(),
            type: 'Письмо о внесении изменений',
            sendDate: new Date().toLocaleDateString('ru-RU'),
            status: 'Создано'
        };
        lettersData.push(newLetter);
        localStorage.setItem('notificationsData', JSON.stringify(lettersData));
        renderLettersTable();
        closeChangeLetterModal();
        alert('Информационное письмо сформировано успешно!');
    }

    function createTerminationLetter() {
        document.getElementById('termConfirmRead').checked = false;
        document.getElementById('termConfirmConsent').checked = false;
        document.getElementById('terminationLetterModal').classList.add('show');
    }

    function closeTerminationLetterModal() {
        document.getElementById('terminationLetterModal').classList.remove('show');
    }

    function submitTerminationLetter(e) {
        e.preventDefault();
        const docType = document.getElementById('termDocType').value;
        const operatorName = document.getElementById('termOperatorName').value.trim();
        const read = document.getElementById('termConfirmRead').checked;
        const consent = document.getElementById('termConfirmConsent').checked;
        
        if (!docType || !operatorName) {
            alert('Пожалуйста, заполните все обязательные поля');
            return;
        }
        if (!read || !consent) {
            alert('Необходимо подтвердить ознакомление и согласие на передачу');
            return;
        }
        
        const newLetter = {
            id: Date.now(),
            type: 'Письмо о прекращении обработки ПДн',
            sendDate: new Date().toLocaleDateString('ru-RU'),
            status: 'Создано'
        };
        lettersData.push(newLetter);
        localStorage.setItem('notificationsData', JSON.stringify(lettersData));
        renderLettersTable();
        closeTerminationLetterModal();
        alert('Письмо о прекращении обработки сформировано успешно!');
    }

    function addHistoryRecord() {
        document.getElementById('recordDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('addRecordModal').classList.add('show');
    }

    function closeAddRecordModal() {
        document.getElementById('addRecordModal').classList.remove('show');
    }

    function submitAddRecord(e) {
        e.preventDefault();
        const type = document.getElementById('recordType').value;
        const date = document.getElementById('recordDate').value;
        
        if (!type || !date) {
            alert('Пожалуйста, заполните все обязательные поля');
            return;
        }
        
        const newRecord = {
            id: Date.now(),
            type: type,
            sendDate: new Date(date).toLocaleDateString('ru-RU'),
            status: document.getElementById('recordStatus').value
        };
        lettersData.push(newRecord);
        localStorage.setItem('notificationsData', JSON.stringify(lettersData));
        renderLettersTable();
        closeAddRecordModal();
        alert('Запись добавлена успешно!');
    }

    function viewNotification(id) {
        const item = lettersData.find(l => l.id === id);
        if (item) {
            alert('Просмотр уведомления:\n\nВид: ' + item.type + '\nДата отправки: ' + item.sendDate + '\nСтатус: ' + item.status);
        }
    }

    function editNotification(id) {
        const item = lettersData.find(l => l.id === id);
        if (item) {
            const newStatus = prompt('Измените статус уведомления:', item.status);
            if (newStatus && ['Отправлено', 'Создано', 'Подписано'].includes(newStatus)) {
                item.status = newStatus;
                localStorage.setItem('notificationsData', JSON.stringify(lettersData));
                renderLettersTable();
            }
        }
    }

    function deleteNotification(id) {
        if (confirm('Вы уверены, что хотите удалить это уведомление?')) {
            lettersData = lettersData.filter(l => l.id !== id);
            localStorage.setItem('notificationsData', JSON.stringify(lettersData));
            renderLettersTable();
        }
    }

    function filterTable(tableId, searchIdOrCol, value) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = tbody.querySelectorAll('tr');
        if (typeof searchIdOrCol === 'string') {
            const searchTerm = document.getElementById(searchIdOrCol)?.value?.toLowerCase() || '';
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(searchTerm) ? '' : 'none';
            });
            return;
        }
        const colIndex = typeof searchIdOrCol === 'number' ? searchIdOrCol : parseInt(searchIdOrCol);
        const searchVal = (value || '').toLowerCase();
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                row.style.display = cell.textContent.toLowerCase().includes(searchVal) ? '' : 'none';
            }
        });
    }

    function changePageSize(value) {
        alert('Изменение размера страницы на ' + value);
    }

    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('show');
        });
    });
</script>

