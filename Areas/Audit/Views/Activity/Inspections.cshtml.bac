@{
    ViewData["Title"] = "Проверки";
}

<div class="page-header">
    <h1>
        <a href="/audit/activity" style="color: #64748b; text-decoration: none; margin-right: 12px; font-size: 24px;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <i class="fas fa-clipboard-check"></i> Проверки
    </h1>
    <p style="color: #64748b; margin-top: 8px; margin-left: 36px;">Учет внутренних и внешних проверок</p>
</div>

<!-- Вкладки навигации -->
<div class="tabs-nav">
    <a href="/audit/activity/responsible" class="tab-nav-item">Ответственные лица</a>
    <a href="/audit/activity/commissions" class="tab-nav-item">Комиссии</a>
    <a href="/audit/activity/journals" class="tab-nav-item">Журналы</a>
    <a href="/audit/activity/documents" class="tab-nav-item">Документы</a>
    <a href="/audit/activity/warranty" class="tab-nav-item">Гарантия</a>
    <a href="/audit/activity/notifications" class="tab-nav-item">Уведомления</a>
    <a href="/audit/activity/situations" class="tab-nav-item">Ситуации</a>
    <a href="/audit/activity/monitoring" class="tab-nav-item">Мониторинг</a>
    <a href="/audit/activity/inspections" class="tab-nav-item active">Проверки</a>
</div>

<div class="form-content">
    <!-- Вкладки внутри подраздела -->
    <div class="sub-tabs" style="display: flex; gap: 4px; margin-bottom: 20px; background: #f1f5f9; padding: 4px; border-radius: 8px;">
        <button class="sub-tab active" onclick="switchInspectionTab('internal', this)">Внутренние проверки</button>
        <button class="sub-tab" onclick="switchInspectionTab('external', this)">Внешние проверки</button>
        <button class="sub-tab" onclick="switchInspectionTab('regulators', this)">Готовность к проверкам регуляторов</button>
    </div>

    <!-- Вкладка: Внутренние проверки -->
    <div id="inspection-internal" class="inspection-tab active">
        <div class="info-panel" style="margin-bottom: 20px; padding: 16px; background: #f0fdf4; border-radius: 8px; border-left: 4px solid #22c55e;">
            <p style="margin: 0; color: #166534; font-size: 14px;">
                <i class="fas fa-info-circle"></i>
                Список всех мероприятий в области защиты персональных данных и обеспечения информационной безопасности.
            </p>
        </div>

        <div class="toolbar">
            <div class="toolbar-left">
                <button class="btn btn-primary" onclick="addInspection()">
                    <i class="fas fa-plus"></i> Добавить
                </button>
                <div class="dropdown">
                    <button class="btn btn-secondary dropdown-toggle" onclick="toggleDropdown('exportInspections')">
                        <i class="fas fa-file-export"></i> Экспорт в файл
                        <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>
                    </button>
                    <div id="exportInspections" class="dropdown-menu">
                        <a onclick="exportTable('inspectionsTable', 'xlsx')"><i class="fas fa-file-excel"></i> Экспорт в XLSX</a>
                        <a onclick="exportTable('inspectionsTable', 'pdf')"><i class="fas fa-file-pdf"></i> Экспорт в PDF</a>
                    </div>
                </div>
            </div>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="inspectionsSearch" placeholder="Поиск..." oninput="filterTable('inspectionsTable', 'inspectionsSearch')" />
            </div>
        </div>

        <div class="table-container">
            <table id="inspectionsTable" class="data-table">
                <thead>
                    <tr>
                        <th class="th-sortable">
                            <div class="th-header"><span>Наименование</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('inspectionsTable', 0, this.value)" /></div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Дата начала</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="date" class="filter-inline-input" oninput="filterTable('inspectionsTable', 1, this.value)" /></div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Дата окончания</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="date" class="filter-inline-input" oninput="filterTable('inspectionsTable', 2, this.value)" /></div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Ответственный</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('inspectionsTable', 3, this.value)" /></div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Периодичность</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row">
                                <select class="filter-inline-select" onchange="filterTable('inspectionsTable', 4, this.value)">
                                    <option value="">(Все)</option>
                                    <option value="Ежемесячно">Ежемесячно</option>
                                    <option value="Ежеквартально">Ежеквартально</option>
                                    <option value="Ежегодно">Ежегодно</option>
                                    <option value="По факту">По факту</option>
                                </select>
                            </div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Статус</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row">
                                <select class="filter-inline-select" onchange="filterTable('inspectionsTable', 5, this.value)">
                                    <option value="">(Все)</option>
                                    <option value="Активна">Активна</option>
                                    <option value="Запланирована">Запланирована</option>
                                    <option value="Завершена">Завершена</option>
                                    <option value="Отменена">Отменена</option>
                                </select>
                            </div>
                        </th>
                        <th style="width: 140px;">Действия</th>
                    </tr>
                </thead>
                <tbody id="inspectionsTableBody">
                    <tr><td colspan="7" style="text-align: center; padding: 60px 40px; color: #94a3b8;">Проверки не добавлены</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Вкладка: Внешние проверки -->
    <div id="inspection-external" class="inspection-tab" style="display: none;">
        <div class="info-panel" style="margin-bottom: 20px; padding: 16px; background: #fef3c7; border-radius: 8px; border-left: 4px solid #d97706;">
            <p style="margin: 0; color: #92400e; font-size: 14px;">
                <i class="fas fa-info-circle"></i>
                Учет проверок контролирующих органов (Роскомнадзор, ФСБ, ФСТЭК).
            </p>
        </div>

        <div class="table-container">
            <table id="externalInspectionsTable" class="data-table">
                <thead>
                    <tr>
                        <th class="th-sortable">
                            <div class="th-header"><span>Орган проверки</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row">
                                <select class="filter-inline-select" onchange="filterTable('externalInspectionsTable', 0, this.value)">
                                    <option value="">(Все)</option>
                                    <option value="Роскомнадзор">Роскомнадзор</option>
                                    <option value="ФСТЭК">ФСТЭК</option>
                                    <option value="ФСБ">ФСБ</option>
                                </select>
                            </div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Дата проверки</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row"><input type="date" class="filter-inline-input" oninput="filterTable('externalInspectionsTable', 1, this.value)" /></div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Результат</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row">
                                <select class="filter-inline-select" onchange="filterTable('externalInspectionsTable', 2, this.value)">
                                    <option value="">(Все)</option>
                                    <option value="Успешно">Успешно</option>
                                    <option value="Замечания">Замечания</option>
                                    <option value="Нарушения">Нарушения</option>
                                </select>
                            </div>
                        </th>
                        <th class="th-sortable">
                            <div class="th-header"><span>Статус</span><i class="fas fa-sort sortable-icon"></i></div>
                            <div class="th-filter-row">
                                <select class="filter-inline-select" onchange="filterTable('externalInspectionsTable', 3, this.value)">
                                    <option value="">(Все)</option>
                                    <option value="Завершена">Завершена</option>
                                    <option value="В процессе">В процессе</option>
                                    <option value="Запланирована">Запланирована</option>
                                </select>
                            </div>
                        </th>
                        <th style="width: 140px;">Действия</th>
                    </tr>
                </thead>
                <tbody id="externalInspectionsTableBody">
                    <tr>
                        <td>Роскомнадзор</td>
                        <td>15.06.2023</td>
                        <td><span class="status-badge" style="background: #22c55e20; color: #22c55e;">Успешно</span></td>
                        <td><span class="status-badge" style="background: #22c55e20; color: #22c55e;">Завершена</span></td>
                        <td class="actions">
                            <button class="btn-icon" style="background: #e0f2fe; color: #0284c7;"><i class="fas fa-eye"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>ФСТЭК</td>
                        <td>10.08.2023</td>
                        <td><span class="status-badge" style="background: #f59e0b20; color: #f59e0b;">Замечания</span></td>
                        <td><span class="status-badge" style="background: #f59e0b20; color: #f59e0b;">В процессе</span></td>
                        <td class="actions">
                            <button class="btn-icon" style="background: #e0f2fe; color: #0284c7;"><i class="fas fa-eye"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Вкладка: Готовность к проверкам регуляторов -->
    <div id="inspection-regulators" class="inspection-tab" style="display: none;">
        <div class="info-panel" style="margin-bottom: 20px; padding: 16px; background: #eef2ff; border-radius: 8px; border-left: 4px solid #4F46E5;">
            <p style="margin: 0; color: #1e293b; font-size: 14px;">
                <i class="fas fa-info-circle" style="color: #4F46E5;"></i>
                Оценка готовности организации к проверкам контролирующих органов.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
            <div class="regulator-card" style="padding: 20px; background: white; border-radius: 12px; border: 1px solid #e2e8f0; text-align: center;">
                <div style="font-size: 48px; margin-bottom: 12px;">📋</div>
                <h3 style="margin: 0 0 8px 0;">Роскомнадзор</h3>
                <div style="font-size: 36px; font-weight: 700; color: #22c55e;">85%</div>
                <div style="width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; margin: 12px 0;">
                    <div style="width: 85%; height: 100%; background: #22c55e; border-radius: 4px;"></div>
                </div>
                <div style="display: flex; justify-content: space-around; font-size: 13px; color: #475569;">
                    <span>✅ Готов</span>
                    <span>⚠️ 3 замечания</span>
                </div>
                <button class="btn btn-secondary" style="margin-top: 12px;" onclick="alert('Детали готовности к проверке Роскомнадзора')">Подробнее</button>
            </div>

            <div class="regulator-card" style="padding: 20px; background: white; border-radius: 12px; border: 1px solid #e2e8f0; text-align: center;">
                <div style="font-size: 48px; margin-bottom: 12px;">🔒</div>
                <h3 style="margin: 0 0 8px 0;">ФСТЭК</h3>
                <div style="font-size: 36px; font-weight: 700; color: #eab308;">65%</div>
                <div style="width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; margin: 12px 0;">
                    <div style="width: 65%; height: 100%; background: #eab308; border-radius: 4px;"></div>
                </div>
                <div style="display: flex; justify-content: space-around; font-size: 13px; color: #475569;">
                    <span>⚠️ Частично готов</span>
                    <span>⚠️ 5 замечаний</span>
                </div>
                <button class="btn btn-secondary" style="margin-top: 12px;" onclick="alert('Детали готовности к проверке ФСТЭК')">Подробнее</button>
            </div>

            <div class="regulator-card" style="padding: 20px; background: white; border-radius: 12px; border: 1px solid #e2e8f0; text-align: center;">
                <div style="font-size: 48px; margin-bottom: 12px;">🛡️</div>
                <h3 style="margin: 0 0 8px 0;">ФСБ</h3>
                <div style="font-size: 36px; font-weight: 700; color: #22c55e;">92%</div>
                <div style="width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px; margin: 12px 0;">
                    <div style="width: 92%; height: 100%; background: #22c55e; border-radius: 4px;"></div>
                </div>
                <div style="display: flex; justify-content: space-around; font-size: 13px; color: #475569;">
                    <span>✅ Готов</span>
                    <span>⚠️ 1 замечание</span>
                </div>
                <button class="btn btn-secondary" style="margin-top: 12px;" onclick="alert('Детали готовности к проверке ФСБ')">Подробнее</button>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- МОДАЛЬНОЕ ОКНО: Добавление проверки -->
<!-- ============================================================ -->
<div class="modal" id="inspectionModal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h3 id="inspectionModalTitle">Добавление проверки</h3>
            <button class="modal-close" onclick="closeInspectionModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="inspectionForm" onsubmit="saveInspection(event)">
                <input type="hidden" id="inspectionId" />
                
                <div class="form-group">
                    <label>Наименование <span class="required">*</span></label>
                    <input type="text" id="inspectionName" class="form-control" required />
                </div>
                
                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label>Дата начала <span class="required">*</span></label>
                        <input type="date" id="inspectionStart" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label>Дата окончания</label>
                        <input type="date" id="inspectionEnd" class="form-control" />
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Ответственный <span class="required">*</span></label>
                    <input type="text" id="inspectionExecutor" class="form-control" required />
                </div>
                
                <div class="form-group">
                    <label>Периодичность <span class="required">*</span></label>
                    <select id="inspectionFrequency" class="form-control" required>
                        <option value="">Выбрать...</option>
                        <option value="Ежемесячно">Ежемесячно</option>
                        <option value="Ежеквартально">Ежеквартально</option>
                        <option value="Ежегодно">Ежегодно</option>
                        <option value="По факту">По факту</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>Статус <span class="required">*</span></label>
                    <select id="inspectionStatus" class="form-control" required>
                        <option value="">Выбрать...</option>
                        <option value="Активна">Активна</option>
                        <option value="Запланирована">Запланирована</option>
                        <option value="Завершена">Завершена</option>
                        <option value="Отменена">Отменена</option>
                    </select>
                </div>
                
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeInspectionModal()">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let inspectionsData = [];

    document.addEventListener('DOMContentLoaded', function() {
        try {
            const saved = localStorage.getItem('inspectionsData');
            if (saved) {
                inspectionsData = JSON.parse(saved);
            } else {
                inspectionsData = [
                    { id: 1, name: 'Плановая проверка', start: '16.04.2023', end: '31.05.2023', executor: 'Иванов Иван Иванович', frequency: 'Ежемесячно', status: 'Активна' },
                    { id: 2, name: 'Внеплановая проверка', start: '10.08.2023', end: '31.12.2023', executor: 'Сидорова Анна Сергеевна', frequency: 'По факту', status: 'Запланирована' }
                ];
                localStorage.setItem('inspectionsData', JSON.stringify(inspectionsData));
            }
        } catch(e) {
            inspectionsData = [];
        }
        renderInspectionsTable();
    });

    function switchInspectionTab(tab, btn) {
        document.querySelectorAll('.inspection-tab').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.sub-tab').forEach(el => el.classList.remove('active'));
        document.getElementById('inspection-' + tab).style.display = 'block';
        if (btn) btn.classList.add('active');
    }

    function renderInspectionsTable() {
        const tbody = document.getElementById('inspectionsTableBody');
        tbody.innerHTML = '';
        if (inspectionsData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 60px 40px; color: #94a3b8;">Проверки не добавлены</td></tr>';
            return;
        }
        inspectionsData.forEach(item => {
            const statusColor = item.status === 'Активна' ? '#22c55e' : item.status === 'Запланирована' ? '#eab308' : item.status === 'Завершена' ? '#3b82f6' : '#94a3b8';
            const tr = document.createElement('tr');
            tr.innerHTML = `<td><strong>${item.name}</strong></td>
                            <td>${item.start}</td>
                            <td>${item.end || '—'}</td>
                            <td>${item.executor}</td>
                            <td>${item.frequency}</td>
                            <td><span class="status-badge" style="background: ${statusColor}20; color: ${statusColor};">${item.status}</span></td>
                            <td class="actions">
                                <button class="btn-icon edit" onclick="editInspection(${item.id})"><i class="fas fa-edit"></i></button>
                                <button class="btn-icon delete" onclick="deleteInspection(${item.id})"><i class="fas fa-trash"></i></button>
                            </td>`;
            tbody.appendChild(tr);
        });
    }

    function addInspection() {
        document.getElementById('inspectionModalTitle').textContent = 'Добавление проверки';
        document.getElementById('inspectionId').value = '';
        document.getElementById('inspectionName').value = '';
        document.getElementById('inspectionStart').value = new Date().toISOString().split('T')[0];
        document.getElementById('inspectionEnd').value = '';
        document.getElementById('inspectionExecutor').value = '';
        document.getElementById('inspectionFrequency').value = '';
        document.getElementById('inspectionStatus').value = '';
        document.getElementById('inspectionModal').classList.add('show');
    }

    function editInspection(id) {
        const item = inspectionsData.find(i => i.id === id);
        if (!item) return;
        document.getElementById('inspectionModalTitle').textContent = 'Редактирование проверки';
        document.getElementById('inspectionId').value = item.id;
        document.getElementById('inspectionName').value = item.name;
        document.getElementById('inspectionStart').value = item.start.split('.').reverse().join('-');
        document.getElementById('inspectionEnd').value = item.end ? item.end.split('.').reverse().join('-') : '';
        document.getElementById('inspectionExecutor').value = item.executor;
        document.getElementById('inspectionFrequency').value = item.frequency;
        document.getElementById('inspectionStatus').value = item.status;
        document.getElementById('inspectionModal').classList.add('show');
    }

    function closeInspectionModal() {
        document.getElementById('inspectionModal').classList.remove('show');
    }

    function saveInspection(e) {
        e.preventDefault();
        const name = document.getElementById('inspectionName').value.trim();
        const start = document.getElementById('inspectionStart').value;
        const end = document.getElementById('inspectionEnd').value;
        const executor = document.getElementById('inspectionExecutor').value.trim();
        const frequency = document.getElementById('inspectionFrequency').value;
        const status = document.getElementById('inspectionStatus').value;
        
        if (!name || !start || !executor || !frequency || !status) {
            alert('Пожалуйста, заполните все обязательные поля');
            return;
        }

        const startFormatted = new Date(start).toLocaleDateString('ru-RU');
        const endFormatted = end ? new Date(end).toLocaleDateString('ru-RU') : '';

        const id = document.getElementById('inspectionId').value;
        if (id) {
            const index = inspectionsData.findIndex(i => i.id == id);
            if (index !== -1) {
                inspectionsData[index] = { id: parseInt(id), name, start: startFormatted, end: endFormatted, executor, frequency, status };
            }
        } else {
            inspectionsData.push({ id: Date.now(), name, start: startFormatted, end: endFormatted, executor, frequency, status });
        }
        
        localStorage.setItem('inspectionsData', JSON.stringify(inspectionsData));
        renderInspectionsTable();
        closeInspectionModal();
    }

    function deleteInspection(id) {
        if (confirm('Вы уверены, что хотите удалить эту проверку?')) {
            inspectionsData = inspectionsData.filter(i => i.id !== id);
            localStorage.setItem('inspectionsData', JSON.stringify(inspectionsData));
            renderInspectionsTable();
        }
    }

    function toggleDropdown(id) {
        const menu = document.getElementById(id);
        document.querySelectorAll('.dropdown-menu').forEach(m => { if (m.id !== id) m.classList.remove('show'); });
        menu.classList.toggle('show');
        event.stopPropagation();
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
            document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
        }
    });

    function filterTable(tableId, searchIdOrCol, value) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = tbody.querySelectorAll('tr');
        if (typeof searchIdOrCol === 'string') {
            const searchTerm = document.getElementById(searchIdOrCol)?.value?.toLowerCase() || '';
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(searchTerm) ? '' : 'none';
            });
            return;
        }
        const colIndex = typeof searchIdOrCol === 'number' ? searchIdOrCol : parseInt(searchIdOrCol);
        const searchVal = (value || '').toLowerCase();
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                row.style.display = cell.textContent.toLowerCase().includes(searchVal) ? '' : 'none';
            }
        });
    }

    function exportTable(tableId, format) {
        alert(`Экспорт в формате ${format.toUpperCase()} будет реализован`);
    }

    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('show');
        });
    });
</script>

<style>
    .regulator-card:hover {
        border-color: #4F46E5;
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }
    
    .regulator-card h3 {
        font-size: 16px;
        color: #1e293b;
    }
</style>