@{
    ViewData["Title"] = "Документы";
}

<div class="page-header">
    <h1>
        <a href="/audit/activity" style="color: #64748b; text-decoration: none; margin-right: 12px; font-size: 24px;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <i class="fas fa-file-alt"></i> Документы
    </h1>
    <p style="color: #64748b; margin-top: 8px; margin-left: 36px;">Автоматическое формирование необходимых документов по вопросам обеспечения безопасности информации</p>
</div>

<!-- Вкладки навигации -->
<div class="tabs-nav">
    <a href="/audit/activity/responsible" class="tab-nav-item">Ответственные лица</a>
    <a href="/audit/activity/commissions" class="tab-nav-item">Комиссии</a>
    <a href="/audit/activity/documents" class="tab-nav-item active">Документы</a>
    <a href="/audit/activity/warranty" class="tab-nav-item">Гарантия</a>
    <a href="/audit/activity/notifications" class="tab-nav-item">Уведомления</a>
    <a href="/audit/activity/situations" class="tab-nav-item">Ситуации</a>
    <a href="/audit/activity/monitoring" class="tab-nav-item">Мониторинг</a>
</div>

<div class="form-content">
    <div class="toolbar">
        <div class="toolbar-left">
            <button class="btn btn-primary" onclick="generateAllDocuments()">
                <i class="fas fa-sync"></i> Сформировать все документы
            </button>
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" onclick="toggleDropdown('exportDropdown')">
                    <i class="fas fa-file-export"></i> Экспорт в файл
                    <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 4px;"></i>
                </button>
                <div id="exportDropdown" class="dropdown-menu">
                    <a onclick="exportTable('documentsTable', 'xlsx')"><i class="fas fa-file-excel"></i> Экспорт в XLSX</a>
                    <a onclick="exportTable('documentsTable', 'pdf')"><i class="fas fa-file-pdf"></i> Экспорт в PDF</a>
                </div>
            </div>
        </div>
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="documentsSearch" placeholder="Поиск..." oninput="filterTable('documentsTable', 'documentsSearch')" />
        </div>
    </div>

    <!-- Диаграмма статусов документов -->
    <div class="stats-panel" style="display: flex; gap: 24px; margin-bottom: 24px; padding: 20px; background: #f8fafc; border-radius: 8px; align-items: center; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 120px; height: 120px; position: relative;">
                <canvas id="documentsChart" width="120" height="120"></canvas>
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                    <div style="font-size: 24px; font-weight: 700; color: #1e293b;" id="totalPercent">0%</div>
                    <div style="font-size: 10px; color: #94a3b8;">Готовность</div>
                </div>
            </div>
            <div class="legend">
                <div class="legend-item"><span class="legend-color" style="background: #22c55e;"></span> Сформировано и утверждено</div>
                <div class="legend-item"><span class="legend-color" style="background: #eab308;"></span> Сформировано, необходимо утвердить</div>
                <div class="legend-item"><span class="legend-color" style="background: #f59e0b;"></span> Изменен, необходимо утвердить</div>
                <div class="legend-item"><span class="legend-color" style="background: #ef4444;"></span> Ошибка при формировании</div>
                <div class="legend-item"><span class="legend-color" style="background: #94a3b8;"></span> Не сформировано</div>
            </div>
        </div>
        <div style="flex: 1; display: flex; gap: 16px; flex-wrap: wrap;">
            <div class="stat-item"><span class="stat-label">Всего документов:</span> <span class="stat-value" id="totalDocs">0</span></div>
            <div class="stat-item"><span class="stat-label" style="color: #22c55e;">● Утверждено:</span> <span class="stat-value" id="approvedDocs">0</span></div>
            <div class="stat-item"><span class="stat-label" style="color: #eab308;">● Ожидают утверждения:</span> <span class="stat-value" id="pendingDocs">0</span></div>
            <div class="stat-item"><span class="stat-label" style="color: #ef4444;">● Ошибки:</span> <span class="stat-value" id="errorDocs">0</span></div>
        </div>
    </div>

    <div class="table-container">
        <table id="documentsTable" class="data-table">
            <thead>
                <tr>
                    <th class="th-sortable">
                        <div class="th-header"><span>Наименование документа</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 0, this.value)" /></div>
                    </th>
                    <th class="th-sortable">
                        <div class="th-header"><span>Статус</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row">
                            <select class="filter-inline-select" onchange="filterTable('documentsTable', 1, this.value)">
                                <option value="">(Все)</option>
                                <option value="Утвержден">Утвержден</option>
                                <option value="Ожидает утверждения">Ожидает утверждения</option>
                                <option value="Изменен">Изменен</option>
                                <option value="Ошибка">Ошибка</option>
                                <option value="Не сформирован">Не сформирован</option>
                            </select>
                        </div>
                    </th>
                    <th class="th-sortable">
                        <div class="th-header"><span>Дата формирования</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="date" class="filter-inline-input" oninput="filterTable('documentsTable', 2, this.value)" /></div>
                    </th>
                    <th class="th-sortable">
                        <div class="th-header"><span>Версия</span><i class="fas fa-sort sortable-icon"></i></div>
                        <div class="th-filter-row"><input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 3, this.value)" /></div>
                    </th>
                    <th style="width: 200px;">Действия</th>
                </tr>
            </thead>
            <tbody id="documentsTableBody">
                <tr><td colspan="5" style="text-align: center; padding: 60px 40px; color: #94a3b8;">Документы не добавлены</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    let documentsData = [];
    let chart = null;

    document.addEventListener('DOMContentLoaded', function() {
        try {
            const saved = localStorage.getItem('documentsData');
            if (saved) {
                documentsData = JSON.parse(saved);
            } else {
                documentsData = [
                    { id: 1, name: 'Инструкция ответственного за техническую защиту ПДн', status: 'Утвержден', date: '14.09.2023', version: '1.0' },
                    { id: 2, name: 'Инструкция пользователя СКЗИ', status: 'Утвержден', date: '14.09.2023', version: '2.1' },
                    { id: 3, name: 'Политика обработки персональных данных', status: 'Ожидает утверждения', date: '20.10.2023', version: '3.0' },
                    { id: 4, name: 'Регламент реагирования на инциденты', status: 'Изменен', date: '05.11.2023', version: '1.2' },
                    { id: 5, name: 'Инструкция по обеспечению безопасности ПДн', status: 'Не сформирован', date: '—', version: '—' }
                ];
                localStorage.setItem('documentsData', JSON.stringify(documentsData));
            }
        } catch(e) {
            documentsData = [];
        }
        renderTable();
        updateChart();
    });

    function renderTable() {
        const tbody = document.getElementById('documentsTableBody');
        tbody.innerHTML = '';
        if (documentsData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 60px 40px; color: #94a3b8;">Документы не добавлены</td></tr>';
            return;
        }
        documentsData.forEach(item => {
            const statusColor = getStatusColor(item.status);
            const tr = document.createElement('tr');
            tr.innerHTML = `<td><strong>${item.name}</strong></td>
                            <td><span class="status-badge" style="background: ${statusColor}20; color: ${statusColor};">${item.status}</span></td>
                            <td>${item.date}</td>
                            <td>${item.version}</td>
                            <td class="actions">
                                <button class="btn-icon" style="background: #e0f2fe; color: #0284c7;" onclick="downloadDocument(${item.id})"><i class="fas fa-download"></i></button>
                                <button class="btn-icon edit" onclick="editDocument(${item.id})"><i class="fas fa-edit"></i></button>
                                <button class="btn-icon delete" onclick="deleteDocument(${item.id})"><i class="fas fa-trash"></i></button>
                            </td>`;
            tbody.appendChild(tr);
        });
    }

    function getStatusColor(status) {
        const colors = {
            'Утвержден': '#22c55e',
            'Ожидает утверждения': '#eab308',
            'Изменен': '#f59e0b',
            'Ошибка': '#ef4444',
            'Не сформирован': '#94a3b8'
        };
        return colors[status] || '#94a3b8';
    }

    function updateChart() {
        const canvas = document.getElementById('documentsChart');
        const ctx = canvas.getContext('2d');
        const total = documentsData.length || 1;
        
        const statuses = {
            'Утвержден': documentsData.filter(d => d.status === 'Утвержден').length,
            'Ожидает утверждения': documentsData.filter(d => d.status === 'Ожидает утверждения').length,
            'Изменен': documentsData.filter(d => d.status === 'Изменен').length,
            'Ошибка': documentsData.filter(d => d.status === 'Ошибка').length,
            'Не сформирован': documentsData.filter(d => d.status === 'Не сформирован').length
        };
        
        const colors = ['#22c55e', '#eab308', '#f59e0b', '#ef4444', '#94a3b8'];
        const labels = Object.keys(statuses);
        const values = Object.values(statuses);
        
        // Обновляем статистику
        document.getElementById('totalDocs').textContent = total;
        document.getElementById('approvedDocs').textContent = statuses['Утвержден'];
        document.getElementById('pendingDocs').textContent = statuses['Ожидает утверждения'] + statuses['Изменен'];
        document.getElementById('errorDocs').textContent = statuses['Ошибка'];
        
        const percent = Math.round((statuses['Утвержден'] / total) * 100);
        document.getElementById('totalPercent').textContent = percent + '%';
        
        // Очищаем canvas
        ctx.clearRect(0, 0, 120, 120);
        
        // Рисуем круговую диаграмму
        let startAngle = -Math.PI / 2;
        values.forEach((value, index) => {
            if (value === 0) return;
            const sliceAngle = (value / total) * 2 * Math.PI;
            ctx.beginPath();
            ctx.moveTo(60, 60);
            ctx.arc(60, 60, 50, startAngle, startAngle + sliceAngle);
            ctx.closePath();
            ctx.fillStyle = colors[index];
            ctx.fill();
            startAngle += sliceAngle;
        });
        
        // Рисуем белый круг внутри для эффекта кольца
        ctx.beginPath();
        ctx.arc(60, 60, 35, 0, 2 * Math.PI);
        ctx.fillStyle = '#f8fafc';
        ctx.fill();
    }

    function generateAllDocuments() {
        if (confirm('Сформировать все документы?')) {
            documentsData.forEach(d => {
                if (d.status === 'Не сформирован') {
                    d.status = 'Ожидает утверждения';
                    d.date = new Date().toLocaleDateString('ru-RU');
                    d.version = '1.0';
                }
            });
            localStorage.setItem('documentsData', JSON.stringify(documentsData));
            renderTable();
            updateChart();
            alert('Документы успешно сформированы!');
        }
    }

    function downloadDocument(id) {
        const doc = documentsData.find(d => d.id === id);
        if (doc && doc.status !== 'Не сформирован') {
            alert(`Скачивание документа: ${doc.name}`);
        } else {
            alert('Документ не сформирован');
        }
    }

    function editDocument(id) {
        const doc = documentsData.find(d => d.id === id);
        if (!doc) return;
        const newStatus = prompt('Измените статус документа:', doc.status);
        if (newStatus && ['Утвержден', 'Ожидает утверждения', 'Изменен', 'Ошибка', 'Не сформирован'].includes(newStatus)) {
            doc.status = newStatus;
            localStorage.setItem('documentsData', JSON.stringify(documentsData));
            renderTable();
            updateChart();
        }
    }

    function deleteDocument(id) {
        if (confirm('Вы уверены, что хотите удалить этот документ?')) {
            documentsData = documentsData.filter(d => d.id !== id);
            localStorage.setItem('documentsData', JSON.stringify(documentsData));
            renderTable();
            updateChart();
        }
    }

    function toggleDropdown(id) {
        const menu = document.getElementById(id);
        document.querySelectorAll('.dropdown-menu').forEach(m => { if (m.id !== id) m.classList.remove('show'); });
        menu.classList.toggle('show');
        event.stopPropagation();
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
            document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
        }
    });

    function filterTable(tableId, searchIdOrCol, value) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        if (!tbody) return;
        const rows = tbody.querySelectorAll('tr');
        if (typeof searchIdOrCol === 'string') {
            const searchTerm = document.getElementById(searchIdOrCol)?.value?.toLowerCase() || '';
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(searchTerm) ? '' : 'none';
            });
            return;
        }
        const colIndex = typeof searchIdOrCol === 'number' ? searchIdOrCol : parseInt(searchIdOrCol);
        const searchVal = (value || '').toLowerCase();
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                row.style.display = cell.textContent.toLowerCase().includes(searchVal) ? '' : 'none';
            }
        });
    }

    function exportTable(tableId, format) {
        alert(`Экспорт в формате ${format.toUpperCase()} будет реализован`);
    }
</script>

<style>
    .stats-panel {
        background: #f8fafc;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        gap: 24px;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }
    
    .legend {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    
    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #475569;
    }
    
    .legend-color {
        width: 16px;
        height: 16px;
        border-radius: 4px;
    }
    
    .stat-item {
        font-size: 14px;
        color: #475569;
    }
    
    .stat-label {
        font-weight: 500;
    }
    
    .stat-value {
        font-weight: 600;
        color: #1e293b;
    }
    
    .status-badge {
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 500;
        display: inline-block;
    }
</style>