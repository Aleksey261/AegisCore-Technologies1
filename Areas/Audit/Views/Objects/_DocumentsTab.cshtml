@model AegisCore.Models.ObjectsViewModel
@{
    var obj = Model.CurrentObject;
    var documents = obj?.Documents ?? new List<ObjectDocument>();
}

@if (obj == null || string.IsNullOrEmpty(obj.Id))
{
    <div class="alert alert-info"><i class="fas fa-info-circle"></i> Сначала сохраните основные сведения объекта.</div>
}
else
{
    <div class="section-header" style="margin-bottom: 20px;">
        <h3 style="color: #1e293b;">Основные документы на объект информатизации</h3>
    </div>

    <div class="toolbar">
        <div class="toolbar-left">
            <button class="btn btn-primary" onclick="openAddDocumentModal()">
                <i class="fas fa-plus"></i> Добавить
            </button>
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Поиск..." oninput="filterDocumentsTable(this.value)" />
            </div>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table" id="documentsTable">
            <thead>
                <tr>
                    <th class="th-sortable" onclick="sortTable('documentsTable', 0)">
                        <div class="th-header">
                            <span>Вид документа</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 0, this.value)" />
                        </div>
                    </th>
                    <th class="th-sortable" onclick="sortTable('documentsTable', 1)">
                        <div class="th-header">
                            <span>Статус</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 1, this.value)" />
                        </div>
                    </th>
                    <th class="th-sortable" onclick="sortTable('documentsTable', 2)">
                        <div class="th-header">
                            <span>Сформированный документ</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 2, this.value)" />
                        </div>
                    </th>
                    <th class="th-sortable" onclick="sortTable('documentsTable', 3)">
                        <div class="th-header">
                            <span>Утверждённый документ</span>
                            <i class="fas fa-sort sortable-icon"></i>
                        </div>
                        <div class="th-filter-row">
                            <input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('documentsTable', 3, this.value)" />
                        </div>
                    </th>
                    <th style="width: 150px;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (documents.Any())
                {
                    @foreach (var doc in documents.OrderByDescending(d => d.CreatedAt))
                    {
                        <tr data-id="@doc.Id">
                            <td>
                                <strong>@GetDocumentTypeName(doc.DocumentType)</strong>
                                @if (!string.IsNullOrEmpty(doc.Name) && doc.Name != GetDocumentTypeName(doc.DocumentType))
                                {
                                    <br /><small style="color: #64748b;">@doc.Name</small>
                                }
                            </td>
                            <td>
                                @if (doc.Status == "draft")
                                {
                                    <span class="badge warning">Не сформирован</span>
                                }
                                else if (doc.Status == "generated")
                                {
                                    <span class="badge info">Сформирован</span>
                                }
                                else if (doc.Status == "approved")
                                {
                                    <span class="badge success">Утверждён</span>
                                }
                                else
                                {
                                    <span class="badge warning">@(doc.Status ?? "—")</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(doc.GeneratedFileName))
                                {
                                    <a href="/audit/objects/@obj.Id/download-generated/@doc.Id" style="color: #4F46E5; text-decoration: none;">
                                        <i class="fas fa-file-pdf"></i> @doc.GeneratedFileName
                                    </a>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(doc.ApprovedFileName))
                                {
                                    <a href="/audit/objects/@obj.Id/download-approved/@doc.Id" style="color: #4F46E5; text-decoration: none;">
                                        <i class="fas fa-file-alt"></i> @doc.ApprovedFileName
                                    </a>
                                }
                                else
                                {
                                    <span style="color: #94a3b8;">—</span>
                                }
                            </td>
                            <td class="actions">
                                @if (doc.Status == "draft")
                                {
                                    <button class="btn-icon edit" title="Сформировать" onclick="generateDocument('@doc.Id')">
                                        <i class="fas fa-file-alt"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-icon edit" title="Переформировать" onclick="confirmRegenerateDocument('@doc.Id')">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                    <button class="btn-icon" title="Скачать" onclick="downloadGeneratedDocument('@doc.Id')">
                                        <i class="fas fa-download"></i>
                                    </button>
                                }
                                <button class="btn-icon delete" title="Удалить" onclick="deleteDocument('@doc.Id')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8;">
                            <i class="fas fa-file-alt" style="font-size: 48px; margin-bottom: 16px; display: block;"></i>
                            Документы не добавлены
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    string GetDocumentTypeName(string type) => type switch
    {
        "techpasport" => "Технический паспорт",
        "order" => "Приказ на ввод в эксплуатацию",
        "classification_act" => "Акт классификации",
        "security_level_act" => "Акт определения уровня защищённости",
        "tz" => "Техническое задание на СЗИ",
        "tp" => "Технический проект СЗИ",
        "tech_process" => "Описание технологического процесса",
        "access_system" => "Разрешительная система доступа",
        "threat_model" => "Модель угроз",
        _ => "Документ"
    };
}

<!-- ✅ МОДАЛКА ДОБАВЛЕНИЯ ДОКУМЕНТА (Рисунок 119) -->
<div class="modal" id="addDocumentModal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h3>Добавление документа</h3>
            <button class="modal-close" onclick="closeModal('addDocumentModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="addDocumentForm" onsubmit="saveNewDocument(event)">
                <div class="form-group">
                    <label>Вид документа <span class="required">*</span></label>
                    <select id="newDocumentType" class="form-control" required onchange="handleDocumentTypeChange()">
                        <option value="">Выбрать...</option>
                        <optgroup label="Основные документы (формируются)">
                            <option value="techpasport">Технический паспорт</option>
                            <option value="order">Приказ на ввод в эксплуатацию</option>
                            <option value="classification_act">Акт классификации</option>
                            <option value="security_level_act">Акт определения уровня защищённости</option>
                        </optgroup>
                        <optgroup label="Утверждённые документы (загружаются)">
                            <option value="tz">Техническое задание на СЗИ</option>
                            <option value="tp">Технический проект СЗИ</option>
                            <option value="tech_process">Описание технологического процесса</option>
                            <option value="access_system">Разрешительная система доступа</option>
                            <option value="threat_model">Модель угроз</option>
                        </optgroup>
                    </select>
                </div>

                <!-- Зона загрузки утверждённого документа (появляется для утверждаемых) -->
                <div class="form-group" id="documentFileGroup" style="display: none;">
                    <label>Прикрепить утверждённый документ</label>
                    <div class="upload-area" id="documentUploadArea"
                         ondragover="handleDocumentDragOver(event)"
                         ondragleave="handleDocumentDragLeave(event)"
                         ondrop="handleDocumentDrop(event)"
                         style="border: 2px dashed #cbd5e1; border-radius: 8px; padding: 40px; text-align: center; background: #f8fafc; cursor: pointer; transition: all 0.2s;">
                        <div class="upload-placeholder">
                            <i class="fas fa-cloud-upload-alt" style="font-size: 48px; color: #94a3b8; margin-bottom: 16px;"></i>
                            <p style="color: #64748b; margin-bottom: 16px;">
                                Прикрепить утверждённый документ или перетащите файл в эту область
                            </p>
                            <p style="color: #94a3b8; font-size: 12px; margin-bottom: 16px;">
                                Допустимые форматы: *.pdf, *.jpg, *.jpeg, *.doc, *.docx
                            </p>
                            <input type="file" id="newDocumentFile" accept=".pdf,.jpg,.jpeg,.doc,.docx"
                                   style="display: none;" onchange="handleDocumentFileSelect(event)" />
                            <button type="button" class="btn btn-primary" onclick="document.getElementById('newDocumentFile').click()">
                                <i class="fas fa-folder-open"></i> Выберите файл
                            </button>
                        </div>
                    </div>
                    <div id="newDocumentFileName" style="margin-top: 12px; padding: 12px; background: #f0fdf4; border: 1px solid #86efac; border-radius: 6px; display: none;">
                        <i class="fas fa-file" style="color: #16a34a;"></i>
                        <span id="newDocumentFileNameText" style="margin-left: 8px; color: #166534;"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('addDocumentModal')">Отмена</button>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ✅ МОДАЛКА ПОДТВЕРЖДЕНИЯ ПЕРЕФОРМИРОВАНИЯ (Рисунок 120) -->
<div class="modal" id="regenerateConfirmModal">
    <div class="modal-content" style="max-width: 500px;">
        <div class="modal-header">
            <h3>Подтверждение</h3>
            <button class="modal-close" onclick="closeModal('regenerateConfirmModal')">&times;</button>
        </div>
        <div class="modal-body" style="text-align: center; padding: 30px;">
            <i class="fas fa-exclamation-triangle" style="font-size: 48px; color: #f59e0b; margin-bottom: 16px;"></i>
            <p style="color: #1e293b; font-size: 16px; margin-bottom: 24px; line-height: 1.6;">
                При переформировании документа потребуется его заново утвердить.<br>
                Вы действительно хотите продолжить?
            </p>
            <div class="form-actions" style="justify-content: center; gap: 12px;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('regenerateConfirmModal')">Нет</button>
                <button type="button" class="btn btn-primary" onclick="regenerateDocument()">Да</button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ МОДАЛКА ЗАГРУЗКИ УТВЕРЖДЁННОГО ДОКУМЕНТА -->
<div class="modal" id="uploadApprovedModal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h3>Загрузка утверждённого документа</h3>
            <button class="modal-close" onclick="closeModal('uploadApprovedModal')">&times;</button>
        </div>
        <div class="modal-body">
            <form id="uploadApprovedForm" onsubmit="uploadApprovedFile(event)">
                <input type="hidden" id="uploadApprovedDocId" />
                <div class="form-group">
                    <label>Прикрепить утверждённый документ <span class="required">*</span></label>
                    <div class="upload-area" id="approvedUploadArea"
                         ondragover="handleApprovedDragOver(event)"
                         ondragleave="handleApprovedDragLeave(event)"
                         ondrop="handleApprovedDrop(event)"
                         style="border: 2px dashed #cbd5e1; border-radius: 8px; padding: 40px; text-align: center; background: #f8fafc; cursor: pointer; transition: all 0.2s;">
                        <div class="upload-placeholder">
                            <i class="fas fa-cloud-upload-alt" style="font-size: 48px; color: #94a3b8; margin-bottom: 16px;"></i>
                            <p style="color: #64748b; margin-bottom: 16px;">
                                Перетащите файл в эту область или выберите вручную
                            </p>
                            <p style="color: #94a3b8; font-size: 12px; margin-bottom: 16px;">
                                Допустимые форматы: *.pdf, *.jpg, *.jpeg, *.doc, *.docx
                            </p>
                            <input type="file" id="approvedFileInput" accept=".pdf,.jpg,.jpeg,.doc,.docx"
                                   style="display: none;" onchange="handleApprovedFileSelect(event)" />
                            <button type="button" class="btn btn-primary" onclick="document.getElementById('approvedFileInput').click()">
                                <i class="fas fa-folder-open"></i> Выберите файл
                            </button>
                        </div>
                    </div>
                    <div id="approvedFileName" style="margin-top: 12px; padding: 12px; background: #f0fdf4; border: 1px solid #86efac; border-radius: 6px; display: none;">
                        <i class="fas fa-file" style="color: #16a34a;"></i>
                        <span id="approvedFileNameText" style="margin-left: 8px; color: #166534;"></span>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeModal('uploadApprovedModal')">Отмена</button>
                    <button type="submit" class="btn btn-primary">Загрузить</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const objectId = '@(obj?.Id ?? "")';
    const documentsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(documents));
    let documentToRegenerate = null;
    let currentDocumentFile = null;
    let currentApprovedFile = null;

    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    // ✅ Открыть модалку добавления документа
    function openAddDocumentModal() {
        document.getElementById('addDocumentForm').reset();
        document.getElementById('newDocumentType').value = '';
        currentDocumentFile = null;
        document.getElementById('newDocumentFileName').style.display = 'none';
        document.getElementById('documentFileGroup').style.display = 'none';
        document.getElementById('addDocumentModal').classList.add('show');
    }

    // ✅ Определение типа документа (формируемый или утверждаемый)
    function handleDocumentTypeChange() {
        const type = document.getElementById('newDocumentType').value;
        const fileGroup = document.getElementById('documentFileGroup');
        const requiresFile = ['tz', 'tp', 'tech_process', 'access_system', 'threat_model'].includes(type);
        fileGroup.style.display = requiresFile ? 'block' : 'none';
    }

    // ✅ Сохранение нового документа
    function saveNewDocument(e) {
        e.preventDefault();
        const docType = document.getElementById('newDocumentType').value;
        if (!docType) { alert('Выберите вид документа'); return; }

        const isMainDocument = ['techpasport', 'order', 'classification_act', 'security_level_act'].includes(docType);

        // Создаём документ
        fetch('/audit/objects/' + objectId + '/generate-document', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(docType)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                if (!isMainDocument && currentDocumentFile) {
                    // Загружаем утверждённый файл
                    uploadDocumentFile(result.documentId, currentDocumentFile, () => {
                        closeModal('addDocumentModal');
                        location.reload();
                    });
                } else {
                    closeModal('addDocumentModal');
                    location.reload();
                }
            } else {
                alert(result.error || 'Ошибка при создании документа');
            }
        });
    }

    // ✅ Формирование документа (первичное)
    function generateDocument(docId) {
        if (!confirm('Сформировать документ?')) return;
        fetch('/audit/objects/' + objectId + '/generate-document/' + docId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) location.reload();
            else alert(result.error || 'Ошибка при формировании');
        });
    }

    // ✅ Подтверждение переформирования (Рисунок 120)
    function confirmRegenerateDocument(docId) {
        documentToRegenerate = docId;
        document.getElementById('regenerateConfirmModal').classList.add('show');
    }

    // ✅ Переформирование документа
    function regenerateDocument() {
        if (!documentToRegenerate) return;
        fetch('/audit/objects/' + objectId + '/regenerate-document/' + documentToRegenerate, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                closeModal('regenerateConfirmModal');
                // Открываем модалку загрузки утверждённого документа
                openUploadApprovedModal(documentToRegenerate);
            } else {
                alert(result.error || 'Ошибка при переформировании');
            }
        });
        documentToRegenerate = null;
    }

    // ✅ Открыть модалку загрузки утверждённого документа
    function openUploadApprovedModal(docId) {
        document.getElementById('uploadApprovedDocId').value = docId;
        document.getElementById('approvedFileName').style.display = 'none';
        currentApprovedFile = null;
        document.getElementById('uploadApprovedModal').classList.add('show');
    }

    // ✅ Загрузка утверждённого файла
    function uploadApprovedFile(e) {
        e.preventDefault();
        const docId = document.getElementById('uploadApprovedDocId').value;
        if (!currentApprovedFile) { alert('Выберите файл'); return; }

        uploadDocumentFile(docId, currentApprovedFile, () => {
            closeModal('uploadApprovedModal');
            location.reload();
        });
    }

    // ✅ Универсальная функция загрузки файла
    function uploadDocumentFile(docId, file, callback) {
        const formData = new FormData();
        formData.append('file', file);

        fetch('/audit/objects/' + objectId + '/upload-approved/' + docId, {
            method: 'POST',
            body: formData
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                if (callback) callback();
            } else {
                alert(result.error || 'Ошибка при загрузке файла');
            }
        });
    }

    // ✅ Скачивание сформированного документа
    function downloadGeneratedDocument(docId) {
        window.location.href = '/audit/objects/' + objectId + '/download-generated/' + docId;
    }

    // ✅ Удаление документа
    function deleteDocument(docId) {
        if (!confirm('Удалить документ?')) return;
        fetch('/audit/objects/' + objectId + '/delete-document/' + docId, {
            method: 'DELETE'
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) location.reload();
            else alert(result.error || 'Ошибка при удалении');
        });
    }

    // ✅ Поиск по таблице документов
    function filterDocumentsTable(value) {
        const table = document.getElementById('documentsTable');
        if (!table) return;
        const search = value.toLowerCase();
        table.querySelectorAll('tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(search) ? '' : 'none';
        });
    }
    
    // ✅ Поиск по столбцу
    function filterTable(tableId, colIndex, value) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const searchValue = value.toLowerCase();
        table.querySelectorAll('tbody tr').forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                const text = cell.textContent.toLowerCase();
                row.style.display = text.includes(searchValue) ? '' : 'none';
            }
        });
    }
    
    // ✅ Сортировка таблицы
    function sortTable(tableId, colIndex) {
        const table = document.getElementById(tableId);
        if (!table) return;
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        
        const currentDir = table.getAttribute('data-sort-dir') || 'asc';
        const newDir = currentDir === 'asc' ? 'desc' : 'asc';
        table.setAttribute('data-sort-dir', newDir);
        
        rows.sort((a, b) => {
            const aText = a.cells[colIndex]?.textContent.trim() || '';
            const bText = b.cells[colIndex]?.textContent.trim() || '';
            if (newDir === 'asc') return aText.localeCompare(bText, 'ru');
            else return bText.localeCompare(aText, 'ru');
        });
        
        rows.forEach(row => tbody.appendChild(row));
    }

    // ✅ Drag & Drop для модалки добавления
    function handleDocumentDragOver(e) {
        e.preventDefault();
        e.currentTarget.classList.add('drag-over');
    }
    function handleDocumentDragLeave(e) {
        e.currentTarget.classList.remove('drag-over');
    }
    function handleDocumentDrop(e) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-over');
        if (e.dataTransfer.files.length > 0) {
            document.getElementById('newDocumentFile').files = e.dataTransfer.files;
            handleDocumentFileSelect({ target: { files: e.dataTransfer.files } });
        }
    }
    function handleDocumentFileSelect(e) {
        const file = e.target.files[0];
        if (file) {
            currentDocumentFile = file;
            document.getElementById('newDocumentFileNameText').textContent = file.name;
            document.getElementById('newDocumentFileName').style.display = 'block';
        }
    }

    // ✅ Drag & Drop для модалки загрузки утверждённого
    function handleApprovedDragOver(e) {
        e.preventDefault();
        e.currentTarget.classList.add('drag-over');
    }
    function handleApprovedDragLeave(e) {
        e.currentTarget.classList.remove('drag-over');
    }
    function handleApprovedDrop(e) {
        e.preventDefault();
        e.currentTarget.classList.remove('drag-over');
        if (e.dataTransfer.files.length > 0) {
            document.getElementById('approvedFileInput').files = e.dataTransfer.files;
            handleApprovedFileSelect({ target: { files: e.dataTransfer.files } });
        }
    }
    function handleApprovedFileSelect(e) {
        const file = e.target.files[0];
        if (file) {
            currentApprovedFile = file;
            document.getElementById('approvedFileNameText').textContent = file.name;
            document.getElementById('approvedFileName').style.display = 'block';
        }
    }
</script>

<style>
    .upload-area.drag-over {
        border-color: #4F46E5 !important;
        background: #eef2ff !important;
    }
    .upload-area .upload-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }
    .th-sortable { cursor: pointer; user-select: none; }
