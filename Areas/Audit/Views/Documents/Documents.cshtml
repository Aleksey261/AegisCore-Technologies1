@{
    ViewData["Title"] = "Справочники";
}

<div class="audit-page">
    <div class="page-header">
        <h1>
            <a href="/audit" style="color: #64748b; text-decoration: none; margin-right: 12px; font-size: 24px;">
                <i class="fas fa-arrow-left"></i>
            </a>
            <i class="fas fa-book"></i> Справочники
        </h1>
        <p style="color: #64748b; margin-top: 8px; margin-left: 36px;">
            При желании все справочники можно заполнить сразу, чтобы потом ими можно было воспользоваться при заполнении информации в журналах
        </p>
