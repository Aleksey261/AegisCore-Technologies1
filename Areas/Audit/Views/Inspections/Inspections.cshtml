    .status-danger { background: #fee2e2; color: #dc2626; }

    /* Модальные окна */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 2000; align-items: center; justify-content: center; }
    .modal.show { display: flex !important; }
</style>

<script>
    // Переключение вкладок
    function switchSubTab(tabId, btn) {
        document.querySelectorAll('.sub-tab-content').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.tab-nav-item').forEach(el => el.classList.remove('active'));
        document.getElementById('tab-' + tabId).style.display = 'block';
        if (btn) btn.classList.add('active');
    }

    // Управление модальными окнами
    function openModal(modalId) {
        document.getElementById(modalId).classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeModal(modalId) {
        document.getElementById(modalId).classList.remove('show');
        document.body.style.overflow = 'auto';
    }

    // Закрытие по клику вне модального окна
    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', function(e) {
            if (e.target === this) closeModal(this.id);
        });
    });

    // Dropdown
    function toggleDropdown(dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        const isOpen = dropdown.classList.contains('show');
        document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.remove('show'));
        if (!isOpen) dropdown.classList.add('show');
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
            document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.remove('show'));
        }
    });

    // Toast уведомления
    function showToast(message) {
        const toast = document.getElementById('toast');
        document.getElementById('toastMessage').textContent = message;
        toast.style.display = 'flex';
        setTimeout(() => { toast.style.display = 'none'; }, 3000);
    }

    // Проверка уязвимостей
    function checkVulnerabilities() {
        showToast('Запущена проверка по банку данных уязвимостей ФСТЭК...');
    }

    // Обновление базы уязвимостей
    function updateVulnerabilityDatabase() {
        openModal('vulnUpdateStartModal');
        setTimeout(() => {
            openModal('vulnUpdateEndModal');
        }, 2000);
    }

    // Обновление базы угроз
    function updateThreatDatabase() {
        openModal('threatUpdateStartModal');
        setTimeout(() => {
            openModal('threatUpdateEndModal');
        }, 2000);
    }

    // Фильтрация таблицы внутренних проверок
    function filterInternalTable(column, value) {
        const table = document.getElementById('internalTable');
        const rows = table.querySelectorAll('tbody tr');
        const term = value.toLowerCase();
        
        rows.forEach(row => {
            if (column === 'global') {
                row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
            } else {
                let cellIndex = 0;
                switch(column) {
                    case 'name': cellIndex = 0; break;
                    case 'from': cellIndex = 1; break;
                    case 'to': cellIndex = 2; break;
                    case 'executor': cellIndex = 3; break;
                    case 'periodicity': cellIndex = 4; break;
                    case 'period': cellIndex = 5; break;
                }
                
                const cell = row.cells[cellIndex];
                if (cell) {
                    row.style.display = cell.textContent.toLowerCase().includes(term) ? '' : 'none';
                }
            }
        });
    }

    // Фильтрация таблицы уязвимостей
    function filterVulnsTable(column, value) {
        const table = document.getElementById('vulnsTable');
        const rows = table.querySelectorAll('tbody tr');
        const term = value.toLowerCase();
        
        rows.forEach(row => {
            if (column === 'global') {
                row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
            } else {
                let cellIndex = 0;
                switch(column) {
                    case 'id': cellIndex = 0; break;
                    case 'name': cellIndex = 1; break;
                }
                
                const cell = row.cells[cellIndex];
                if (cell) {
                    row.style.display = cell.textContent.toLowerCase().includes(term) ? '' : 'none';
                }
            }
        });
    }

    // Фильтрация таблицы угроз
    function filterThreatsTable(column, value) {
        const table = document.getElementById('threatsTable');
        const rows = table.querySelectorAll('tbody tr');
        const term = value.toLowerCase();
        
        rows.forEach(row => {
            if (column === 'global') {
                row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
            } else {
                let cellIndex = 0;
                switch(column) {
                    case 'id': cellIndex = 0; break;
                    case 'name': cellIndex = 1; break;
                }
                
                const cell = row.cells[cellIndex];
                if (cell) {
                    row.style.display = cell.textContent.toLowerCase().includes(term) ? '' : 'none';
                }
            }
        });
    }

    // Фильтрация таблицы плановых проверок
    function filterPlannedTable(column, value) {
        const table = document.getElementById('plannedTable');
        const rows = table.querySelectorAll('tbody tr');
        const term = value.toLowerCase();
        
        rows.forEach(row => {
            if (column === 'global') {
                row.style.display = row.textContent.toLowerCase().includes(term) ? '' : 'none';
            } else {
                let cellIndex = 0;
                switch(column) {
                    case 'date': cellIndex = 0; break;
                    case 'endDate': cellIndex = 1; break;
                    case 'status': cellIndex = 2; break;
                    case 'authority': cellIndex = 3; break;
                }
                
                const cell = row.cells[cellIndex];
                if (cell) {
                    row.style.display = cell.textContent.toLowerCase().includes(term) ? '' : 'none';
                }
            }
        });
    }

    // Сортировка таблицы
    function sortTable(tableId, colIndex) {
        const table = document.getElementById(tableId);
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const th = table.querySelectorAll('th')[colIndex];
        const icon = th.querySelector('.fa-sort');
        
        const isAsc = th.getAttribute('data-sort') === 'asc';
        const newDirection = isAsc ? 'desc' : 'asc';
        
        table.querySelectorAll('th').forEach(header => header.removeAttribute('data-sort'));
        th.setAttribute('data-sort', newDirection);
        
        th.querySelectorAll('.fa-sort').forEach(i => i.className = 'fas fa-sort sortable-icon');
        icon.className = newDirection === 'asc' ? 'fas fa-sort-up sortable-icon' : 'fas fa-sort-down sortable-icon';
        
        rows.sort((a, b) => {
            const aText = a.cells[colIndex].textContent.trim();
            const bText = b.cells[colIndex].textContent.trim();
            return newDirection === 'asc' ? aText.localeCompare(bText, 'ru') : bText.localeCompare(aText, 'ru');
        });
        
        rows.forEach(row => tbody.appendChild(row));
    }

    // Настройка таблицы
    function toggleColumn(className) {
        const cells = document.querySelectorAll('.' + className);
        cells.forEach(cell => {
            const th = cell.closest('th');
            if (th) {
                th.style.display = cell.style.display === 'none' ? '' : 'none';
            }
        });
    }

    function resetTableSettings() {
        const defaultCols = ['col-name', 'col-from', 'col-to', 'col-executor', 'col-periodicity', 'col-period'];
        defaultCols.forEach(cls => {
            const cells = document.querySelectorAll('.' + cls);
            cells.forEach(cell => {
                const th = cell.closest('th');
                if (th) th.style.display = '';
            });
        });
        document.querySelectorAll('#settingsDropdown input[type="checkbox"]').forEach(cb => cb.checked = true);
    }

    function changePageSize(size) {
        // Здесь будет логика изменения размера страницы
        console.log('Размер страницы изменен на:', size);
    }

    function confirmDelete() {
        if(confirm('Вы уверены, что хотите удалить эту запись?')) {
            alert('Запись удалена');
        }
    }
</script>