<script>
    let currentJournal = null;
    let journalData = [];

    // Конфигурация заголовков для обычных журналов (Рисунок 1)
    const standardJournalHeaders = [
        { name: 'Дата проведения', type: 'date', filterType: 'date' },
        { name: 'Тема инструктажа', type: 'text', filterType: 'text' },
        { name: 'ФИО инструктируемого', type: 'text', filterType: 'text' },
        { name: 'ФИО проводившего инструктаж', type: 'text', filterType: 'text' }
    ];

    // Конфигурация заголовков для журналов поэкземплярного учета (Рисунок 2)
    const instanceJournalHeaders = [
        { name: 'Номер лицензии', type: 'text', filterType: 'text' },
        { name: 'Ф.И.О. пользователя СКЗИ', type: 'text', filterType: 'text' },
        { name: 'ФИО, произведших подключение (установку)', type: 'text', filterType: 'text' },
        { name: 'Дата подключения (установки)', type: 'date', filterType: 'date' },
        { name: 'Дата удаления', type: 'date', filterType: 'date' },
        { name: 'Ф.И.О. произведших удаление', type: 'text', filterType: 'text' }
    ];

    function openJournal(name) {
        const titles = {
            'antivirus': 'Журнал антивирусных проверок',
            'internal-checks': 'Журнал проведенных внутренних проверок режима защиты ПДн',
            'incoming-dsp': 'Журнал учета входящих документов ДСП',
            'access-requests': 'Журнал учета заявок на назначение, отзыв, изменение прав доступа',
            'briefing': 'Журнал проведения инструктажа по ИБ',
            'outgoing-dsp': 'Журнал учета исходящих документов ДСП',
            'media': 'Журнал учета машинных носителей информации',
            'emergency': 'Журнал учета нештатных ситуаций',
            'appeals': 'Журнал учета обращений субъектов ПДн',
            'sealing': 'Журнал опечатывания ТС',
            'transfer': 'Журнал учета передачи ПДн',
            'szi-testing': 'Журнал периодического тестирования СЗИ',
            'documents': 'Журнал учета подготовленных документов',
            'skzi-oki': 'Журнал поэкземплярного учета СКЗИ (для ОКИ)',
            'skzi-other': 'Журнал поэкземплярного учета СКЗИ (для обладателя КИ)',
            'modification': 'Журнал учета работ по модификации ПО, ТС, СЗИ',
            'distribution': 'Журнал распределения документов ДСП',
            'seals': 'Журнал регистрации выдачи/приема пеналов, печатей, ключей',
            'backup': 'Журнал учета резервных копий ПО и БД ПДн',
            'technical': 'Технический (аппаратный) журнал',
            'szi-install': 'Журнал учета установки/изъятия СЗИ',
            'identifiers': 'Журнал учета электронных идентификаторов'
        };
        
        currentJournal = name;
        document.getElementById('journalModalTitle').innerHTML = `<i class="fas fa-book" style="color: #4F46E5;"></i> ${titles[name] || name}`;
        document.getElementById('journalModal').classList.add('show');
        loadJournalData();
    }

    function closeJournalModal() {
        document.getElementById('journalModal').classList.remove('show');
        currentJournal = null;
    }

    function loadJournalData() {
        const thead = document.getElementById('journalTableHead');
        const tbody = document.getElementById('journalTableBody');
        
        // Определяем, является ли журнал поэкземплярного учета
        const isInstanceJournal = currentJournal === 'skzi-oki' || currentJournal === 'skzi-other';
        const headers = isInstanceJournal ? instanceJournalHeaders : standardJournalHeaders;
        
        // Генерируем заголовки таблицы
        let headerHTML = '<tr style="background: #f8fafc;">';
        headers.forEach((header, index) => {
            headerHTML += `
                <th class="th-sortable col-${index}" style="min-width: 100px;">
                    <div class="th-header" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; cursor: pointer;">
                        <span>${header.name}</span>
                        <i class="fas fa-sort sortable-icon" style="color: #94a3b8; font-size: 12px; margin-left: 8px;"></i>
                    </div>
                    <div class="th-filter-row" style="padding: 4px 8px 8px 8px;">
                        ${header.filterType === 'date' 
                            ? `<input type="date" class="filter-inline-input" oninput="filterTable('journalTable', ${index}, this.value)" style="width: 100%; padding: 6px 10px; border: 1px solid #e2e8f0; border-radius: 4px; font-size: 13px; background: white; box-sizing: border-box;" />`
                            : `<input type="text" class="filter-inline-input" placeholder="Поиск..." oninput="filterTable('journalTable', ${index}, this.value)" style="width: 100%; padding: 6px 10px; border: 1px solid #e2e8f0; border-radius: 4px; font-size: 13px; background: white; box-sizing: border-box;" />`
                        }
                    </div>
                </th>
            `;
        });
        headerHTML += '<th style="width: 140px; text-align: center;">Действия</th></tr>';
        thead.innerHTML = headerHTML;
        
        // Показываем пустое состояние
        tbody.innerHTML = `
            <tr>
                <td colspan="${headers.length + 1}" style="text-align: center; padding: 60px 40px; color: #94a3b8;">
                    <i class="fas fa-book" style="font-size: 48px; margin-bottom: 16px; display: block; color: #cbd5e1;"></i>
                    <div style="font-size: 16px; font-weight: 500;">Записи в журнале отсутствуют</div>
                    <div style="font-size: 14px; margin-top: 8px;">Нажмите "Добавить" для создания первой записи</div>
                </td>
            </tr>
        `;
    }

    function openAddEntryModal() {
        document.getElementById('journalEntryForm').reset();
        document.getElementById('addEntryModal').classList.add('show');
        populateEmployeeSelect();
    }

    function closeAddEntryModal() {
        document.getElementById('addEntryModal').classList.remove('show');
    }

    function populateEmployeeSelect() {
        const select = document.getElementById('entryTester');
        select.innerHTML = '<option value="">Выбрать...</option><option value="1">Иванов И.И.</option><option value="2">Петров П.П.</option>';
    }

    function saveJournalEntry() {
        const form = document.getElementById('journalEntryForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        
        alert('Запись успешно добавлена в журнал!');
        closeAddEntryModal();
    }

    function editReference(type) {
        alert(`Редактирование справочника: ${type}`);
    }

    function addReference(type) {
        const value = prompt('Введите новое значение для справочника:');
        if (value) {
            alert(`Добавлено в справочник ${type}: ${value}`);
        }
    }

    function exportJournal(format) {
        closeAllDropdowns();
        if (format === 'pdf') {
            if (confirm('Требуется подписание документа электронной подписью. Продолжить?')) {
                alert('Экспорт в PDF с ЭЦП будет реализован');
            }
        } else {
            alert(`Экспорт в формате ${format.toUpperCase()} будет реализован`);
        }
    }

    function printJournal() {
        alert('Печать журнала будет реализована');
    }

    function toggleDropdown(dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        const isOpen = dropdown.classList.contains('show');
        closeAllDropdowns();
        if (!isOpen) dropdown.classList.add('show');
    }

    function closeAllDropdowns() {
        document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.remove('show'));
    }

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) closeAllDropdowns();
    });

    function toggleColumn(className) {
        const cells = document.querySelectorAll('.' + className);
        cells.forEach(cell => {
            cell.style.display = cell.style.display === 'none' ? '' : 'none';
        });
    }

    function resetTableSettings() {
        const defaultVisible = ['col-0', 'col-1', 'col-2', 'col-3'];
        defaultVisible.forEach(cls => {
            document.querySelectorAll('.' + cls).forEach(cell => {
                cell.style.display = '';
            });
        });
    }

    function filterJournalTable() {
        const searchTerm = document.getElementById('journalSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#journalTableBody tr');
        rows.forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(searchTerm) ? '' : 'none';
        });
    }

    function filterTable(tableId, colIndex, value) {
        const table = document.getElementById(tableId);
        const rows = table.querySelectorAll('tbody tr');
        rows.forEach(row => {
            const cell = row.cells[colIndex];
            if (cell) {
                row.style.display = cell.textContent.toLowerCase().includes(value.toLowerCase()) ? '' : 'none';
            }
        });
    }

    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.remove('show');
            }
        });
    });
</script>