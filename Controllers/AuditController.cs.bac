    // ============================================================
    // API: ДОСТУПЫ
    // ============================================================

    [HttpPost("/api/audit/organization/access/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SaveAccess([FromBody] AccessDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.EmployeeId))
                return Json(new { success = false, error = "Сотрудник не выбран" });

            var accesses = _audit.GetAccesses();

            if (string.IsNullOrWhiteSpace(dto.Id))
            {
                // Проверяем, есть ли уже доступ для этого сотрудника
                var existing = accesses.FirstOrDefault(a => a.EmployeeId == dto.EmployeeId);
                if (existing != null)
                {
                    // Обновляем существующий доступ
                    existing.PdnISPDn = dto.PdnISPDn;
                    existing.PdnPaper = dto.PdnPaper;
                    existing.ConfInfo = dto.ConfInfo;
                    existing.SkziRoom = dto.SkziRoom;
                    existing.SkziWork = dto.SkziWork;
                }
                else
                {
                    // Создаём новый доступ
                    var newAccess = new AccessRecord
                    {
                        Id = Guid.NewGuid().ToString(),
                        EmployeeId = dto.EmployeeId,
                        EmployeeFio = dto.EmployeeFio,
                        PdnISPDn = dto.PdnISPDn,
                        PdnPaper = dto.PdnPaper,
                        ConfInfo = dto.ConfInfo,
                        SkziRoom = dto.SkziRoom,
                        SkziWork = dto.SkziWork
                    };
                    accesses.Add(newAccess);
                }
                
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Назначен доступ для: {dto.EmployeeFio}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }
            else
            {
                var access = accesses.FirstOrDefault(a => a.Id == dto.Id);
                if (access == null)
                    return Json(new { success = false, error = "Доступ не найден" });

                access.EmployeeId = dto.EmployeeId;
                access.EmployeeFio = dto.EmployeeFio;
                access.PdnISPDn = dto.PdnISPDn;
                access.PdnPaper = dto.PdnPaper;
                access.ConfInfo = dto.ConfInfo;
                access.SkziRoom = dto.SkziRoom;
                access.SkziWork = dto.SkziWork;
                
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Изменён доступ для: {dto.EmployeeFio}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }

            _audit.SaveAccesses(accesses);
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpDelete("/api/audit/organization/access/delete/{id}")]
    [IgnoreAntiforgeryToken]
    public IActionResult DeleteAccess(string id)
    {
        try
        {
            var accesses = _audit.GetAccesses();
            var access = accesses.FirstOrDefault(a => a.Id == id);
            if (access == null)
                return Json(new { success = false, error = "Доступ не найден" });

            accesses.Remove(access);
            _audit.SaveAccesses(accesses);
            _audit.LogActivity(new AuditActivity
            {
                Event = $"Удалён доступ для: {access.EmployeeFio}",
                User = User.Identity?.Name ?? "unknown",
                Status = "OK"
            });
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    // ============================================================
    // API: СПРАВОЧНИКИ
    // ============================================================

    [HttpGet("/api/audit/organization/positions")]
    public IActionResult GetPositions()
    {
        var employees = _audit.GetEmployees();
        var positions = employees
            .Where(e => !string.IsNullOrWhiteSpace(e.Position))
            .Select(e => e.Position)
            .Distinct()
            .OrderBy(p => p)
            .Select(name => new { id = name, name = name })
            .ToList();
        return Json(positions);
    }

    [HttpPost("/api/audit/organization/positions/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SavePosition([FromBody] ReferenceDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.Name))
                return Json(new { success = false, error = "Наименование обязательно" });

            var employees = _audit.GetEmployees();

            if (!string.IsNullOrWhiteSpace(dto.Id) && dto.Id != dto.Name)
            {
                var exists = employees.Any(e => e.Position == dto.Id);
                if (!exists)
                {
                    _audit.LogActivity(new AuditActivity
                    {
                        Event = $"Добавлена должность: {dto.Name}",
                        User = User.Identity?.Name ?? "unknown",
                        Status = "OK"
                    });
                    return Json(new { success = true });
                }

                foreach (var emp in employees.Where(e => e.Position == dto.Id))
                {
                    emp.Position = dto.Name;
                }
                _audit.SaveEmployees(employees);
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Переименована должность: {dto.Id} → {dto.Name}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }
            else
            {
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Добавлена должность: {dto.Name}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }

            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpDelete("/api/audit/organization/positions/delete/{name}")]
    [IgnoreAntiforgeryToken]
    public IActionResult DeletePosition(string name)
    {
        try
        {
            var employees = _audit.GetEmployees();
            var used = employees.Any(e => e.Position == name);
            if (used)
            {
                return Json(new
                {
                    success = false,
                    error = "Невозможно удалить. Данная должность используется сотрудниками."
                });
            }
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    // ============================================================
    // ИНФРАСТРУКТУРА (папка Views/Audit/Infrastructure/)
    // ============================================================

    [HttpGet("/audit/infrastructure")]
    public IActionResult Infrastructure(string? section, string? search, int page = 1, string? sort = null, string? order = null, int? pageSize = null)
    {
        ViewBag.ActiveModule = "audit";
        ViewBag.ActiveSection = "infrastructure";

        var model = new InfrastructureViewModel
        {
            ActiveTab = section ?? "info-systems",
            Search = search ?? "",
            Sort = sort,
            SortOrder = order,
            CurrentPage = page,
            PageSize = pageSize ?? 10
        };

        switch (model.ActiveTab)
        {
            case "info-systems":
                var infoSystems = FilterInfoSystems(_audit.GetInfoSystems(), search);
                model.TotalItems = infoSystems.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    infoSystems = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? infoSystems.OrderByDescending(i => i.Name).ToList() : infoSystems.OrderBy(i => i.Name).ToList(),
                        "type" => order == "desc" ? infoSystems.OrderByDescending(i => i.Type).ToList() : infoSystems.OrderBy(i => i.Type).ToList(),
                        _ => infoSystems
                    };
                }
                model.InfoSystems = infoSystems.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "storage":
                var storages = FilterStorages(_audit.GetStorages(), search);
                model.TotalItems = storages.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    storages = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? storages.OrderByDescending(s => s.Name).ToList() : storages.OrderBy(s => s.Name).ToList(),
                        "type" => order == "desc" ? storages.OrderByDescending(s => s.Type).ToList() : storages.OrderBy(s => s.Type).ToList(),
                        _ => storages
                    };
                }
                model.Storages = storages.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "technical-assets":
                var technicalAssets = FilterTechnicalAssets(_audit.GetTechnicalAssets(), search);
                model.TotalItems = technicalAssets.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    technicalAssets = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? technicalAssets.OrderByDescending(t => t.Name).ToList() : technicalAssets.OrderBy(t => t.Name).ToList(),
                        "type" => order == "desc" ? technicalAssets.OrderByDescending(t => t.Type).ToList() : technicalAssets.OrderBy(t => t.Type).ToList(),
                        _ => technicalAssets
                    };
                }
                model.TechnicalAssets = technicalAssets.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "szi":
                var szis = FilterSzi(_audit.GetSzi(), search);
                model.TotalItems = szis.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    szis = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? szis.OrderByDescending(s => s.Name).ToList() : szis.OrderBy(s => s.Name).ToList(),
                        "serialnumber" => order == "desc" ? szis.OrderByDescending(s => s.SerialNumber).ToList() : szis.OrderBy(s => s.SerialNumber).ToList(),
                        "receiptdate" => order == "desc" ? szis.OrderByDescending(s => s.ReceiptDate).ToList() : szis.OrderBy(s => s.ReceiptDate).ToList(),
                        "installbydate" => order == "desc" ? szis.OrderByDescending(s => s.InstallByDate).ToList() : szis.OrderBy(s => s.InstallByDate).ToList(),
                        "receivedfrom" => order == "desc" ? szis.OrderByDescending(s => s.ReceivedFrom).ToList() : szis.OrderBy(s => s.ReceivedFrom).ToList(),
                        _ => szis
                    };
                }
                model.Szis = szis.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "skzi":
                var skzis = FilterSkzi(_audit.GetSkzi(), search);
                model.TotalItems = skzis.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    skzis = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? skzis.OrderByDescending(s => s.Name).ToList() : skzis.OrderBy(s => s.Name).ToList(),
                        _ => skzis
                    };
                }
                model.Szkis = skzis.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "identifiers":
                var identifiers = FilterIdentifiers(_audit.GetIdentifiers(), search);
                model.TotalItems = identifiers.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    identifiers = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? identifiers.OrderByDescending(i => i.Name).ToList() : identifiers.OrderBy(i => i.Name).ToList(),
                        _ => identifiers
                    };
                }
                model.Identifiers = identifiers.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "signatures":
                var signatures = FilterSignatures(_audit.GetSignatures(), search);
                model.TotalItems = signatures.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    signatures = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? signatures.OrderByDescending(s => s.Name).ToList() : signatures.OrderBy(s => s.Name).ToList(),
                        _ => signatures
                    };
                }
                model.Signatures = signatures.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "media":
                var media = FilterMedia(_audit.GetMedia(), search);
                model.TotalItems = media.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    media = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? media.OrderByDescending(m => m.Name).ToList() : media.OrderBy(m => m.Name).ToList(),
                        _ => media
                    };
                }
                model.Media = media.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "software":
                var software = FilterSoftware(_audit.GetSoftware(), search);
                model.TotalItems = software.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    software = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? software.OrderByDescending(s => s.Name).ToList() : software.OrderBy(s => s.Name).ToList(),
                        _ => software
                    };
                }
                model.Software = software.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "asutp":
                var asutps = FilterAsutp(_audit.GetAsutp(), search);
                model.TotalItems = asutps.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    asutps = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? asutps.OrderByDescending(a => a.Name).ToList() : asutps.OrderBy(a => a.Name).ToList(),
                        _ => asutps
                    };
                }
                model.Asutps = asutps.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;

            case "its":
                var its = FilterIts(_audit.GetIts(), search);
                model.TotalItems = its.Count;
                if (!string.IsNullOrEmpty(sort))
                {
                    its = sort.ToLower() switch
                    {
                        "name" => order == "desc" ? its.OrderByDescending(i => i.Name).ToList() : its.OrderBy(i => i.Name).ToList(),
                        _ => its
                    };
                }
                model.Its = its.Skip((page - 1) * model.PageSize).Take(model.PageSize).ToList();
                break;
        }

        // ✅ Явно указываем путь к View в подпапке Infrastructure/
        return View("Infrastructure/Infrastructure", model);
    }

    // ============================================================
    // API: ИНФОРМАЦИОННЫЕ СИСТЕМЫ
    // ============================================================

    [HttpPost("/api/audit/infrastructure/info-systems/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SaveInfoSystem([FromBody] InfoSystemDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.Name))
                return Json(new { success = false, error = "Наименование обязательно" });

            var infoSystems = _audit.GetInfoSystems();

            if (string.IsNullOrWhiteSpace(dto.Id))
            {
                var newItem = new InfoSystem
                {
                    Id = Guid.NewGuid().ToString(),
                    Name = dto.Name,
                    Type = dto.Type,
                    SecurityClass = dto.SecurityClass,
                    SecurityLevel = dto.SecurityLevel
                };
                infoSystems.Add(newItem);
            }
            else
            {
                var item = infoSystems.FirstOrDefault(i => i.Id == dto.Id);
                if (item == null)
                    return Json(new { success = false, error = "Запись не найдена" });

                item.Name = dto.Name;
                item.Type = dto.Type;
                item.SecurityClass = dto.SecurityClass;
                item.SecurityLevel = dto.SecurityLevel;
            }

            _audit.SaveInfoSystems(infoSystems);
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpDelete("/api/audit/infrastructure/info-systems/delete/{id}")]
    [IgnoreAntiforgeryToken]
    public IActionResult DeleteInfoSystem(string id)
    {
        try
        {
            var infoSystems = _audit.GetInfoSystems();
            var item = infoSystems.FirstOrDefault(i => i.Id == id);

            if (item == null)
                return Json(new { success = false, error = "Запись не найдена" });

            infoSystems.Remove(item);
            _audit.SaveInfoSystems(infoSystems);
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    // ============================================================
    // API: СЗИ (СРЕДСТВА ЗАЩИТЫ ИНФОРМАЦИИ)
    // ============================================================

    [HttpGet("/api/audit/infrastructure/szi/{id}")]
    public IActionResult GetSzi(string id)
    {
        var szi = _audit.GetSzi().FirstOrDefault(s => s.Id == id);
        if (szi == null)
            return NotFound();

        return Json(szi);
    }

    [HttpPost("/api/audit/infrastructure/szi/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SaveSzi([FromBody] SziDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.Name))
                return Json(new { success = false, error = "Наименование обязательно" });
            if (string.IsNullOrWhiteSpace(dto.SerialNumber))
                return Json(new { success = false, error = "Заводской номер обязателен" });

            var szis = _audit.GetSzi();

            string? receivedFromName = null;
            if (!string.IsNullOrWhiteSpace(dto.ReceivedFromId))
            {
                var vendors = _store.GetSziVendors();
                var vendor = vendors.FirstOrDefault(v => v.Id == dto.ReceivedFromId);
                receivedFromName = vendor?.ShortName ?? vendor?.FullName;
            }

            if (string.IsNullOrWhiteSpace(dto.Id))
            {
                var newSzi = new Szi
                {
                    Id = Guid.NewGuid().ToString(),
                    Name = dto.Name,
                    SerialNumber = dto.SerialNumber,
                    ConformityMark = dto.ConformityMark,
                    LicenseNumber = dto.LicenseNumber,
                    MaxInstallations = dto.MaxInstallations,
                    ReceiptDate = dto.ReceiptDate,
                    InstallByDate = dto.InstallByDate,
                    ReceivedFromId = dto.ReceivedFromId,
                    ReceivedFrom = receivedFromName,
                    Configuration = dto.Configuration,
                    DestructionDate = dto.DestructionDate
                };
                szis.Add(newSzi);

                if (dto.InstallByDate.HasValue)
                {
                    var events = _audit.GetCalendarEvents();
                    events.Add(new CalendarEvent
                    {
                        Id = Guid.NewGuid().ToString(),
                        Title = $"Установка СЗИ: {dto.Name}",
                        StartDate = dto.InstallByDate.Value,
                        Type = "szi_installation",
                        Description = $"Необходимо установить СЗИ «{dto.Name}» (зав. № {dto.SerialNumber})",
                        Completed = false
                    });
                    _audit.SaveCalendarEvents(events);
                }

                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Добавлено СЗИ: {dto.Name} (зав. № {dto.SerialNumber})",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }
            else
            {
                var szi = szis.FirstOrDefault(s => s.Id == dto.Id);
                if (szi == null)
                    return Json(new { success = false, error = "СЗИ не найдено" });

                szi.Name = dto.Name;
                szi.SerialNumber = dto.SerialNumber;
                szi.ConformityMark = dto.ConformityMark;
                szi.LicenseNumber = dto.LicenseNumber;
                szi.MaxInstallations = dto.MaxInstallations;
                szi.ReceiptDate = dto.ReceiptDate;
                szi.InstallByDate = dto.InstallByDate;
                szi.ReceivedFromId = dto.ReceivedFromId;
                szi.ReceivedFrom = receivedFromName;
                szi.Configuration = dto.Configuration;
                szi.DestructionDate = dto.DestructionDate;

                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Изменено СЗИ: {dto.Name}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }

            _audit.SaveSzi(szis);
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpDelete("/api/audit/infrastructure/szi/delete/{id}")]
    [IgnoreAntiforgeryToken]
    public IActionResult DeleteSzi(string id)
    {
        try
        {
            var szis = _audit.GetSzi();
            var szi = szis.FirstOrDefault(s => s.Id == id);

            if (szi == null)
                return Json(new { success = false, error = "СЗИ не найдено" });

            szis.Remove(szi);
            _audit.SaveSzi(szis);

            _audit.LogActivity(new AuditActivity
            {
                Event = $"Удалено СЗИ: {szi.Name} (зав. № {szi.SerialNumber})",
                User = User.Identity?.Name ?? "unknown",
                Status = "OK"
            });

            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    // ============================================================
    // API: СПРАВОЧНИК ПОСТАВЩИКОВ СЗИ
    // ============================================================

    [HttpGet("/api/audit/organization/szi-vendors")]
    public IActionResult GetSziVendors()
    {
        var vendors = _store.GetSziVendors();
        return Json(vendors.Select(v => new
        {
            id = v.Id,
            shortName = v.ShortName,
            fullName = v.FullName,
            address = v.Address,
            inn = v.Inn,
            phone = v.Phone,
            email = v.Email
        }));
    }

    [HttpPost("/api/audit/organization/szi-vendors/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SaveSziVendor([FromBody] SziVendorDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.ShortName))
                return Json(new { success = false, error = "Краткое название обязательно" });

            var vendors = _store.GetSziVendors();

            if (string.IsNullOrWhiteSpace(dto.Id))
            {
                var newVendor = new SziVendor
                {
                    Id = Guid.NewGuid().ToString(),
                    ShortName = dto.ShortName,
                    FullName = dto.FullName,
                    Address = dto.Address,
                    Inn = dto.Inn,
                    Phone = dto.Phone,
                    Email = dto.Email
                };
                vendors.Add(newVendor);
                _store.SaveSziVendors(vendors);

                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Добавлен поставщик СЗИ: {dto.ShortName}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });

                return Json(new { success = true, id = newVendor.Id });
            }
            else
            {
                var vendor = vendors.FirstOrDefault(v => v.Id == dto.Id);
                if (vendor == null)
                    return Json(new { success = false, error = "Организация не найдена" });

                vendor.ShortName = dto.ShortName;
                vendor.FullName = dto.FullName;
                vendor.Address = dto.Address;
                vendor.Inn = dto.Inn;
                vendor.Phone = dto.Phone;
                vendor.Email = dto.Email;

                _store.SaveSziVendors(vendors);

                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Изменён поставщик СЗИ: {dto.ShortName}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });

                return Json(new { success = true });
            }
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpDelete("/api/audit/organization/szi-vendors/delete/{id}")]
    [IgnoreAntiforgeryToken]
    public IActionResult DeleteSziVendor(string id)
    {
        try
        {
            var vendors = _store.GetSziVendors();
            var vendor = vendors.FirstOrDefault(v => v.Id == id);

            if (vendor == null)
                return Json(new { success = false, error = "Организация не найдена" });

            var szis = _audit.GetSzi();
            var usedInSzi = szis.Any(s => s.ReceivedFromId == id);

            if (usedInSzi)
            {
                return Json(new
                {
                    success = false,
                    error = "Невозможно удалить. Данная организация указана как поставщик в существующих СЗИ."
                });
            }

            vendors.Remove(vendor);
            _store.SaveSziVendors(vendors);

            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    // ============================================================
    // КАЛЕНДАРЬ (папка Views/Audit/Calendar/)
    // ============================================================

    [HttpGet("/audit/calendar")]
    public IActionResult Calendar(DateTime? date, string? type, string? view)
    {
        ViewBag.ActiveModule = "audit";
        ViewBag.ActiveSection = "calendar";
        var viewDate = date ?? DateTime.Now;
        ViewBag.ViewDate = viewDate;
        ViewBag.SelectedType = type;
        ViewBag.ViewMode = view ?? "month";
        var events = _audit.GetCalendarEvents();
        ViewBag.EventTypes = GetEventTypes();
        ViewBag.AllEvents = events;
        // ✅ Явно указываем путь к View в подпапке Calendar/
        return View("Calendar/Calendar", events);
    }

    [HttpGet("/api/audit/calendar/events")]
    public IActionResult GetCalendarEventsApi(int? year, int? month)
    {
        var events = _audit.GetCalendarEvents();

        if (year.HasValue && month.HasValue)
        {
            events = events.Where(e =>
                e.StartDate.Year == year.Value &&
                e.StartDate.Month == month.Value
            ).ToList();
        }

        return Json(events.Select(e => new
        {
            id = e.Id,
            title = e.Title,
            startDate = e.StartDate.ToString("yyyy-MM-dd"),
            endDate = e.EndDate?.ToString("yyyy-MM-dd"),
            type = e.Type,
            description = e.Description,
            completed = e.Completed
        }));
    }

    [HttpPost("/audit/calendar/event/save")]
    public IActionResult SaveCalendarEvent(CalendarEventForm form)
    {
        var events = _audit.GetCalendarEvents();

        if (!string.IsNullOrWhiteSpace(form.Id))
        {
            var existingEvent = events.FirstOrDefault(e => e.Id == form.Id);
            if (existingEvent != null)
            {
                existingEvent.Title = form.Title;
                existingEvent.StartDate = DateTime.TryParse(form.StartDate, out var start) ? start : DateTime.Now;
                existingEvent.EndDate = DateTime.TryParse(form.EndDate, out var end) ? end : null;
                existingEvent.Type = form.Type;
                existingEvent.Description = form.Description;
                existingEvent.Completed = form.Completed;
            }
        }
        else
        {
            events.Add(new CalendarEvent
            {
                Id = Guid.NewGuid().ToString(),
                Title = form.Title,
                StartDate = DateTime.TryParse(form.StartDate, out var start) ? start : DateTime.Now,
                EndDate = DateTime.TryParse(form.EndDate, out var end) ? end : null,
                Type = form.Type,
                Description = form.Description,
                Completed = form.Completed
            });
        }

        _audit.SaveCalendarEvents(events);

        if (Request.Headers["X-Requested-With"] == "XMLHttpRequest")
        {
            return Json(new { success = true });
        }

        return RedirectToAction("Calendar");
    }

    [HttpGet("/audit/calendar/event/edit/{id}")]
    public IActionResult EditCalendarEvent(string id)
    {
        var events = _audit.GetCalendarEvents();
        var eventToEdit = events.FirstOrDefault(e => e.Id == id);

        if (eventToEdit == null)
            return NotFound();

        return Json(new
        {
            id = eventToEdit.Id,
            title = eventToEdit.Title,
            startDate = eventToEdit.StartDate.ToString("yyyy-MM-dd"),
            endDate = eventToEdit.EndDate?.ToString("yyyy-MM-dd"),
            type = eventToEdit.Type,
            description = eventToEdit.Description,
            completed = eventToEdit.Completed
        });
    }

    [HttpPost("/api/audit/calendar/event/toggle/{id}")]
    [IgnoreAntiforgeryToken]
    public IActionResult ToggleCalendarEvent(string id)
    {
        var events = _audit.GetCalendarEvents();
        var eventToToggle = events.FirstOrDefault(e => e.Id == id);

        if (eventToToggle == null)
            return Json(new { success = false, error = "Событие не найдено" });

        eventToToggle.Completed = !eventToToggle.Completed;
        _audit.SaveCalendarEvents(events);

        return Json(new { success = true, completed = eventToToggle.Completed });
    }

    [HttpGet("/audit/calendar/event/delete/{id}")]
    public IActionResult DeleteCalendarEvent(string id)
    {
        var events = _audit.GetCalendarEvents().Where(e => e.Id != id).ToList();
        _audit.SaveCalendarEvents(events);

        if (Request.Headers["X-Requested-With"] == "XMLHttpRequest")
        {
            return Json(new { success = true });
        }

        return RedirectToAction("Calendar");
    }

