    [HttpPost("/api/audit/organization/branches/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SaveBranch([FromBody] BranchDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.Name))
                return Json(new { success = false, error = "Наименование обязательно для заполнения" });
            if (string.IsNullOrWhiteSpace(dto.Address))
                return Json(new { success = false, error = "Адрес обязателен для заполнения" });

            var branches = _audit.GetBranches();

            if (string.IsNullOrWhiteSpace(dto.Id))
            {
                var newBranch = new Branch
                {
                    Id = Guid.NewGuid().ToString(),
                    Name = dto.Name,
                    Address = dto.Address,
                    Director = dto.Director
                };
                branches.Add(newBranch);
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Добавлен филиал: {dto.Name}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }
            else
            {
                var branch = branches.FirstOrDefault(b => b.Id == dto.Id);
                if (branch == null)
                    return Json(new { success = false, error = "Филиал не найден" });

                branch.Name = dto.Name;
                branch.Address = dto.Address;
                branch.Director = dto.Director;
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Изменён филиал: {dto.Name}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }

            _audit.SaveBranches(branches);
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

