    [HttpPost("/api/audit/organization/employees/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SaveEmployee([FromBody] EmployeeDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.Fio))
                return Json(new { success = false, error = "ФИО обязательно для заполнения" });
            if (string.IsNullOrWhiteSpace(dto.Position))
                return Json(new { success = false, error = "Должность обязательна для заполнения" });
            if (string.IsNullOrWhiteSpace(dto.Department))
                return Json(new { success = false, error = "Подразделение обязательно для заполнения" });

            var employees = _audit.GetEmployees();

            if (string.IsNullOrWhiteSpace(dto.Id))
            {
                var newEmp = new Employee
                {
                    Id = Guid.NewGuid().ToString(),
                    Fio = dto.Fio,
                    Position = dto.Position,
                    Department = dto.Department,
                    Phone = dto.Phone,
                    Email = dto.Email,
                    DateStart = dto.DateStart,
                    DateEnd = dto.DateEnd
                };
                employees.Add(newEmp);
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Добавлен сотрудник: {dto.Fio}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }
            else
            {
                var emp = employees.FirstOrDefault(e => e.Id == dto.Id);
                if (emp == null)
                    return Json(new { success = false, error = "Сотрудник не найден" });

                emp.Fio = dto.Fio;
                emp.Position = dto.Position;
                emp.Department = dto.Department;
                emp.Phone = dto.Phone;
                emp.Email = dto.Email;
                emp.DateStart = dto.DateStart;
                emp.DateEnd = dto.DateEnd;
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Изменён сотрудник: {dto.Fio}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }

            _audit.SaveEmployees(employees);
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpDelete("/api/audit/organization/employees/delete/{id}")]
    [IgnoreAntiforgeryToken]
    public IActionResult DeleteEmployee(string id)
    {
        try
        {
            var employees = _audit.GetEmployees();
            var emp = employees.FirstOrDefault(e => e.Id == id);
            if (emp == null)
                return Json(new { success = false, error = "Сотрудник не найден" });

            var accesses = _audit.GetAccesses();
            if (accesses.Any(a => a.EmployeeFio == emp.Fio || a.EmployeeId == id))
            {
                return Json(new
                {
                    success = false,
                    error = "Невозможно удалить. Данный сотрудник уже используется в системе."
                });
            }

            employees.Remove(emp);
            _audit.SaveEmployees(employees);
            _audit.LogActivity(new AuditActivity
            {
                Event = $"Удалён сотрудник: {emp.Fio}",
                User = User.Identity?.Name ?? "unknown",
                Status = "OK"
            });
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

