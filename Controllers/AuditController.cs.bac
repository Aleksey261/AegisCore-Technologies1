            new() { { "id", "5" }, { "name", "Распоряжение" } }
        },
        "pencils" => new List<Dictionary<string, string>>
        {
            new() { { "id", "1" }, { "name", "Пенал железный" }, { "number", "111" }, { "keyNumber", "2222999110" } },
            new() { { "id", "2" }, { "name", "пенал ленточный" }, { "number", "499" }, { "keyNumber", "018" } },
            new() { { "id", "3" }, { "name", "пенал на 2 ключа" }, { "number", "067857" }, { "keyNumber", "ключ" } }
        },
        "szi-certificates" => new List<Dictionary<string, string>>
        {
            new() { { "id", "1" }, { "name", "Контур-Эксперт" }, { "number", "4397" }, { "issueDate", "14.10.2022" }, { "validUntil", "14.10.2027" }, { "manufacturer", "ФАП «ГНИИИ ПТЭИ ФСТЭК России»" } },
            new() { { "id", "2" }, { "name", "С-ТЕЛЕМ РОЛЛЕР" }, { "number", "4695" }, { "issueDate", "12.10.2022" }, { "validUntil", "12.10.2027" }, { "manufacturer", "АО Центр «Аттестацияинформ»" } }
        },
        "legal-acts" => new List<Dictionary<string, string>>
        {
            new() { { "id", "1" }, { "name", "ФЗ №152-ФЗ «О персональных данных»" } },
            new() { { "id", "2" }, { "name", "ФЗ №149-ФЗ «Об информации...»" } },
            new() { { "id", "3" }, { "name", "ФЗ №187-ФЗ «О безопасности КИИ»" } }
        },
        _ => new List<Dictionary<string, string>>()
    };

    private List<Dictionary<string, string>> FilterDirectoryItems(List<Dictionary<string, string>> list, string? search)
    {
        if (string.IsNullOrEmpty(search)) return list;
        var s = search.ToLower();
        return list.Where(item => item.Values.Any(v => v.ToLower().Contains(s))).ToList();
    }
}

