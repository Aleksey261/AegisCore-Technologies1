    [HttpPost("/api/audit/organization/rooms/save")]
    [IgnoreAntiforgeryToken]
    public IActionResult SaveRoom([FromBody] RoomDto dto)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(dto.Number))
                return Json(new { success = false, error = "Номер помещения обязателен для заполнения" });
            if (string.IsNullOrWhiteSpace(dto.Department))
                return Json(new { success = false, error = "Подразделение обязательно для заполнения" });

            var rooms = _audit.GetRooms();

            if (string.IsNullOrWhiteSpace(dto.Id))
            {
                var newRoom = new Room
                {
                    Id = Guid.NewGuid().ToString(),
                    Number = dto.Number,
                    Description = dto.Description,
                    Department = dto.Department,
                    DateIn = dto.DateIn,
                    DateOut = dto.DateOut
                };
                rooms.Add(newRoom);
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Добавлено помещение: {dto.Number}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }
            else
            {
                var room = rooms.FirstOrDefault(r => r.Id == dto.Id);
                if (room == null)
                    return Json(new { success = false, error = "Помещение не найдено" });

                room.Number = dto.Number;
                room.Description = dto.Description;
                room.Department = dto.Department;
                room.DateIn = dto.DateIn;
                room.DateOut = dto.DateOut;
                _audit.LogActivity(new AuditActivity
                {
                    Event = $"Изменено помещение: {dto.Number}",
                    User = User.Identity?.Name ?? "unknown",
                    Status = "OK"
                });
            }

            _audit.SaveRooms(rooms);
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpDelete("/api/audit/organization/rooms/delete/{id}")]
    [IgnoreAntiforgeryToken]
    public IActionResult DeleteRoom(string id)
    {
        try
        {
            var rooms = _audit.GetRooms();
            var room = rooms.FirstOrDefault(r => r.Id == id);
            if (room == null)
                return Json(new { success = false, error = "Помещение не найдено" });

            var employees = _audit.GetEmployees();
            if (employees.Any(e => e.Department == room.Department))
            {
                return Json(new
                {
                    success = false,
                    error = "Невозможно удалить. Помещение используется сотрудниками.",
                    inUse = true
                });
            }

            rooms.Remove(room);
            _audit.SaveRooms(rooms);
            _audit.LogActivity(new AuditActivity
            {
                Event = $"Удалено помещение: {room.Number}",
                User = User.Identity?.Name ?? "unknown",
                Status = "OK"
            });
            return Json(new { success = true });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

    [HttpPost("/api/audit/organization/rooms/import")]
    [IgnoreAntiforgeryToken]
    public IActionResult ImportRooms(IFormFile file)
    {
        try
        {
            if (file == null || file.Length == 0)
                return Json(new { success = false, error = "Файл не выбран" });

            var validExtensions = new[] { ".xls", ".xlsx", ".ods" };
            var ext = Path.GetExtension(file.FileName).ToLower();
            if (!validExtensions.Contains(ext))
                return Json(new { success = false, error = "Неверный формат файла. Допустимы только xls, xlsx или ods." });
            if (file.Length > 20 * 1024 * 1024)
                return Json(new { success = false, error = "Размер файла превышает 20МВ." });

            int processedRows = 0;

            _audit.LogActivity(new AuditActivity
            {
                Event = $"Импортировано помещений: {processedRows}",
                User = User.Identity?.Name ?? "unknown",
                Status = "OK"
            });

            return Json(new { success = true, processedRows });
        }
        catch (Exception ex)
        {
            return Json(new { success = false, error = ex.Message });
        }
    }

