<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AegisCore</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    @* Подключаем CSS в зависимости от активного модуля *@
    @if (ViewBag.ActiveModule == "audit")
    {
        <link rel="stylesheet" href="~/css/audit/site.css" />
    }
    else if (ViewBag.ActiveModule == "scanner")
    {
        <link rel="stylesheet" href="~/css/scanner/site.css" />
    }
    else if (ViewBag.ActiveModule == "admin")
    {
        <link rel="stylesheet" href="~/css/admin/site.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/site.css" />
    }
</head>
<body>
    <!-- Верхняя панель -->
    <header class="topbar">
        <div class="topbar-brand">
            <a href="/dashboard"><i class="fas fa-shield-alt"></i> AegisCore</a>
        </div>
        <nav class="topbar-nav">
            <a href="/dashboard" class="@(ViewBag.ActiveModule == null ? "active" : "")">
                <i class="fas fa-home"></i> Главная
            </a>
            <a href="/scanner" class="@(ViewBag.ActiveModule == "scanner" ? "active" : "")">
                <i class="fas fa-search"></i> Сканер
            </a>
            <a href="/audit" class="@(ViewBag.ActiveModule == "audit" ? "active" : "")">
                <i class="fas fa-clipboard-list"></i> Аудит
            </a>
            <a href="/fstec" class="@(ViewBag.ActiveModule == "fstec" ? "active" : "")">
                <i class="fas fa-chart-bar"></i> Отчёты
            </a>
        </nav>
        <div class="topbar-user">
            <div class="topbar-controls">
                @* Переключатель языка *@
                <div class="lang-switcher">
                    <button class="lang-btn active" data-lang="ru">RU</button>
                    <button class="lang-btn" data-lang="en">EN</button>
                </div>
                
                @* Переключатель темы *@
                <button class="theme-toggle" id="themeToggle" title="Переключить тему">
                    <i class="fas fa-moon"></i>
                </button>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="user-name"><i class="fas fa-user-circle"></i> @User.Identity.Name</span>
                    <form method="post" action="/logout" class="logout-form">
                        <button type="submit" title="Выйти"><i class="fas fa-sign-out-alt"></i></button>
                    </form>
                }
            </div>
        </div>
    </header>

    <!-- Основной контент -->
    <div class="main-layout">
        @* Боковая панель для модуля Аудит *@
        @if (ViewBag.ActiveModule == "audit")
        {
            <aside class="sidebar">
                <div class="sidebar-title"><i class="fas fa-clipboard-list"></i> Аудит</div>
                <nav class="sidebar-nav">
                    <a href="/audit/organization" class="@(ViewBag.ActiveSection == "organization" ? "active" : "")">
                        <i class="fas fa-building"></i> Организация
                    </a>
                    <a href="/audit/infrastructure" class="@(ViewBag.ActiveSection == "infrastructure" ? "active" : "")">
                        <i class="fas fa-server"></i> Инфраструктура
                    </a>
                    <a href="/audit/objects" class="@(ViewBag.ActiveSection == "objects" ? "active" : "")">
                        <i class="fas fa-desktop"></i> Объекты информатизации
                    </a>
                    <a href="/audit/protection" class="@(ViewBag.ActiveSection == "protection" ? "active" : "")">
                        <i class="fas fa-shield-alt"></i> Защита
                    </a>
                    <a href="/audit/journals" class="@(ViewBag.ActiveSection == "journals" ? "active" : "")">
                        <i class="fas fa-book"></i> Журналы
                    </a>
                    <a href="/audit/activity" class="@(ViewBag.ActiveSection == "activity" ? "active" : "")">
                        <i class="fas fa-tasks"></i> Деятельность
                    </a>
                    <a href="/audit/inspections" class="@(ViewBag.ActiveSection == "inspections" ? "active" : "")">
                        <i class="fas fa-clipboard-check"></i> Проверки
                    </a>
                    <a href="/audit/calendar" class="@(ViewBag.ActiveSection == "calendar" ? "active" : "")">
                        <i class="fas fa-calendar"></i> Календарь
                    </a>
                    <a href="/audit/documents" class="@(ViewBag.ActiveSection == "documents" ? "active" : "")">
                        <i class="fas fa-folder"></i> Документы
                    </a>
                </nav>
                <a href="/dashboard" class="sidebar-back">
                    <i class="fas fa-arrow-left"></i> На дашборд
                </a>
            </aside>
        }
        
        @* Боковая панель для модуля Сканер *@
        @if (ViewBag.ActiveModule == "scanner")
        {
            <aside class="sidebar">
                <div class="sidebar-title"><i class="fas fa-search"></i> Сканер</div>
                <nav class="sidebar-nav">
                    <a href="/scanner" class="@(ViewBag.ActiveSection == "main" ? "active" : "")">
                        <i class="fas fa-radar"></i> Сканирование
                    </a>
                    <a href="/scanner/vulnerabilities" class="@(ViewBag.ActiveSection == "vulnerabilities" ? "active" : "")">
                        <i class="fas fa-bug"></i> Уязвимости
                    </a>
                    <a href="/scanner/scans" class="@(ViewBag.ActiveSection == "scans" ? "active" : "")">
                        <i class="fas fa-history"></i> История
                    </a>
                </nav>
                <a href="/dashboard" class="sidebar-back">
                    <i class="fas fa-arrow-left"></i> На дашборд
                </a>
            </aside>
        }

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <!-- Подвал -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-left">
                <span>© 2026 AegisCore Technologies</span>
                <span class="footer-separator">•</span>
                <span class="footer-version">v1.0.0</span>
            </div>
            <div class="footer-center">
                <span class="footer-status">
                    <i class="fas fa-circle text-success"></i> Система работает
                </span>
            </div>
            <div class="footer-right">
                <span>Build 2026.06.16</span>
                <span class="footer-separator">•</span>
                <a href="#" class="footer-link"><i class="fas fa-question-circle"></i> Помощь</a>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
    <script src="~/js/theme.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>