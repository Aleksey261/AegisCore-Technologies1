@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Главная";
}

<!-- Header -->
<header id="main-header">
    <div class="header-container">
        <div class="logo">
            <i class="fas fa-shield-alt"></i>
            <span>AegisCore Technologies</span>
        </div>
        <a href="/login" class="btn-login">Войти</a>
    </div>
</header>

<!-- Hero Section -->
<section class="hero">
    <div class="hero-content fade-in-up">
        <i class="fas fa-shield-alt hero-icon"></i>
        <h1>AegisCore Technologies</h1>
        <p class="hero-subtitle">Платформа для аудита безопасности и сканирования уязвимостей</p>
        <div class="hero-buttons">
            <a href="/login" class="btn btn-white">Начать работу</a>
            <button class="btn btn-outline" onclick="document.getElementById('features').scrollIntoView({behavior: 'smooth'})">Узнать больше</button>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="features">
    <div class="container">
        <h2 class="features-title">Возможности платформы</h2>
        <p class="features-subtitle">Всё необходимое для безопасности вашей инфраструктуры</p>
        
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3>Аудит безопасности</h3>
                <p>Комплексная проверка информационной безопасности</p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3>Сканер уязвимостей</h3>
                <p>Автоматическое обнаружение уязвимостей</p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3>Аналитика и отчеты</h3>
                <p>Детальные отчеты и аналитика</p>
            </div>
            
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fas fa-users-cog"></i>
                </div>
                <h3>Управление доступом</h3>
                <p>Гибкая система ролей и прав</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta">
    <div class="container">
        <h2>Готовы начать?</h2>
        <p>Присоединяйтесь к компаниям, которые доверяют нам свою безопасность</p>
        <a href="/login" class="btn btn-white cta-btn">Начать использование</a>
    </div>
</section>

<!-- Footer -->
<footer>
    <p>&copy; 2026 AegisCore Technologies. Все права защищены.</p>
</footer>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const header = document.getElementById('main-header');
        
        function handleScroll() {
            if (window.scrollY > 50) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        }
        
        handleScroll();
        window.addEventListener('scroll', handleScroll);
    });
</script>
}